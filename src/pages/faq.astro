---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';
import LazyImage from '../components/LazyImage.astro';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.cctvtrailer.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "FAQ"
    }
  ]
});

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does it cost to rent a security trailer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Pricing depends on rental length, site, and configuration, so we quote each rental individually. Every rental includes 4 cameras (1 fixed fisheye + 3 PTZ with 25x optical zoom and IR), equipment training, 24/7 technical support, solar power/generator, and remote viewing access on your mobile devices or computer. Call (253) 683-2288 or request a quote online."
      }
    },
    {
      "@type": "Question",
      "name": "Are there any hidden fees?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Your written quote spells out everything before you book. Every rental includes 4 cameras (1 fixed fisheye + 3 PTZ with 25x optical zoom and IR), equipment training, 24/7 technical support, solar power/generator, and remote viewing access on your mobile devices or computer. Professional delivery and setup are available and are covered in your quote based on your site location and timing."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer discounts for long-term rentals?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Rental length is one of the main factors in your quote, and long-term and multi-unit rentals are quoted accordingly. We also offer corporate accounts and contract pricing for regular customers."
      }
    },
    {
      "@type": "Question",
      "name": "How quickly can you deliver a security trailer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We offer flexible delivery options: standard next-business-day delivery, same-day delivery, and same-day emergency deployment for urgent situations. Professional delivery and setup are available throughout the Puget Sound region. Call (253) 683-2288 to check availability."
      }
    },
    {
      "@type": "Question",
      "name": "How long does setup take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Setup takes 20-35 minutes in total: positioning the trailer (5-10 minutes), system activation (5-10 minutes), and basic orientation (10-15 minutes). Our trailers arrive pre-configured and ready to operate, with no complex installation or wiring."
      }
    },
    {
      "@type": "Question",
      "name": "What areas do you serve?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We serve the entire Puget Sound region including Pierce County (Tacoma, Puyallup, Lakewood, Federal Way), King County (Seattle, Kent, Auburn, Renton, Bellevue), Thurston County (Olympia, Lacey, Tumwater), and Kitsap County (Bremerton, Port Orchard, Silverdale). Professional delivery and setup are available throughout the region."
      }
    },
    {
      "@type": "Question",
      "name": "What technology is included in the trailers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our trailers feature 4 cameras (1 fixed fisheye for 360° panoramic coverage + 3 PTZ cameras with 25x optical zoom and IR night vision), motion detection and alerts, 24/7 recording with storage, weather-resistant equipment, solar power/generator, and remote viewing on your mobile devices or computer. All equipment is commercial-grade and designed for Pacific Northwest weather conditions."
      }
    },
    {
      "@type": "Question",
      "name": "Do the trailers require power hookups?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No hookup is required. Power options include solar-powered units (no hookup needed), battery backup for continuous operation, included generator for extended autonomous operation, standard 110V outlet connection option, and generator-compatibility for remote locations. Most clients use our solar-powered units with generator backup."
      }
    },
    {
      "@type": "Question",
      "name": "Can I monitor the cameras remotely?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Every rental is built for 24/7 self-monitoring with remote viewing on your mobile devices or computer: secure web portal access, Windows desktop app, mobile apps for iOS/Android, real-time alerts for motion detection, ability to download or stream recorded footage, and multiple user access. We provide training on the remote viewing system and 24/7 technical support."
      }
    },
    {
      "@type": "Question",
      "name": "What types of sites use security trailers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Security trailers are used by construction sites to prevent theft of materials and equipment, special events like festivals and concerts, retail/parking for after-hours lot security, industrial sites including warehouses and storage yards, government facilities, and emergency/disaster response situations."
      }
    },
    {
      "@type": "Question",
      "name": "How effective are trailers at preventing theft?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A visible trailer helps stop crimes before they happen, provides clear video evidence for prosecution, supports insurance claims with footage, and helps cut down on vandalism and trespassing. Results depend on the site, but a visible camera trailer makes it a harder target."
      }
    },
    {
      "@type": "Question",
      "name": "Can trailers be moved during the rental?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, and that's one of the main reasons to use a trailer. You can relocate as project phases change, move between multiple sites, tow at speeds up to 70 mph, or have us relocate for you (service fee applies). It's a good fit for sites where the risk moves as the work progresses."
      }
    },
    {
      "@type": "Question",
      "name": "How do trailers compare to security guards?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Trailers offer several advantages over guards: typically a fraction of the cost of round-the-clock guards (24/7 guard coverage commonly runs $15,000-20,000+ per month), true 24/7/365 coverage vs shift-based, continuous recording capability, and unaffected by weather conditions."
      }
    },
    {
      "@type": "Question",
      "name": "Why choose mobile trailers over fixed cameras?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The main differences: no expensive installation or wiring, immediate deployment vs weeks for installation, flexibility to move as needed, no permits required, complete system with power/recording/transmission included, and visible deterrent effect. For temporary needs, that means no permanent infrastructure changes."
      }
    },
    {
      "@type": "Question",
      "name": "What's the rental process?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Renting is simple and fast: 1) Call or request quote online, 2) Discuss your security needs, 3) Receive a custom quote, 4) Schedule delivery, 5) Sign simple rental agreement, 6) Trailer delivered and set up, 7) Brief training provided, 8) 24/7 support during rental. Standard delivery is next business day, and same-day delivery is available when you need it sooner."
      }
    },
    {
      "@type": "Question",
      "name": "What's the minimum rental period?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We offer flexible rental terms with a minimum rental of 1 day. Short-term rentals run from a few days to several weeks, and long-term rentals of several months are available. Extensions are easy to arrange and there are no penalties for early termination. Rental length is one of the factors in your quote, and we accommodate any timeline."
      }
    },
    {
      "@type": "Question",
      "name": "Do you require a deposit or contract?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our terms are straightforward: simple one-page rental agreement, first day's rental paid upfront, no security deposit required, NET 30 terms for established businesses, credit cards and checks accepted, and insurance certificate available. We make it easy to get the security you need without complicated contracts."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if my security trailer is damaged?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "All trailers are fully insured and maintenance is our responsibility. Normal wear and tear is covered at no cost. For vandalism or accidental damage: we handle all repairs, provide replacement unit if needed, no downtime for your security, and you're only responsible for gross negligence."
      }
    },
    {
      "@type": "Question",
      "name": "Can security trailers work in bad weather?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Our trailers are built for Pacific Northwest weather: weatherproof IP67-rated cameras, heated enclosures prevent freezing, wind-rated to 70mph, operates in -20°F to 120°F, automatic lens cleaning, infrared works in rain/fog. We've operated through snowstorms, windstorms, and flooding without interruption."
      }
    },
    {
      "@type": "Question",
      "name": "How do I access camera footage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Access your cameras 24/7 from your mobile devices or computer: secure web portal (no software needed), Windows desktop app, iPhone/Android mobile apps, live viewing and playback, download clips as needed, multi-user access with permissions, two weeks of motion-only storage by default (extendable in special cases). Training takes just 10 minutes and support is always available."
      }
    },
    {
      "@type": "Question",
      "name": "What's the difference between your trailers and competitors?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CCTV Trailer advantages: locally owned since 2009 (not a franchise), S-VIDIA advanced compression technology, true 24/7 local support, same-day emergency deployment (call to check availability), and no long-term contracts required. We're your neighbors here in the Puget Sound."
      }
    },
    {
      "@type": "Question",
      "name": "Do you provide live monitoring services?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our trailers are built for 24/7 self-monitoring: you receive real-time AI motion and intrusion alerts and watch live video on your mobile devices or computer (browser, Windows desktop app, iOS/Android apps), and you or your security team call police with video evidence in hand. CCTV Trailer does not operate a staffed monitoring center; we provide equipment training and 24/7 technical support. Most clients self-monitor successfully with our user-friendly system."
      }
    },
    {
      "@type": "Question",
      "name": "Can I move the trailer during my rental?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. You can move it as construction phases change or relocate it between job sites, tow it yourself (up to 70mph), or have us relocate it for a small fee. There's no rewiring or reinstallation, and you get the same security at the new location. Many clients move trailers weekly."
      }
    },
    {
      "@type": "Question",
      "name": "What size area can one trailer cover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Coverage depends on layout but typically: 2-5 acres of effective camera coverage, up to 300ft clear view distance, 360° rotation with PTZ cameras, 4 cameras per trailer (1 fixed fisheye + 3 PTZ with 25x optical zoom and IR), overlapping coverage zones, motion detection to 150ft. Most construction sites need just one trailer."
      }
    },
    {
      "@type": "Question",
      "name": "How do trailers compare to hiring security guards?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A trailer typically costs a fraction of the $15,000+/month that 24/7 guards commonly cost. It covers the site around the clock with no breaks or sick days, records HD video instead of written reports, and stays visible as a deterrent 24/7 in all weather."
      }
    },
    {
      "@type": "Question",
      "name": "What if I need a trailer immediately?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Same-day emergency deployment is available, subject to availability: setup takes 20-30 minutes on arrival, and temporary power solutions are available. Call (253) 683-2288 to check availability - we've deployed at 2 AM on holidays."
      }
    }
  ]
});
---

<Layout 
  title="Frequently Asked Questions | CCTV Trailer Security Solutions"
  description="Security trailer rental FAQs: rental quotes, setup time, coverage area, power requirements, 24/7 self-monitoring. Get answers from Pacific Northwest's trusted provider since 2009."
  schema={[breadcrumbSchema, schema]}>
  
  <Header currentPath="/faq" showEmergencyBar={true} />

  <main>
    <!-- Hero Section -->
