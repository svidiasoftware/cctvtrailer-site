        <!-- Pricing Questions -->
        <div id="pricing" class="mb-12">
          <h2 class="text-3xl font-bold mb-6 text-gray-800 border-b-2 border-blue-600 pb-2">Pricing & Quotes</h2>

          <div class="space-y-4">
            <details class="bg-white border-2 border-gray-200 rounded-lg p-6 hover:shadow-xl hover:border-blue-500 transition-all">
              <summary class="font-semibold text-lg cursor-pointer hover:text-blue-600 transition-colors">How much does it cost to rent a security trailer?</summary>
              <div class="mt-4 text-gray-600">
                <p>Pricing depends on rental length, site, and configuration, so we quote each rental individually. Every rental includes:</p>
                <ul class="list-disc pl-6 mt-2 space-y-1">
                  <li>4 cameras (1 fixed fisheye + 3 PTZ with 25x optical zoom and IR)</li>
                  <li>Equipment training</li>
                  <li>24/7 technical support</li>
                  <li>Solar power/generator included</li>
                  <li>Remote viewing access on your mobile devices or computer</li>
                </ul>
