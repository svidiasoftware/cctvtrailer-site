---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RelatedPages from '../components/RelatedPages.astro';
import Analytics from '../components/Analytics.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import StatBox from '../components/StatBox.astro';
import LazyImage from '../components/LazyImage.astro';

// Schema data for the construction security service
const serviceSchemaData = {
  serviceName: "Federal Way Surveillance Trailer Rental",
  description: "CCTV Trailer serving Federal Way - Locally owned surveillance security company since 2009. Professional CCTV systems and mobile trailer rentals for construction, retail, and events.",
  areaServed: [
    { type: "City" as const, name: "Federal Way" },
  ]
};

// Breadcrumb data
const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Locations", url: "/about" },
  { name: "Federal Way Security" }
];

// At-a-glance service facts
const crimeStats = [
  { value: "Since 2009", label: "Locally Owned", highlight: true },
  { value: "Same-Day", label: "Delivery from Tacoma" },
  { value: "20-30 min", label: "Setup Time" },
  { value: "24/7", label: "Technical Support" }
];

const relatedPages = [
  {
    title: "Construction Site Security Solutions",
    href: "/construction-security",
    description: "Mobile surveillance for Federal Way commercial construction and development projects."
  },
  {
    title: "Event Security Trailer Rentals",
    href: "/event-security",
    description: "Security solutions for Federal Way community events and festivals."
  },
  {
    title: "Kent Security Rental Services",
    href: "/kent-security-rental",
    description: "Mobile surveillance for nearby Kent Valley - 10 miles south."
  },
  {
    title: "Seattle Surveillance Rental",
    href: "/seattle-surveillance-rental",
    description: "Security services for Seattle - 20 miles north of Federal Way."
  },
  {
    title: "Tacoma Security Trailer Services",
    href: "/tacoma-security-trailer",
    description: "Our headquarters in Tacoma - 15 miles southwest with same-day delivery available."
  },
  {
    title: "Rental Options & Quotes",
    href: "/pricing",
    description: "Rental options for Federal Way area sites - call (253) 683-2288 or request a quote."
  }
];
---

<Layout 
  title="Federal Way Surveillance Trailer Rental | Mobile Security South King County"
  description="Federal Way mobile surveillance rentals for retail centers and construction sites, with rapid deployment to Des Moines, Milton and Twin Lakes. (253) 683-2288">
  
  <!-- Structured Data Schemas -->
  <ServiceSchema {...serviceSchemaData} />
  <BreadcrumbSchema items={breadcrumbItems} /> 

  <Header showEmergencyBar={true} currentPath="/federal-way-surveillance" />
  <Analytics /> 


  <main>
    <!-- Hero Section -->
    <section class="relative text-white py-16 overflow-hidden">
      <div class="absolute inset-0">
        <LazyImage
          src="/images/cities/federal-way-hero.webp"
          alt="Mobile CCTV surveillance trailer parked at the edge of a Pacific Highway South retail strip parking lot in Federal Way at dusk"
          class="w-full h-full object-cover"
          width="1920"
          height="1080"
          loading="eager"
          fetchPriority="high"
        />
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-indigo-900/85 to-indigo-900/55"></div>
      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl">
          <h1 class="text-4xl md:text-5xl font-bold mb-4">Federal Way Surveillance Trailer Rental</h1>
          <p class="text-xl mb-6">Mobile security trailers for South King County. We cover Federal Way businesses and events, from The Commons to Celebration Park.</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="tel:2536832288" class="bg-white text-indigo-900 hover:bg-gray-100 font-bold py-3 px-8 rounded-lg inline-block text-center">
              📞 Call: (253) 683-2288
            </a>
            <a href="#federal-way-quote" class="bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 px-8 rounded-lg inline-block text-center">
              Get Federal Way Quote >
            </a>
          </div>
          <p class="mt-4">⚡ Same-day delivery to Federal Way from nearby Tacoma</p>
        </div>
      </div>
    </section>

    <!-- Crime Statistics Section -->
    <section class="bg-orange-50 py-12">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold mb-6 text-center">Federal Way Service at a Glance</h2>
          <StatBox stats={crimeStats} layout="grid" />
          <div class="mt-8 bg-white rounded-lg p-6 border-l-4 border-green-600">
            <p class="text-gray-700 font-semibold">
              Retail lots and new construction sites across Federal Way both benefit from visible camera coverage.
              A trailer can go up the same day and move as your site changes.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Service Areas -->
    <section class="py-16">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold mb-8">Federal Way & South King County Coverage</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-white border rounded-lg p-6">
            <h3 class="font-bold text-lg mb-3">Federal Way Districts</h3>
            <ul class="text-gray-600 space-y-1">
              <li>• Downtown Federal Way</li>
              <li>• Twin Lakes</li>
              <li>• Steel Lake</li>
              <li>• Redondo</li>
              <li>• Mirror Lake</li>
              <li>• Lakota</li>
            </ul>
          </div>
          <div class="bg-white border rounded-lg p-6">
            <h3 class="font-bold text-lg mb-3">Nearby Areas</h3>
            <ul class="text-gray-600 space-y-1">
              <li>• Des Moines</li>
              <li>• Milton</li>
              <li>• Auburn (West)</li>
              <li>• Kent (South)</li>
              <li>• Fife</li>
              <li>• Northeast Tacoma</li>
            </ul>
          </div>
          <div class="bg-white border rounded-lg p-6">
            <h3 class="font-bold text-lg mb-3">Key Locations</h3>
            <ul class="text-gray-600 space-y-1">
              <li>• The Commons Mall</li>
              <li>• Celebration Park</li>
              <li>• Wild Waves Theme Park</li>
              <li>• St. Francis Hospital</li>
              <li>• Federal Way Transit Center</li>
              <li>• Weyerhaeuser Campus</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Federal Way Applications -->
    <section class="bg-gray-50 py-16">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold mb-8">Security Solutions for Federal Way</h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div>
            <h3 class="font-bold text-xl mb-4">Retail & Commercial</h3>
            <ul class="space-y-2">
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Shopping center parking lot security</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Retail theft prevention at The Commons</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Business park after-hours monitoring</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Auto dealership lot protection</span>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold text-xl mb-4">Construction & Development</h3>
            <ul class="space-y-2">
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>New residential development security</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Commercial construction sites</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Infrastructure project monitoring</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>School construction security</span>
              </li>
            </ul>
          </div>
        </div>
        
        <div class="mt-12 bg-orange-50 rounded-lg p-8">
          <h3 class="font-bold text-xl mb-4">Federal Way Growth = Security Needs</h3>
          <p class="text-gray-700 mb-4">
            Federal Way's population keeps growing, and new development means more sites that need watching. Our trailers can stay with a project from the construction phase through grand opening, moving as your needs change.
          </p>
          <div class="grid md:grid-cols-3 gap-4 text-center">
            <div>
              <div class="text-2xl font-bold text-orange-600">Same-Day</div>
              <div class="text-sm">Delivery Available</div>
            </div>
            <div>
              <div class="text-2xl font-bold text-orange-600">20-30 min</div>
              <div class="text-sm">Setup Time</div>
            </div>
            <div>
              <div class="text-2xl font-bold text-orange-600">24/7</div>
              <div class="text-sm">Self-Monitoring</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Federal Way Chooses Us -->
    <section class="py-16">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold mb-8 text-center">Trusted by Federal Way Businesses</h2>
        <div class="max-w-4xl mx-auto">
          <div class="bg-white rounded-lg shadow-lg p-8">
            <div class="grid md:grid-cols-2 gap-8">
              <div>
                <h3 class="font-bold text-xl mb-4">Local Advantages</h3>
                <ul class="space-y-2">
                  <li>• Professional delivery and setup available</li>
                  <li>• Familiar with local regulations</li>
                  <li>• Quick response from Tacoma base</li>
                  <li>• Video evidence ready for police reports</li>
                </ul>
              </div>
              <div>
                <h3 class="font-bold text-xl mb-4">Proven Results</h3>
                <ul class="space-y-2">
                  <li>• Multiple Federal Way projects secured</li>
                  <li>• Retail loss prevention success</li>
                  <li>• Event security expertise</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Local Security Challenges -->
    <section class="py-16">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold mb-8">Federal Way's Security Concerns</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-white border-l-4 border-orange-500 p-6 shadow-sm">
            <h3 class="font-bold text-lg mb-3 text-orange-600">Retail Shopping Theft</h3>
            <p class="text-gray-600">The Commons at Federal Way and surrounding shopping centers face organized retail crime, so parking lots and perimeters need full camera coverage.</p>
          </div>
          <div class="bg-white border-l-4 border-indigo-500 p-6 shadow-sm">
            <h3 class="font-bold text-lg mb-3 text-indigo-600">Suburban Development</h3>
            <p class="text-gray-600">Rapid residential growth in Mirror Lake, Steel Lake, and Twin Lakes areas creates construction site security needs for new housing developments.</p>
          </div>
          <div class="bg-white border-l-4 border-red-500 p-6 shadow-sm">
            <h3 class="font-bold text-lg mb-3 text-red-600">Auto Dealership Vandalism</h3>
            <p class="text-gray-600">Pacific Highway S auto row sees significant vehicle theft and vandalism. Dealers there need 24/7 lot monitoring and perimeter alerts.</p>
          </div>
          <div class="bg-white border-l-4 border-green-500 p-6 shadow-sm">
            <h3 class="font-bold text-lg mb-3 text-green-600">Transit Center Crime</h3>
            <p class="text-gray-600">Federal Way Transit Center and surrounding park-and-ride lots see property crime spikes, especially during evening commute hours.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Recent Projects -->
    <section class="bg-indigo-50 py-16">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold mb-8">Recent Federal Way Security Successes</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-white rounded-lg shadow-lg p-6">
            <div class="text-orange-600 font-semibold mb-2">Retail Loss Prevention</div>
            <h3 class="font-bold text-lg mb-3">Commons Mall Parking Lot</h3>
            <p class="text-gray-600 mb-4">Deployed 5 mobile units during the holiday season surge. Vehicle break-ins and catalytic converter theft attempts dropped off while the units were up.</p>
            <div class="text-sm text-gray-500">
              <span class="font-semibold">Challenge:</span> High-volume shopping area, limited lighting
            </div>
            <div class="text-sm text-gray-500">
              <span class="font-semibold">Solution:</span> Infrared cameras with motion-activated floodlights
            </div>
          </div>
          <div class="bg-white rounded-lg shadow-lg p-6">
            <div class="text-green-600 font-semibold mb-2">Residential Development</div>
            <h3 class="font-bold text-lg mb-3">Steel Lake Village Phase II</h3>
            <p class="text-gray-600 mb-4">Covered a 150-home development throughout 8 months of construction and coordinated with King County Sheriff on site issues.</p>
            <div class="text-sm text-gray-500">
              <span class="font-semibold">Challenge:</span> Multiple active building sites, high-value materials
            </div>
            <div class="text-sm text-gray-500">
              <span class="font-semibold">Solution:</span> 6-unit mobile network with AI theft detection
            </div>
          </div>
          <div class="bg-white rounded-lg shadow-lg p-6">
            <div class="text-blue-600 font-semibold mb-2">Healthcare Facility</div>
            <h3 class="font-bold text-lg mb-3">St. Francis Hospital Expansion</h3>
            <p class="text-gray-600 mb-4">Secured sensitive medical facility construction with discreet surveillance, keeping the work zone covered without compromising patient privacy.</p>
            <div class="text-sm text-gray-500">
              <span class="font-semibold">Challenge:</span> HIPAA compliance, active hospital operations
            </div>
            <div class="text-sm text-gray-500">
              <span class="font-semibold">Solution:</span> Privacy-compliant placement with medical-grade encryption
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Federal Way Trusts Us -->
    <section class="py-16">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold mb-8 text-center">Why Federal Way Businesses Choose CCTV Trailer</h2>
        <div class="max-w-4xl mx-auto">
          <div class="bg-white rounded-lg shadow-lg p-8">
            <div class="grid md:grid-cols-2 gap-8 mb-8">
              <div>
                <h3 class="font-bold text-xl mb-4">South King County Expertise</h3>
                <ul class="space-y-3">
                  <li class="flex items-start">
                    <span class="text-indigo-600 mr-2 font-bold">•</span>
                    <span><strong>Since 2009</strong> serving South King County</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-indigo-600 mr-2 font-bold">•</span>
                    <span><strong>Same-day</strong> delivery available from our Tacoma base</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-indigo-600 mr-2 font-bold">•</span>
                    <span><strong>4 cameras</strong> per trailer, including 3 PTZ with 25x zoom and IR</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-indigo-600 mr-2 font-bold">•</span>
                    <span><strong>Real-time alerts</strong> - call King County Sheriff with video evidence in hand</span>
                  </li>
                </ul>
              </div>
              <div>
                <h3 class="font-bold text-xl mb-4">Regional Understanding</h3>
                <div class="space-y-4">
                  <div class="bg-orange-50 p-4 rounded-lg">
                    <div class="font-semibold text-orange-600">Retail Corridor Expertise</div>
                    <p class="text-gray-600 text-sm">Deep knowledge of Pacific Highway S shopping patterns and The Commons security requirements.</p>
                  </div>
                  <div class="bg-indigo-50 p-4 rounded-lg">
                    <div class="font-semibold text-indigo-600">Suburban Development Specialist</div>
                    <p class="text-gray-600 text-sm">Extensive experience with Federal Way's expanding residential neighborhoods and HOA compliance.</p>
                  </div>
                  <div class="bg-green-50 p-4 rounded-lg">
                    <div class="font-semibold text-green-600">Transit Hub Security</div>
                    <p class="text-gray-600 text-sm">We have secured Sound Transit facilities and park-and-ride infrastructure.</p>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Federal Way Service Basics -->
            <div class="border-t border-gray-200 pt-8">
              <h4 class="font-bold text-lg mb-4 text-center">Federal Way Service Basics</h4>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
                <div class="bg-gray-50 p-4 rounded-lg">
                  <div class="text-2xl font-bold text-orange-600">4 cameras</div>
                  <div class="text-sm text-gray-600">Per trailer</div>
                </div>
                <div class="bg-gray-50 p-4 rounded-lg">
                  <div class="text-2xl font-bold text-indigo-600">20-30 min</div>
                  <div class="text-sm text-gray-600">Setup time</div>
                </div>
                <div class="bg-gray-50 p-4 rounded-lg">
                  <div class="text-2xl font-bold text-green-600">Same-day</div>
                  <div class="text-sm text-gray-600">Delivery available</div>
                </div>
                <div class="bg-gray-50 p-4 rounded-lg">
                  <div class="text-2xl font-bold text-red-600">2 weeks</div>
                  <div class="text-sm text-gray-600">Default video retention</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Quote Form -->
    <section id="federal-way-quote" class="py-16 bg-gray-50">
      <div class="container mx-auto px-4 max-w-2xl">
        <h2 class="text-3xl font-bold text-center mb-8">Get Federal Way Security Quote</h2>
        <form id="federal-way-quote-form" class="bg-white rounded-lg p-8 shadow-lg">
          <div class="grid gap-6">
            <div>
              <label for="fw-name" class="block mb-2 font-semibold">Name *</label>
              <input type="text" id="fw-name" name="name" required class="w-full px-4 py-2 border rounded-lg">
            </div>
            <div>
              <label for="fw-phone" class="block mb-2 font-semibold">Phone *</label>
              <input type="tel" id="fw-phone" name="phone" required class="w-full px-4 py-2 border rounded-lg">
            </div>
            <div>
              <label for="fw-location" class="block mb-2 font-semibold">Federal Way Location *</label>
              <input type="text" id="fw-location" name="location" placeholder="e.g., Twin Lakes, Downtown, Steel Lake" required class="w-full px-4 py-2 border rounded-lg">
            </div>
            <div>
              <label for="fw-type" class="block mb-2 font-semibold">Project Type *</label>
              <select id="fw-type" name="type" required class="w-full px-4 py-2 border rounded-lg">
                <option value="">Select type...</option>
                <option value="retail">Retail/Shopping Center</option>
                <option value="construction">Construction Site</option>
                <option value="parking">Parking Lot</option>
                <option value="event">Special Event</option>
                <option value="commercial">Commercial Property</option>
              </select>
            </div>
          </div>
          <div class="mt-8 text-center">
            <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-12 rounded-lg text-lg">
              Get Federal Way Quote >
            </button>
            <p class="mt-4 text-sm text-gray-600">Quick deployment from nearby Tacoma location</p>
          </div>
        </form>
      </div>
    </section>
  </main>

  <RelatedPages
    title="Related Security Services & Nearby Areas"
    pages={relatedPages}
  />

  <Footer />
</Layout>
