---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import CTASection from '../../components/CTASection.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import ServiceSchema from '../../components/ServiceSchema.astro';
import BreadcrumbSchema from '../../components/BreadcrumbSchema.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import StatBox from '../../components/StatBox.astro';

const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Solutions", url: "/services" },
  { name: "Copper Wire Theft Prevention" }
];

const relatedPages = [
  {
    title: "Construction Site Security Solutions",
    href: "/construction-security",
    description: "Mobile surveillance for construction sites, including copper wire and material theft prevention."
  },
  {
    title: "Preventing Theft at Construction Sites",
    href: "/blog/preventing-theft-construction-sites",
    description: "Complete guide to construction site theft prevention including copper wire protection strategies."
  },
  {
    title: "Equipment Theft Prevention Solutions",
    href: "/solutions/equipment-theft-prevention",
    description: "Protect valuable construction equipment, tools, and materials from theft with mobile surveillance."
  },
  {
    title: "Vandalism Prevention Solutions",
    href: "/solutions/vandalism-prevention",
    description: "Complementary surveillance coverage for graffiti, property damage, and after-hours trespass at the same sites."
  },
  {
    title: "Security Cost Calculator",
    href: "/security-cost-calculator",
    description: "Calculate the cost of security measures versus potential copper wire and material theft losses."
  },
  {
    title: "Mobile Trailer Technology",
    href: "/trailer-technology",
    description: "Advanced surveillance technology designed for construction site protection and theft deterrence."
  },
  {
    title: "ROI Calculator for Security",
    href: "/roi-calculator",
    description: "Calculate return on investment for copper wire theft prevention and security measures."
  },
  {
    title: "Copper Theft Along the Seattle-Tacoma Corridor",
    href: "/blog/copper-theft-seattle-tacoma-construction-sites",
    description: "Local data on the copper theft surge across Pierce and King County construction sites - and what contractors are doing about it."
  }
];

const serviceSchemaData = {
  serviceName: "Copper Wire Theft Prevention System",
  description: "Stop copper theft with advanced surveillance. Copper prices at record highs are driving a theft epidemic. 24/7 self-monitoring with instant alerts helps you catch after-hours activity around wire, HVAC units, and material storage before it turns into a costly loss.",
  areaServed: [
    { type: "State" as const, name: "Washington" },
    { type: "City" as const, name: "Tacoma" },
    { type: "City" as const, name: "Seattle" },
    { type: "City" as const, name: "Olympia" }
  ]
};

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why is copper wire theft so common?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Copper theft has surged due to record-high copper prices (roughly $4.50+ per pound). A thief's scrap payout is small next to the damage left behind: cut wiring, torn-out walls, and rework. Construction sites are prime targets with exposed wiring and materials."
      }
    },
    {
      "@type": "Question",
      "name": "How much does copper theft cost construction projects?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Far more than the copper is worth. On top of replacing the wire, you pay for rewiring labor, repairs to walls and equipment damaged during the theft, schedule delays, and overtime to catch up. Use the calculator on this page to estimate the exposure on your own site."
      }
    },
    {
      "@type": "Question",
      "name": "How do surveillance systems prevent copper theft?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Surveillance trailers let you watch material storage areas 24/7 and send instant alerts to your phone or computer when there's after-hours activity. The footage clearly identifies thieves, and visible cameras discourage a lot of opportunistic theft."
      }
    },
    {
      "@type": "Question",
      "name": "What are Washington's scrap metal laws for copper?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Washington State RCW 19.290 requires scrap metal dealers to record seller identification for every copper transaction, hold purchased copper for a mandatory 5-business-day waiting period before processing, and report all transactions to a law enforcement database. Dealers who buy copper without following these requirements face penalties including license revocation. These laws make it harder for thieves to sell stolen copper, but surveillance remains essential because many thefts are fenced through out-of-state yards or unlicensed buyers."
      }
    },
    {
      "@type": "Question",
      "name": "Can surveillance footage help prosecute copper thieves in WA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Our surveillance systems create court-ready evidence packages that Washington prosecutors use to secure convictions. Footage includes timestamped HD video of the theft, license plate captures linked to scrap yard transaction records, and thermal imaging showing wire-cutting activity. When paired with RCW 19.290 scrap dealer records, prosecutors can trace stolen copper from jobsite to scrap yard."
      }
    }
  ]
});
---

<Layout
  title="Copper Theft Prevention for Construction · Seattle-Tacoma"
  description="Copper theft prevention for Seattle-Tacoma construction. 24/7 self-monitored surveillance for wire, HVAC units, and material storage. Same-day setup."
  schema={[faqSchema]}>

  <ServiceSchema {...serviceSchemaData} />
  <BreadcrumbSchema items={breadcrumbItems} />

  <Header showEmergencyBar={true} currentPath="/solutions/copper-wire-theft-prevention" />

  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-orange-800 to-orange-900 text-white py-16">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl">
          <div class="bg-red-600 text-white inline-block px-4 py-2 rounded-lg font-bold mb-4">
            🚨 COPPER PRICES AT RECORD HIGH - THEFT SURGE WARNING
          </div>
          <h1 class="text-4xl md:text-5xl font-bold mb-4">Stop Copper Wire Theft Before It Destroys Your Timeline</h1>
          <p class="text-xl mb-6">Thieves walk away with scrap money. <strong>You are left with the rewiring bill and a schedule delay</strong>, and it can all happen in a single night.</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="tel:2536832288" class="bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-8 rounded-lg inline-block text-center">
              🚨 Emergency: (253) 683-2288
            </a>
            <a href="#copper-calculator" class="bg-white text-orange-900 hover:bg-gray-100 font-bold py-3 px-8 rounded-lg inline-block text-center">
              Calculate Your Risk >
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Answer Section -->
    <section class="py-8 bg-gray-50">
      <div class="container mx-auto px-4">
        <QuickAnswer
          what="Specialized surveillance system targeting copper and metal theft prevention"
          problem="Record copper prices driving theft epidemic - $4.50+/lb making sites prime targets"
          solution="Strategic camera placement covering material storage, loading areas, and perimeter"
          effectiveness="Visible cameras discourage opportunistic thieves, and timestamped video with license plate captures supports police reports and prosecution"
          response="Same-day deployment for active threats (call to check availability), 24/7 self-monitoring"
          includes={[
            "4 cameras (1 fixed fisheye + 3 PTZ 25x zoom with IR)",
            "Equipment training",
            "24/7 technical support",
            "Solar power/generator included",
            "Remote viewing access on your mobile devices or computer"
          ]}
        />
      </div>
    </section>

    <!-- Copper Theft Crisis Section -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">The Copper Theft Crisis at a Glance</h2>

        <StatBox
          stats={[
            {
              value: "$4.50+",
              label: "Per Pound",
              icon: "💰",
              highlight: true
            },
            {
              value: "Rough-In",
              label: "Highest-Risk Phase",
              icon: "⚠️",
              highlight: false
            },
            {
              value: "RCW 19.290",
              label: "WA Scrap Metal Law",
              icon: "📜",
              highlight: false
            },
            {
              value: "24/7",
              label: "Self-Monitoring",
              icon: "⏱️",
              highlight: false
            }
          ]}
          className="max-w-5xl mx-auto mb-12"
        />

        <!-- Real Cost Breakdown -->
        <div class="bg-red-50 border-2 border-red-300 rounded-lg p-8 max-w-4xl mx-auto">
          <h3 class="text-2xl font-bold mb-6 text-red-900">True Cost of Copper Theft: How the Losses Stack Up</h3>

          <div class="grid md:grid-cols-2 gap-8">
            <div>
              <h4 class="font-bold text-lg mb-3 text-red-800">What Thieves Take:</h4>
              <ul class="space-y-2">
                <li class="flex justify-between">
                  <span>Copper wire</span>
                  <span class="font-semibold">Pulled from walls and spools</span>
                </li>
                <li class="flex justify-between">
                  <span>Scrap value to thieves</span>
                  <span class="font-semibold text-green-600">A fraction of replacement cost</span>
                </li>
              </ul>
            </div>

            <div>
              <h4 class="font-bold text-lg mb-3 text-red-800">What You Lose:</h4>
              <ul class="space-y-2">
                <li class="flex justify-between">
                  <span>Wire replacement</span>
                  <span class="font-semibold">New wire at full price</span>
                </li>
                <li class="flex justify-between">
                  <span>Rewiring labor</span>
                  <span class="font-semibold">Electricians, a second time</span>
                </li>
                <li class="flex justify-between">
                  <span>Delay costs</span>
                  <span class="font-semibold">Schedule slip and overtime</span>
                </li>
                <li class="flex justify-between">
                  <span>Damaged infrastructure</span>
                  <span class="font-semibold">Walls, conduit, equipment</span>
                </li>
                <li class="border-t-2 border-red-300 pt-2 flex justify-between">
                  <span class="font-bold">Total Loss</span>
                  <span class="font-bold text-red-600">Many times the scrap value</span>
                </li>
              </ul>
            </div>
          </div>

          <div class="mt-6 p-4 bg-red-100 rounded">
            <p class="text-center font-bold text-red-900">
              Thieves get scrap value. You pay for replacement, labor, repairs, and delay.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Copper Is Targeted Section - REWRITTEN -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Why Copper Is a Top Target on Construction Sites</h2>

        <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          <div class="bg-white rounded-lg shadow-lg p-6">
            <div class="text-3xl mb-4">💰</div>
            <h3 class="text-xl font-bold mb-3">Copper's Unique Appeal to Thieves</h3>
            <ul class="space-y-2 text-gray-700">
              <li>- Untraceable once stripped and melted</li>
              <li>- Universal demand at any scrap yard</li>
              <li>- Prices track global commodity markets</li>
              <li>- Higher per-pound value than other metals</li>
            </ul>
            <div class="mt-4 p-3 bg-orange-50 rounded">
              <p class="text-sm font-semibold text-orange-800">Copper runs roughly $4.50+/lb vs about $0.50/lb for aluminum, so every pound pays far more</p>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow-lg p-6">
            <div class="text-3xl mb-4">📈</div>
            <h3 class="text-xl font-bold mb-3">Price Trends Drive Theft Waves</h3>
            <ul class="space-y-2 text-gray-700">
              <li>- Copper prices have climbed sharply in recent years</li>
              <li>- EV and data center demand surging</li>
              <li>- Every price spike triggers theft sprees</li>
              <li>- Theft tends to rise and fall with commodity prices</li>
            </ul>
            <div class="mt-4 p-3 bg-orange-50 rounded">
              <p class="text-sm font-semibold text-orange-800">Higher copper prices mean more pressure on the wire and HVAC equipment at your site</p>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow-lg p-6">
            <div class="text-3xl mb-4">⚡</div>
            <h3 class="text-xl font-bold mb-3">Dangerous & Destructive</h3>
            <ul class="space-y-2 text-gray-700">
              <li>- Thieves cut live wires risking electrocution</li>
              <li>- Rip wiring from walls, destroying drywall</li>
              <li>- Strip AC units, ruining $5K+ compressors</li>
              <li>- Damage often far exceeds the value of the copper taken</li>
            </ul>
            <div class="mt-4 p-3 bg-orange-50 rounded">
              <p class="text-sm font-semibold text-orange-800">Cutting energized wire can electrocute the thief and leave hazards behind for your crew</p>
            </div>
          </div>
        </div>

        <!-- Pacific Northwest Copper Theft Hotspots -->
        <div class="mt-12 bg-white rounded-lg shadow-lg p-8 max-w-5xl mx-auto">
          <h3 class="text-2xl font-bold mb-6 text-center">Pacific Northwest Copper Theft Hotspots</h3>

          <div class="grid md:grid-cols-2 gap-8">
            <div>
              <h4 class="font-bold mb-3 text-orange-800">High-Risk Areas in Puget Sound</h4>
              <ul class="space-y-2 text-gray-700">
                <li>📍 Kent Valley industrial corridor - large industrial and warehouse builds with heavy copper loads</li>
                <li>📍 Tacoma Tideflats - proximity to scrap yards makes fencing fast</li>
                <li>📍 South Seattle / SODO - large-scale commercial builds with exposed copper</li>
                <li>📍 Puyallup / Sumner - new residential subdivisions with pre-wired homes</li>
                <li>📍 Federal Way / Auburn - rapid development with inadequate site security</li>
              </ul>
            </div>

            <div>
              <h4 class="font-bold mb-3 text-orange-800">WA Scrap Metal Laws (RCW 19.290)</h4>
              <p class="text-gray-700 mb-3">Washington has some of the strongest scrap metal regulations in the country, but thieves adapt:</p>
              <ul class="space-y-2 text-gray-700">
                <li>- Dealers must record seller ID for every copper purchase</li>
                <li>- Mandatory 5-business-day hold before processing copper</li>
                <li>- All transactions reported to law enforcement database</li>
                <li>- Despite these laws, thieves fence copper through unlicensed buyers or across state lines into Oregon and Idaho</li>
              </ul>
              <div class="mt-3 p-3 bg-blue-50 rounded">
                <p class="text-sm font-semibold text-blue-800">Our license plate footage helps police match vehicles to scrap yard transaction records under RCW 19.290</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Most Targeted Copper Components -->
        <div class="mt-8 bg-white rounded-lg shadow-lg p-8 max-w-5xl mx-auto">
          <h3 class="text-2xl font-bold mb-6 text-center">Most Targeted Copper Components by Construction Phase</h3>

          <div class="grid md:grid-cols-3 gap-6">
            <div>
              <h4 class="font-bold mb-3 text-orange-800">Rough-In Phase (Highest Risk)</h4>
              <ul class="space-y-2 text-gray-700">
                <li>📍 Romex/NM cable in open walls ($3-5/ft)</li>
                <li>📍 THHN wire spools on-site ($1,000+ each)</li>
                <li>📍 Service entrance cables ($500+)</li>
                <li>📍 Grounding conductors ($2-4/ft)</li>
              </ul>
            </div>

            <div>
              <h4 class="font-bold mb-3 text-orange-800">Mechanical Phase</h4>
              <ul class="space-y-2 text-gray-700">
                <li>📍 AC unit copper coils ($1,500-5,000)</li>
                <li>📍 Refrigerant line sets ($10-20/ft)</li>
                <li>📍 Copper supply piping ($8-15/ft)</li>
                <li>📍 Brass valve assemblies ($50-200 each)</li>
              </ul>
            </div>

            <div>
              <h4 class="font-bold mb-3 text-orange-800">Finish & Commissioning</h4>
              <ul class="space-y-2 text-gray-700">
                <li>📍 Electrical panel bus bars ($500-2,000)</li>
                <li>📍 Transformer windings ($2,000+)</li>
                <li>📍 Rooftop HVAC units ($3,000-10,000)</li>
                <li>📍 Fire alarm wiring ($5-8/ft)</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5-Layer Copper Theft Prevention System - REWRITTEN -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-4">Our 5-Layer Copper Theft Prevention System</h2>
        <p class="text-center text-gray-600 max-w-3xl mx-auto mb-12">Each layer is built around a specific copper theft tactic that general site surveillance tends to miss. Works in tandem with our <a href="/construction-security" class="text-orange-700 underline hover:text-orange-900">construction site security program</a>.</p>

        <div class="max-w-5xl mx-auto space-y-8">
          <!-- Layer 1 -->
          <div class="flex items-start gap-4 bg-green-50 p-6 rounded-lg">
            <div class="bg-green-600 text-white rounded-full w-12 h-12 flex items-center justify-center flex-shrink-0 font-bold text-xl">1</div>
            <div>
              <h3 class="text-xl font-bold mb-2">Copper Storage Zone Monitoring</h3>
              <p class="text-gray-700 mb-3">Cameras cover every spot where copper is stored, staged, or installed, in addition to the perimeter. We track copper from delivery truck to installed wall.</p>
              <ul class="list-disc list-inside text-gray-600 space-y-1">
                <li>Wire spool staging areas monitored with motion-triggered recording</li>
                <li>Delivery verification: cameras confirm material counts at drop-off vs. crew check-in</li>
                <li>Gang box and conex container zones covered around the clock</li>
                <li>Active rough-in floors watched during vulnerable open-wall phases</li>
                <li>For remote copper storage sites without power, our <a href="/solar-powered-surveillance" class="text-orange-700 underline hover:text-orange-900">solar-powered trailers</a> provide off-grid monitoring</li>
              </ul>
            </div>
          </div>

          <!-- Layer 2 -->
          <div class="flex items-start gap-4 bg-blue-50 p-6 rounded-lg">
            <div class="bg-blue-600 text-white rounded-full w-12 h-12 flex items-center justify-center flex-shrink-0 font-bold text-xl">2</div>
            <div>
              <h3 class="text-xl font-bold mb-2">Optional Thermal Detection for Live Wire Protection</h3>
              <p class="text-gray-700 mb-3">Optional thermal imaging cameras (an add-on to the standard IR-equipped PTZ cameras - ask when you call) detect the heat signature created when someone cuts or strips energized copper conductors. Standard cameras can miss wire-cutting in dark, enclosed spaces.</p>
              <ul class="list-disc list-inside text-gray-600 space-y-1">
                <li>Heat flare detection when copper is cut under load (arcing creates 1,000F+ signatures)</li>
                <li>Thermal contrast identifies human body heat in unlit mechanical rooms and attics</li>
                <li>Differentiates between copper stripping activity and normal construction work patterns</li>
                <li>Night vision with zero ambient light required - copper thieves work in complete darkness</li>
                <li>Covers rooftop HVAC units where thieves strip condenser coils out of sight</li>
              </ul>
            </div>
          </div>

          <!-- Layer 3 -->
          <div class="flex items-start gap-4 bg-yellow-50 p-6 rounded-lg">
            <div class="bg-yellow-600 text-white rounded-full w-12 h-12 flex items-center justify-center flex-shrink-0 font-bold text-xl">3</div>
            <div>
              <h3 class="text-xl font-bold mb-2">Scrap Vehicle Identification</h3>
              <p class="text-gray-700 mb-3">Copper thieves use specific vehicle profiles. Our license plate recognition (LPR) and vehicle analytics target the trucks, vans, and trailers that show up at 2 AM with bolt cutters, and leave the superintendent's early morning arrival alone.</p>
              <ul class="list-disc list-inside text-gray-600 space-y-1">
                <li>LPR captures plates of every vehicle within 150 feet of copper storage zones</li>
                <li>Flags pickup trucks and cargo vans arriving during non-work hours (10 PM - 5 AM)</li>
                <li>Cross-references plates against known offender databases shared by WA law enforcement</li>
                <li>Records vehicle dwell time, since a copper load-out leaves a vehicle parked by the staging area in a distinct pattern</li>
                <li>Alerts trigger immediately when unrecognized vehicles approach material staging areas</li>
              </ul>
            </div>
          </div>

          <!-- Layer 4 -->
          <div class="flex items-start gap-4 bg-orange-50 p-6 rounded-lg">
            <div class="bg-orange-600 text-white rounded-full w-12 h-12 flex items-center justify-center flex-shrink-0 font-bold text-xl">4</div>
            <div>
              <h3 class="text-xl font-bold mb-2">Real-Time Copper Theft Interruption</h3>
              <p class="text-gray-700 mb-3">When motion is detected in a copper zone after hours, the system sends an instant alert to your phone or computer and triggers on-unit deterrents. You view the live feed, confirm what is happening, and call police with video evidence in hand.</p>
              <ul class="list-disc list-inside text-gray-600 space-y-1">
                <li>Instant alerts to your phone or computer with live video feed access</li>
                <li>Motion-triggered audio warnings: "Attention - copper theft surveillance is active. You are being recorded."</li>
                <li>Automatic strobe light activation at copper storage areas to expose intruders</li>
                <li>You (or your security staff) call police with live video in hand and can report a verified crime in progress</li>
              </ul>
            </div>
          </div>

          <!-- Layer 5 -->
          <div class="flex items-start gap-4 bg-purple-50 p-6 rounded-lg">
            <div class="bg-purple-600 text-white rounded-full w-12 h-12 flex items-center justify-center flex-shrink-0 font-bold text-xl">5</div>
            <div>
              <h3 class="text-xl font-bold mb-2">Prosecution Support Package</h3>
              <p class="text-gray-700 mb-3">Convicting copper thieves takes evidence that connects the jobsite theft to the scrap yard sale, so we build complete evidence packages for Washington prosecutors.</p>
              <ul class="list-disc list-inside text-gray-600 space-y-1">
                <li>Timestamped HD video of the theft with clear suspect identification</li>
                <li>License plate records that prosecutors can match against RCW 19.290 scrap dealer transaction logs</li>
                <li>Thermal imaging footage showing wire-cutting activity as corroborating evidence</li>
                <li>Chain-of-custody documentation meeting WA court admissibility standards</li>
                <li>Expert testimony coordination with Pierce County and King County prosecutors</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="mt-8 text-center">
          <p class="text-gray-600 mb-4">Not sure whether a mobile trailer or fixed system is right for your copper protection needs?</p>
          <a href="/mobile-vs-fixed-surveillance" class="text-orange-700 underline hover:text-orange-900 font-semibold">Compare mobile vs. fixed surveillance options ></a>
        </div>
      </div>
    </section>

    <!-- Washington State Copper Theft Laws - NEW SECTION -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Washington State Copper Theft Laws & Penalties</h2>

        <div class="max-w-5xl mx-auto">
          <div class="grid md:grid-cols-2 gap-8 mb-8">
            <!-- Theft Classifications -->
            <div class="bg-white rounded-lg shadow-lg p-6">
              <h3 class="text-xl font-bold mb-4 text-red-800">RCW 9A.56 - Theft Classifications for Copper</h3>
              <div class="space-y-4">
                <div class="border-l-4 border-red-600 pl-4">
                  <h4 class="font-bold">First-Degree Theft (Class B Felony)</h4>
                  <p class="text-gray-700">Copper value exceeding $5,000. Up to 10 years in prison and $20,000 fine. Common in commercial builds where thieves strip entire floors of wiring.</p>
                </div>
                <div class="border-l-4 border-orange-500 pl-4">
                  <h4 class="font-bold">Second-Degree Theft (Class C Felony)</h4>
                  <p class="text-gray-700">Copper value $750 - $5,000. Up to 5 years in prison and $10,000 fine. Often the charge in jobsite copper theft, since a single spool of THHN wire can hit this threshold.</p>
                </div>
                <div class="border-l-4 border-yellow-500 pl-4">
                  <h4 class="font-bold">Third-Degree Theft (Gross Misdemeanor)</h4>
                  <p class="text-gray-700">Copper value under $750. Up to 364 days in jail. Rarely applies to construction copper theft because even small amounts exceed $750 in replacement value.</p>
                </div>
              </div>
            </div>

            <!-- Additional Penalties & Scrap Laws -->
            <div class="bg-white rounded-lg shadow-lg p-6">
              <h3 class="text-xl font-bold mb-4 text-blue-800">Additional Penalties & Scrap Metal Regulations</h3>
              <div class="space-y-4">
                <div class="border-l-4 border-blue-600 pl-4">
                  <h4 class="font-bold">Critical Infrastructure Enhancement</h4>
                  <p class="text-gray-700">Stealing copper from utility systems, traffic signals, or telecommunications adds enhanced penalties. If copper theft causes a power outage, additional charges under RCW 9A.48 (malicious mischief) apply.</p>
                </div>
                <div class="border-l-4 border-blue-500 pl-4">
