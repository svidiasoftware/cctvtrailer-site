  <script is:inline>
    function calculateCopperRisk() {
      const copperFeet = parseFloat(document.getElementById('copper-feet').value) || 5000;
      const wireValue = parseFloat(document.getElementById('wire-type').value) || 3;
      const hvacUnits = parseFloat(document.getElementById('hvac-units').value) || 4;

      // Calculate material risk
      const wireRisk = copperFeet * wireValue;
      const hvacRisk = hvacUnits * 3500; // Average AC unit copper value
      const totalMaterialRisk = wireRisk + hvacRisk;

      // Calculate total impact (includes delays, labor, etc.)
      const totalImpact = totalMaterialRisk * 3.5; // Industry multiplier for total impact

      // Display results
      document.getElementById('material-risk').textContent = `$${totalMaterialRisk.toLocaleString()}`;
      document.getElementById('total-impact').textContent = `$${Math.round(totalImpact).toLocaleString()}`;

      document.getElementById('copper-result').classList.remove('hidden');
    }
  </script>
