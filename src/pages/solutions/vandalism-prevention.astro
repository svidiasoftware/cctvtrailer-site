---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import ServiceSchema from '../../components/ServiceSchema.astro';
import BreadcrumbSchema from '../../components/BreadcrumbSchema.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import StatBox from '../../components/StatBox.astro';

const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Solutions", url: "/services" },
  { name: "Vandalism Prevention" }
];

const serviceSchemaData = {
  serviceName: "Construction Site Vandalism Prevention",
  description: "Stop vandalism and graffiti with 24/7 surveillance and self-monitoring. HD cameras and instant alerts help you stop damage early and avoid the costly repairs and project delays that follow.",
  areaServed: [
    { type: "State" as const, name: "Washington" },
    { type: "City" as const, name: "Tacoma" },
    { type: "City" as const, name: "Seattle" },
    { type: "City" as const, name: "Olympia" }
  ]
};

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does vandalism cost construction projects?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It varies widely with the type of damage. A single incident can mean repairs, cleanup, schedule delays, and higher insurance costs, and graffiti on large surfaces often means repainting whole walls."
      }
    },
    {
      "@type": "Question",
      "name": "What types of vandalism affect construction sites?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Common vandalism includes graffiti/tagging, equipment damage, window breaking, arson attempts, dumping, fence cutting, and destruction of completed work. Weekends, when sites sit empty, are a high-risk time."
      }
    },
    {
      "@type": "Question",
      "name": "How effective is surveillance at preventing vandalism?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Visible surveillance discourages a lot of opportunistic vandalism. Real-time alerts and motion-triggered audio warnings send many vandals running, and the recorded video gives police evidence for prosecution."
      }
    }
  ]
});
---

<Layout
  title="Vandalism Prevention for Construction Sites | Stop Graffiti & Damage"
  description="Prevent construction site vandalism with 24/7 surveillance. Cameras, audio warnings, and instant alerts help stop graffiti, arson, and property damage. Same-day delivery available."
  schema={[faqSchema]}>

  <ServiceSchema {...serviceSchemaData} />
  <BreadcrumbSchema items={breadcrumbItems} />

  <Header showEmergencyBar={true} currentPath="/solutions/vandalism-prevention" />

  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-indigo-800 to-indigo-900 text-white py-16">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl">
          <div class="bg-yellow-500 text-black inline-block px-4 py-2 rounded-lg font-bold mb-4">
            ⚠️ ONE NIGHT OF VANDALISM = WEEKS OF DELAYS
          </div>
          <h1 class="text-4xl md:text-5xl font-bold mb-4">Stop Vandalism Before It Destroys Your Progress</h1>
          <p class="text-xl mb-6">Graffiti, arson and sabotaged equipment can set a project back by weeks. Visible surveillance with audio warnings helps stop vandals before they get that far.</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="tel:2536832288" class="bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-8 rounded-lg inline-block text-center">
              🚨 24/7 Hotline: (253) 683-2288
            </a>
            <a href="#vandalism-assessment" class="bg-white text-indigo-900 hover:bg-gray-100 font-bold py-3 px-8 rounded-lg inline-block text-center">
              Get Free Risk Assessment >
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Answer Section -->
    <section class="py-8 bg-gray-50">
      <div class="container mx-auto px-4">
        <QuickAnswer
          what="Vandalism prevention using HD surveillance and 24/7 self-monitoring"
          problem="Graffiti, equipment sabotage, arson, and break-ins that lead to costly repairs and delays"
          solution="24/7 self-monitoring with motion detection, automated audio warnings, and instant alerts to your phone or computer"
          effectiveness="Visible cameras and audio warnings discourage vandals, and timestamped HD video supports police reports and prosecution"
          coverage="Complete site coverage including perimeter, equipment, and structures"
          includes={[
            "4 cameras (1 fixed fisheye + 3 PTZ 25x zoom with IR)",
            "Equipment training",
            "24/7 technical support",
            "Solar power/generator included",
            "Remote viewing access on your mobile devices or computer"
          ]}
        />
      </div>
    </section>

    <!-- Vandalism Impact Statistics -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">The Hidden Cost of Construction Vandalism</h2>

        <StatBox
          stats={[
            {
              value: "Repairs",
              label: "Damaged Work Redone",
              icon: "💥",
              highlight: true
            },
            {
              value: "Cleanup",
              label: "Graffiti & Debris",
              icon: "🎨",
              highlight: false
            },
            {
              value: "Claims",
              label: "Insurance Paperwork",
              icon: "💸",
              highlight: false
            },
            {
              value: "Delays",
              label: "Schedule Slips",
              icon: "⏰",
              highlight: false
            }
          ]}
          className="max-w-5xl mx-auto mb-12"
        />

        <!-- Types of Vandalism Grid -->
        <div class="max-w-5xl mx-auto">
          <h3 class="text-2xl font-bold mb-8 text-center">Common Vandalism Attacks & Their Impact</h3>

          <div class="grid md:grid-cols-3 gap-6">
            <!-- Graffiti/Tagging -->
            <div class="bg-gray-50 rounded-lg p-6 border-l-4 border-red-500">
              <div class="text-2xl mb-3">🎨</div>
              <h4 class="font-bold text-lg mb-2">Graffiti & Tagging</h4>
              <ul class="text-sm space-y-1 text-gray-700 mb-3">
                <li>• Pressure washing and chemical removal</li>
                <li>• Repainting entire surfaces</li>
                <li>• Gang territory marking</li>
                <li>• Attracts more vandalism</li>
              </ul>
              <div class="text-xs bg-red-100 p-2 rounded">
                <strong>Risk:</strong> Happens in minutes, visible for months
              </div>
            </div>

            <!-- Equipment Damage -->
            <div class="bg-gray-50 rounded-lg p-6 border-l-4 border-orange-500">
              <div class="text-2xl mb-3">🔨</div>
              <h4 class="font-bold text-lg mb-2">Equipment Sabotage</h4>
              <ul class="text-sm space-y-1 text-gray-700 mb-3">
                <li>• Sugar in fuel tanks</li>
                <li>• Cut hydraulic lines</li>
                <li>• Smashed windows/controls</li>
                <li>• Costly repairs and downtime</li>
              </ul>
              <div class="text-xs bg-orange-100 p-2 rounded">
                <strong>Risk:</strong> Revenge attacks, competitor sabotage
              </div>
            </div>

            <!-- Arson -->
            <div class="bg-gray-50 rounded-lg p-6 border-l-4 border-red-600">
              <div class="text-2xl mb-3">🔥</div>
              <h4 class="font-bold text-lg mb-2">Arson & Fire</h4>
              <ul class="text-sm space-y-1 text-gray-700 mb-3">
                <li>• Total loss potential</li>
                <li>• Damage to structure and materials</li>
                <li>• Months of delays</li>
                <li>• Insurance complications</li>
              </ul>
              <div class="text-xs bg-red-200 p-2 rounded">
                <strong>Risk:</strong> Catastrophic loss, project failure
              </div>
            </div>

            <!-- Structural Damage -->
            <div class="bg-gray-50 rounded-lg p-6 border-l-4 border-purple-500">
              <div class="text-2xl mb-3">🏗️</div>
              <h4 class="font-bold text-lg mb-2">Structural Damage</h4>
              <ul class="text-sm space-y-1 text-gray-700 mb-3">
                <li>• Broken windows: $500-2000 each</li>
                <li>• Damaged drywall/framing</li>
                <li>• Concrete defacement</li>
                <li>• Costly rework</li>
              </ul>
              <div class="text-xs bg-purple-100 p-2 rounded">
                <strong>Risk:</strong> Requires complete reconstruction
              </div>
            </div>

            <!-- Illegal Dumping -->
            <div class="bg-gray-50 rounded-lg p-6 border-l-4 border-yellow-500">
              <div class="text-2xl mb-3">🗑️</div>
              <h4 class="font-bold text-lg mb-2">Illegal Dumping</h4>
              <ul class="text-sm space-y-1 text-gray-700 mb-3">
                <li>• Hazardous waste liability</li>
                <li>• Costly cleanup and disposal</li>
                <li>• EPA fines possible</li>
                <li>• Site contamination</li>
              </ul>
              <div class="text-xs bg-yellow-100 p-2 rounded">
                <strong>Risk:</strong> Legal liability, environmental damage
              </div>
            </div>

            <!-- Theft Vandalism -->
            <div class="bg-gray-50 rounded-lg p-6 border-l-4 border-blue-500">
              <div class="text-2xl mb-3">💥</div>
              <h4 class="font-bold text-lg mb-2">Destructive Entry</h4>
              <ul class="text-sm space-y-1 text-gray-700 mb-3">
                <li>• Fence cutting/ramming</li>
                <li>• Door/lock destruction</li>
                <li>• Container break-ins</li>
                <li>• Repairs before the site is secure again</li>
              </ul>
              <div class="text-xs bg-blue-100 p-2 rounded">
                <strong>Risk:</strong> Opens site to further crimes
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Who Vandalizes and Why -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Understanding Vandalism Threats</h2>

        <div class="max-w-5xl mx-auto">
          <div class="grid md:grid-cols-2 gap-8 mb-12">
            <!-- Who Vandalizes -->
            <div class="bg-white rounded-lg shadow-lg p-6">
              <h3 class="text-xl font-bold mb-4 text-indigo-900">Who Vandalizes Construction Sites</h3>
              <div class="space-y-3">
                <div class="border-b pb-2">
                  <strong class="text-indigo-700">Teenagers/Youth Groups</strong>
                  <p class="text-sm text-gray-600">Thrill-seeking, peer pressure, social media stunts</p>
                </div>
                <div class="border-b pb-2">
                  <strong class="text-indigo-700">Disgruntled Employees</strong>
                  <p class="text-sm text-gray-600">Revenge for termination, wage disputes</p>
                </div>
                <div class="border-b pb-2">
                  <strong class="text-indigo-700">Environmental Activists</strong>
                  <p class="text-sm text-gray-600">Protest against development projects</p>
                </div>
                <div class="border-b pb-2">
                  <strong class="text-indigo-700">Gang Members</strong>
                  <p class="text-sm text-gray-600">Territory marking, intimidation</p>
                </div>
                <div>
                  <strong class="text-indigo-700">Competitors</strong>
                  <p class="text-sm text-gray-600">Sabotage to delay projects, steal contracts</p>
                </div>
              </div>
            </div>

            <!-- When & Why -->
            <div class="bg-white rounded-lg shadow-lg p-6">
              <h3 class="text-xl font-bold mb-4 text-indigo-900">When & Why Sites Are Targeted</h3>
              <div class="space-y-3">
                <div class="border-b pb-2">
                  <strong class="text-red-700">Friday-Sunday Nights</strong>
                  <p class="text-sm text-gray-600">Sites sit empty from Friday evening to Monday morning</p>
                </div>
                <div class="border-b pb-2">
                  <strong class="text-red-700">Holiday Periods</strong>
                  <p class="text-sm text-gray-600">Extended site closures invite attacks</p>
                </div>
                <div class="border-b pb-2">
                  <strong class="text-red-700">Controversial Projects</strong>
                  <p class="text-sm text-gray-600">Gentrification, environmental concerns</p>
                </div>
                <div class="border-b pb-2">
                  <strong class="text-red-700">Visible from Roads</strong>
                  <p class="text-sm text-gray-600">Easy access, quick escape routes</p>
                </div>
                <div>
                  <strong class="text-red-700">Poor Lighting/Security</strong>
                  <p class="text-sm text-gray-600">Dark sites seen as easy targets</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Escalation Warning -->
          <div class="bg-red-50 border-2 border-red-200 rounded-lg p-6 text-center">
            <h3 class="text-xl font-bold mb-3 text-red-900">⚠️ Vandalism Escalates Without Response</h3>
            <p class="text-gray-700">Sites that have been hit once tend to get hit again. Each incident emboldens vandals and attracts copycats.</p>
            <p class="mt-3 font-semibold text-red-800">First incident > Word spreads > Repeated attacks > Total project failure</p>
          </div>
        </div>
      </div>
    </section>

    <!-- How Surveillance Prevents Vandalism -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Multi-Layer Vandalism Prevention System</h2>

        <div class="max-w-5xl mx-auto">
          <!-- Prevention Layers -->
          <div class="space-y-6">
            <!-- Deterrence Layer -->
            <div class="bg-indigo-50 rounded-lg p-6">
              <div class="flex items-center mb-4">
                <div class="bg-indigo-600 text-white rounded-full w-10 h-10 flex items-center justify-center font-bold mr-4">1</div>
                <h3 class="text-xl font-bold">Visible Deterrence</h3>
              </div>
              <p class="text-gray-700 mb-3">Highly visible surveillance stops many vandals before they act</p>
              <div class="grid md:grid-cols-2 gap-4">
                <ul class="text-sm space-y-1">
                  <li>✓ 20-foot elevated cameras</li>
                  <li>✓ Flashing LED warning lights</li>
                  <li>✓ "Recording in Progress" signs</li>
                </ul>
                <ul class="text-sm space-y-1">
                  <li>✓ Solar panels show 24/7 operation</li>
                  <li>✓ Multiple cameras visible</li>
                  <li>✓ Professional appearance</li>
                </ul>
              </div>
            </div>

            <!-- Detection Layer -->
            <div class="bg-yellow-50 rounded-lg p-6">
              <div class="flex items-center mb-4">
                <div class="bg-yellow-600 text-white rounded-full w-10 h-10 flex items-center justify-center font-bold mr-4">2</div>
                <h3 class="text-xl font-bold">Smart Detection</h3>
              </div>
              <p class="text-gray-700 mb-3">AI-powered cameras detect threats instantly, day or night</p>
              <div class="grid md:grid-cols-2 gap-4">
                <ul class="text-sm space-y-1">
                  <li>✓ Motion zones around key areas</li>
                  <li>✓ Person vs animal detection</li>
                  <li>✓ Loitering alerts</li>
                </ul>
                <ul class="text-sm space-y-1">
                  <li>✓ Infrared (IR) night vision</li>
                  <li>✓ 360° coverage</li>
                  <li>✓ Weather-resistant operation</li>
                </ul>
              </div>
            </div>

            <!-- Intervention Layer -->
            <div class="bg-orange-50 rounded-lg p-6">
              <div class="flex items-center mb-4">
                <div class="bg-orange-600 text-white rounded-full w-10 h-10 flex items-center justify-center font-bold mr-4">3</div>
                <h3 class="text-xl font-bold">Active Intervention</h3>
              </div>
              <p class="text-gray-700 mb-3">Automated deterrents trigger within seconds of detection, and you get an instant alert to respond</p>
              <div class="grid md:grid-cols-2 gap-4">
                <ul class="text-sm space-y-1">
                  <li>✓ Motion-triggered audio warnings</li>
                  <li>✓ Strobe light activation</li>
                  <li>✓ Siren alerts</li>
                </ul>
                <ul class="text-sm space-y-1">
                  <li>✓ "You are being recorded" warnings</li>
                  <li>✓ Custom warning messages</li>
                  <li>✓ Instant alerts to your phone or computer</li>
                </ul>
              </div>
            </div>

            <!-- Documentation Layer -->
            <div class="bg-green-50 rounded-lg p-6">
              <div class="flex items-center mb-4">
                <div class="bg-green-600 text-white rounded-full w-10 h-10 flex items-center justify-center font-bold mr-4">4</div>
                <h3 class="text-xl font-bold">Evidence & Prosecution</h3>
              </div>
              <p class="text-gray-700 mb-3">4K HD recording clear enough for identification and conviction</p>
              <div class="grid md:grid-cols-2 gap-4">
                <ul class="text-sm space-y-1">
                  <li>✓ Facial recognition quality</li>
                  <li>✓ License plate capture</li>
                  <li>✓ Time-stamped evidence</li>
                </ul>
                <ul class="text-sm space-y-1">
                  <li>✓ Cloud backup storage</li>
                  <li>✓ Court-admissible footage</li>
                  <li>✓ Insurance documentation</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Success Stories -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Vandalism Prevention Success Stories</h2>

        <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          <!-- Story 1 -->
          <div class="bg-white rounded-lg shadow-lg overflow-hidden">
            <div class="bg-indigo-600 text-white p-4">
              <h3 class="text-xl font-bold">School Construction - Tacoma</h3>
            </div>
            <div class="p-6">
              <div class="mb-4">
                <p class="font-semibold text-red-600">Challenge:</p>
                <p>Repeated graffiti attacks in the first month</p>
              </div>
              <div class="mb-4">
                <p class="font-semibold text-green-600">Solution:</p>
                <p>3 surveillance trailers with audio warnings</p>
              </div>
              <div class="mb-4">
                <p class="font-semibold text-blue-600">Results:</p>
                <ul class="list-disc list-inside text-gray-700">
                  <li>Vandals caught on camera, with footage handed to police</li>
                  <li>Graffiti attacks dropped off after the trailers went up</li>
                  <li>Project completed on time</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Story 2 -->
          <div class="bg-white rounded-lg shadow-lg overflow-hidden">
            <div class="bg-indigo-600 text-white p-4">
              <h3 class="text-xl font-bold">Apartment Complex - Federal Way</h3>
            </div>
            <div class="p-6">
              <div class="mb-4">
                <p class="font-semibold text-red-600">Challenge:</p>
                <p>Arson attempt, ongoing vandalism from local gang</p>
              </div>
              <div class="mb-4">
                <p class="font-semibold text-green-600">Solution:</p>
                <p>24/7 self-monitored surveillance with thermal cameras</p>
              </div>
              <div class="mb-4">
                <p class="font-semibold text-blue-600">Results:</p>
                <ul class="list-disc list-inside text-gray-700">
                  <li>Prevented second arson attempt</li>
                  <li>Video evidence handed to police</li>
                  <li>Gang moved operations elsewhere</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- Deployment Facts -->
        <div class="mt-12 max-w-4xl mx-auto">
          <div class="bg-indigo-100 border-2 border-indigo-300 rounded-lg p-8 text-center">
            <h3 class="text-2xl font-bold mb-4">What Every Trailer Brings to Your Site</h3>
            <div class="grid md:grid-cols-3 gap-6">
              <div>
                <div class="text-3xl font-bold text-indigo-700">4 Cameras</div>
                <p class="text-gray-700">1 fixed fisheye + 3 PTZ with IR</p>
              </div>
              <div>
                <div class="text-3xl font-bold text-indigo-700">24/7</div>
                <p class="text-gray-700">Self-monitoring with instant alerts</p>
              </div>
              <div>
                <div class="text-3xl font-bold text-indigo-700">2 Weeks</div>
                <p class="text-gray-700">Default video retention, extendable</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Risk Assessment Tool -->
    <section id="vandalism-assessment" class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Calculate Your Vandalism Risk</h2>

        <div class="max-w-3xl mx-auto bg-gray-50 rounded-lg shadow-lg p-8">
          <p class="mb-6 text-gray-700">Answer these questions to assess your vandalism risk level:</p>

          <div class="space-y-4">
            <div class="bg-white rounded p-4">
              <label class="block font-semibold mb-2">Project visibility from public areas:</label>
              <select id="visibility" class="w-full px-4 py-2 border rounded">
                <option value="1">Hidden/Not visible</option>
                <option value="2">Partially visible</option>
                <option value="3">Clearly visible from road</option>
                <option value="4">High traffic area</option>
              </select>
            </div>

            <div class="bg-white rounded p-4">
              <label class="block font-semibold mb-2">Weekend/night security:</label>
              <select id="night-security" class="w-full px-4 py-2 border rounded">
                <option value="4">None</option>
                <option value="3">Occasional patrols</option>
                <option value="2">Regular patrols</option>
                <option value="1">24/7 guard or surveillance</option>
              </select>
            </div>

            <div class="bg-white rounded p-4">
              <label class="block font-semibold mb-2">Area crime level:</label>
              <select id="crime-level" class="w-full px-4 py-2 border rounded">
                <option value="1">Low crime area</option>
                <option value="2">Moderate crime</option>
                <option value="3">High crime area</option>
                <option value="4">Known gang activity</option>
              </select>
            </div>

            <div class="bg-white rounded p-4">
              <label class="block font-semibold mb-2">Project type:</label>
              <select id="project-type" class="w-full px-4 py-2 border rounded">
                <option value="1">Industrial/Commercial</option>
                <option value="2">Residential</option>
                <option value="3">School/Public building</option>
                <option value="4">Controversial development</option>
              </select>
            </div>

            <div class="bg-white rounded p-4">
              <label class="block font-semibold mb-2">Previous incidents:</label>
              <select id="previous-incidents" class="w-full px-4 py-2 border rounded">
                <option value="1">None</option>
                <option value="2">One incident</option>
                <option value="3">2-3 incidents</option>
                <option value="4">Regular problem</option>
              </select>
            </div>
          </div>

          <button onclick="assessVandalismRisk()" class="w-full mt-6 bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-8 rounded-lg">
            Assess My Risk Level
          </button>

          <div id="risk-results" class="mt-8 hidden">
            <div class="p-6 rounded-lg">
              <h3 class="text-xl font-bold mb-4">Your Vandalism Risk Assessment:</h3>
              <div id="risk-level-display" class="text-2xl font-bold mb-4"></div>
              <div id="risk-description" class="mb-4"></div>
              <div id="risk-action" class="p-4 bg-blue-50 rounded"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Vandalism Prevention FAQs</h2>

        <div class="max-w-3xl mx-auto space-y-6">
          <div class="bg-white rounded-lg p-6 shadow">
            <h3 class="font-bold text-lg mb-2">How much does vandalism cost construction projects?</h3>
            <p class="text-gray-700">It varies widely with the type of damage. A single incident can mean repairs, cleanup, schedule delays, and higher insurance costs, and graffiti on large surfaces often means repainting whole walls.</p>
