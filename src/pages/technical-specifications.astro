                <tr class="border-b"><td class="py-2 px-2 font-semibold">D &middot; Fast 4G</td><td class="py-2 px-2">9000 / 9000 kbps, +170 ms</td><td class="py-2 px-2">11.4</td><td class="py-2 px-2">45.5</td><td class="py-2 px-2">7.7</td><td class="py-2 px-2">30.5</td></tr>
