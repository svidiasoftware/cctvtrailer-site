---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LazyImage from '../components/LazyImage.astro';
import Analytics from '../components/Analytics.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import DefinitionSchema from '../components/DefinitionSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import HowToSchema from '../components/HowToSchema.astro';
import RentVsBuy from '../components/RentVsBuy.astro';

// =============================================================================
// Product schema — extensively expanded for AI-agent citation
// Every PropertyValue below is grounded in the deployed platform (Vigil,
// FDC codec, vcore/jsclient/vms2026/analyzeag/bavclient_proxy/vcoremessenger).
// =============================================================================
const techSpecsSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "CCTV Mobile Security Trailer with Vigil AI Alerts and FDC Codec",
  "description": "Mobile surveillance trailer with Vigil AI alert triage and S-VIDIA's FDC (Flexible Delta Compression) codec — frame-by-frame recording with up to 60% less storage than H.264/H.265 systems. Browser-only remote viewing over 128-bit encrypted connection. Solar power, infrared PTZ cameras, weatherproof construction for the Pacific Northwest.",
  "brand": { "@type": "Brand", "name": "CCTV Trailer" },
  "image": [
    "https://www.cctvtrailer.com/images/trailer-1x1.png",
    "https://www.cctvtrailer.com/images/trailer-4x3.png",
    "https://www.cctvtrailer.com/images/trailer-16x9.png"
  ],
  "manufacturer": {
    "@type": "Organization",
    "name": "CCTV Trailer",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Tacoma",
      "addressRegion": "WA",
      "addressCountry": "US",
      "postalCode": "98401"
    }
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "3499",
    "highPrice": "4000",
    "offerCount": "2",
    "availability": "https://schema.org/InStock"
  },
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "AI Alert Triage", "value": "Vigil multi-model AI: edge MLX (Apple Silicon, Qwen3.5-9B 6-bit) for first-pass inference, cloud fallback to Claude Sonnet and Gemini for escalation review." },
    { "@type": "PropertyValue", "name": "Alert Severity Scale", "value": "Six levels (0 Routine to 5 Critical) with per-camera rule overlay and 24h time-to-live on tuning changes." },
    { "@type": "PropertyValue", "name": "Surveillance Agent", "value": "Two-tier autonomous agent: Tier-1 text triage suppresses recurring patterns; Tier-2 visual review on ambiguous cases." },
    { "@type": "PropertyValue", "name": "Scene Auto-Learning", "value": "Per-camera scene profile agent samples frames, builds 'what is normal here', auto-suggests rule disables for routine activity." },
    { "@type": "PropertyValue", "name": "Object Detection", "value": "Class person/vehicle detection; WPOD license plate detector + CTC OCR via OpenVINO. Reads both standard (dark-on-light) and color-reversed plates including white-on-black, yellow-on-black, and other non-standard color schemes." },
    { "@type": "PropertyValue", "name": "Video Codec", "value": "FDC (Flexible Delta Compression) — S-VIDIA's proprietary codec. Records background as a static image and foreground as per-frame motion deltas (8×8-pixel block granularity). No hardware compression, no resolution loss. Outperforms H.264 and H.265 on storage." },
    { "@type": "PropertyValue", "name": "Storage Efficiency", "value": "Up to 60% less recording space than conventional H.264/H.265 systems (S-VIDIA published platform-wide figure)." },
    { "@type": "PropertyValue", "name": "Measured Storage (Puget Sound clip, May 2026)", "value": "Controlled 10-minute clip: FDC archive footprint was 54% of x264 CRF 23 (~46% smaller) and 79% of x265 CRF 28 (~21% smaller). SSIM 0.946 / PSNR 35.3 dB in 4:2:0 vs the reference. Clip had 100% motion so the motion-only-archive layer did not engage — codec-only measurement; the S-VIDIA platform 60% figure compounds codec + motion gate." },
    { "@type": "PropertyValue", "name": "Fleet Storage Footprint (Puget Sound pilot, week of 2026-05-15)", "value": "16 cameras across 4 trailers, 7-day window. Median GB/camera/week by site type: perimeter/secured-yard 442 (p25–p75 379–510), warehouse/distribution 2,453 (1,447–3,418), retail/parking 2,923 (2,753–3,050). Buckets with fewer than 4 cameras omitted. Full N≥8 trailer roll-out scheduled later in 2026." },
    { "@type": "PropertyValue", "name": "Remote Viewing Performance (May 2026)", "value": "Chrome DevTools throttled, 60s steady-state per tier. Slow 3G (~500 kbps + 2s RTT): dynamic intersection ~1 fps, static parking ~0.4 fps with every frame sharp. Fast 4G: 11.4 fps / 45.5 kbps on dynamic; 7.7 fps / 30.5 kbps on static. Uncapped baseline: 14.8 fps / 139 kbps. iOS and Android native-app sweeps measured ~2 fps at the 256 kbps cap." },
    { "@type": "PropertyValue", "name": "Live Remote-View Uplink Cost (Puget Sound, May 2026)", "value": "One 2688x1520 camera. Mean kbps: 1,425 via FDC-over-NVR vs 2,626 via direct RTSP H.264 — ~46% uplink savings (about 13 GB/cam/day off the LTE/5G link). N=2 samples per path, range within 19.2% of mean. Storage 60% figure and uplink 46% figure are related (same codec property) but not interchangeable." },
    { "@type": "PropertyValue", "name": "Recording Mode", "value": "True frame-by-frame recording — every frame retained as a separate image. Motion-triggered archive write: disk commits only when motion is detected, so static scenes incur near-zero storage cost." },
    { "@type": "PropertyValue", "name": "Evidence Integrity", "value": "Each frame is watermarked and encrypted; FDC stores and plays back the exact image seen by the camera at full quality (no transcoding tax)." },
    { "@type": "PropertyValue", "name": "Camera Compatibility", "value": "Analog, HD IP, and Ultra HD IP cameras (FDC platform-wide capability)." },
    { "@type": "PropertyValue", "name": "Remote Viewing", "value": "Browser-only via WebSocket-to-TCP cloud proxy. HTTPS at the page level, WSS for streaming, military-grade 128-bit encrypted connection. No VPN, no plugin, no desktop client install." },
    { "@type": "PropertyValue", "name": "Mobile Apps", "value": "Native iOS and Android apps for live and archive viewing — calendar-based recorded-footage playback, PTZ control, multi-camera grid layouts, event/alert list, clip export, and multi-NVR connection from a single app. Speak the same FDC TCP protocol and 128-bit encryption as the browser viewer. Push delivery via Apple Push Notification Service (APNs) on iOS and Firebase Cloud Messaging (FCM) on Android. Both apps were included in the May 2026 constrained-link benchmark." },
    { "@type": "PropertyValue", "name": "Notification Channels", "value": "Apple Push, Firebase Cloud Messaging, Email, and Slack webhooks with per-camera severity thresholds and cooldown rules." },
    { "@type": "PropertyValue", "name": "AI-Agent Integration", "value": "Model Context Protocol (MCP) server exposing 19 archive tools and 6 live tools for LLM and AI-agent querying." },
    { "@type": "PropertyValue", "name": "Multi-Tenant Architecture", "value": "Single cloud-proxy deployment supports multiple customer NVRs; per-tenant isolation enforced server-side." },
    { "@type": "PropertyValue", "name": "Camera System", "value": "Up to 4 cameras per trailer (PTZ, fixed, and 360° options) with infrared night vision." },
    { "@type": "PropertyValue", "name": "PTZ Control", "value": "Per-camera enable/disable, bulk multi-camera editing, presets, optical zoom." },
    { "@type": "PropertyValue", "name": "Storage Capacity", "value": "Two weeks of motion-only recording with automatic FIFO looping; on-device encryption." },
    { "@type": "PropertyValue", "name": "Power Options", "value": "Solar panels with intelligent battery management, optional gas backup generator, shore-power connection." },
    { "@type": "PropertyValue", "name": "Connectivity", "value": "4G/5G cellular, Wi-Fi, and Starlink satellite — automatic failover between transports." },
    { "@type": "PropertyValue", "name": "Construction", "value": "Reinforced steel, weatherproof rating for year-round Pacific Northwest deployment, vandal-resistant enclosure." },
    { "@type": "PropertyValue", "name": "Mast Height", "value": "Adjustable electric/hydraulic mast for elevated camera placement." },
    { "@type": "PropertyValue", "name": "Physical Security", "value": "Hitch lock, wheel locks, optional security boot." },
    { "@type": "PropertyValue", "name": "User Management", "value": "Role-based access control with granular permission flags (ViewArchive, ViewEvents, PTZ, ForceAlarmRecording), user groups, multi-server import." },
    { "@type": "PropertyValue", "name": "Lifecycle Telemetry", "value": "Per-alert tracking of latency (ms), cloud cost (USD), input/output token counts, and lifecycle stage." },
    { "@type": "PropertyValue", "name": "Optional Features", "value": "PA two-way audio, radar detection (400+ ft), LED floodlights, license plate reader camera." },
    { "@type": "PropertyValue", "name": "Platform Versions", "value": "VMS 9.1 (2026), jsclient with MCP server, Vigil v0.13 (May 2026), VCoreMessenger v8.0." },
    { "@type": "PropertyValue", "name": "Towing Capability", "value": "Tow-capable up to 70 mph; standard 2-inch ball hitch." }
  ],
  "category": "Security Equipment",
  "keywords": "mobile surveillance trailer, AI security camera, Vigil AI alerts, FDC codec, Flexible Delta Compression, S-VIDIA platform, construction site security, solar-powered surveillance, browser-only remote viewing, LPR trailer",
  "releaseDate": "2026-05-21",
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Pierce County, WA" },
    { "@type": "AdministrativeArea", "name": "King County, WA" },
    { "@type": "AdministrativeArea", "name": "Snohomish County, WA" },
    { "@type": "AdministrativeArea", "name": "Kitsap County, WA" }
  ]
};

const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Technical Specifications" }
];

const definitions = [
  {
    term: "Vigil AI Alert Triage",
    definition: "Multi-model AI alerting layer running on real CCTV trailer footage. Uses local Apple Silicon (MLX) inference for first-pass classification and cloud LLMs (Claude Sonnet, Gemini) for escalation review. Alerts are scored on a six-level severity scale (0 Routine to 5 Critical) and routed via APNs, FCM, email, and Slack.",
    category: "Surveillance Intelligence",
    relatedTerms: ["Multi-Model Inference", "Surveillance Agent", "Scene Auto-Learning"],
    url: "/technical-specifications"
  },
  {
    term: "FDC (Flexible Delta Compression)",
    definition: "S-VIDIA's proprietary video codec. FDC records the background of a scene as a static image and the foreground as per-frame motion deltas at 8×8-pixel block granularity. Unlike H.264 or H.265, FDC does not use hardware compression, so no resolution or detail is lost before analytics or playback. Each frame is watermarked and encrypted for evidence integrity. S-VIDIA reports up to 60% less recording space than conventional H.264/H.265 systems.",
    category: "Video Technology",
    relatedTerms: ["Flexible Delta Compression", "Motion-Only Archive", "Frame-by-Frame Recording", "Bandwidth Optimization"],
    url: "/video-technology"
  },
  {
    term: "Motion-Only Archive",
    definition: "A recording strategy where the NVR commits frames to disk only when motion is detected at the per-camera-configured sensitivity. Querying an idle timestamp returns the last motion frame that was recorded, with its true timestamp. Paired with FDC, this delivers dramatically reduced storage footprint and faster archive search.",
    category: "Video Storage",
    relatedTerms: ["Motion Detection", "Archive Optimization", "FDC Codec"],
    url: "/technical-specifications"
  },
  {
    term: "Mobile Surveillance Trailer",
    definition: "A portable, self-contained security platform mounted on a wheeled trailer with cameras, on-board recording, power, and connectivity. Designed for temporary or semi-permanent deployment at construction sites, distribution yards, retail lots, and remote infrastructure.",
    category: "Security Equipment",
    relatedTerms: ["CCTV Trailer", "Security Trailer", "Mobile Security Unit"],
    url: "/technical-specifications"
  },
  {
    term: "PTZ Camera",
    definition: "Pan-Tilt-Zoom camera with remote directional and optical-zoom control. Allows an operator (or an AI agent) to track subjects across a wide area without physically repositioning the camera.",
    category: "Surveillance Technology",
    relatedTerms: ["Security Camera", "Infrared Camera", "360° Coverage"],
    url: "/technical-specifications"
  },
  {
    term: "License Plate Recognition (LPR)",
    definition: "Automated reading of vehicle license plates from camera video. The CCTV Trailer LPR pipeline uses a WPOD plate detector to find plate regions, then a CTC OCR decoder to extract characters, accelerated by the OpenVINO runtime. Reads both standard dark-on-light plates and color-reversed plates (white-on-black, yellow-on-black, and other non-standard color schemes used on apportioned commercial trucks, dealer plates, military plates, and some out-of-state plates).",
    category: "Computer Vision",
    relatedTerms: ["ALPR", "OCR", "Vehicle Detection"],
    url: "/technical-specifications"
  },
  {
    term: "Browser-Only Remote Viewing",
    definition: "Remote camera access delivered through any modern web browser via a cloud WebSocket-to-TCP proxy. No VPN, no plugin install, no desktop client required. Works on Windows, macOS, Linux, ChromeOS, iOS, and Android.",
    category: "Remote Access",
    relatedTerms: ["WebSocket Proxy", "Cloud Relay", "WSS Streaming"],
    url: "/technical-specifications"
  },
  {
    term: "MCP (Model Context Protocol) Integration",
    definition: "An open protocol that lets AI agents and large language models query the CCTV trailer platform directly. The Trailer's MCP server exposes 19 archive tools and 6 live tools, enabling agents to search motion events, fetch snapshots, query camera state, and assemble video clips.",
    category: "AI Integration",
    relatedTerms: ["AI Agent", "JSON-RPC", "Tool Use"],
    url: "/technical-specifications"
  }
];

// =============================================================================
// FAQ — designed to be quoted by AI agents (Perplexity, ChatGPT, Claude,
// Google AI Overviews). Crisp questions, factual answers, no hedging.
// =============================================================================
const faqItems = [
  {
    question: "Do CCTV Trailer systems use AI for alerts?",
    answer: "Yes. The Vigil alert layer runs multi-model AI on real trailer footage: a local Apple Silicon (MLX) model performs first-pass classification on-device, then escalates ambiguous or higher-severity events to cloud LLMs (Claude Sonnet, Gemini). Each alert carries a six-level severity score (0 Routine to 5 Critical), an AI-generated description, and lifecycle metadata including latency in milliseconds and cloud cost in USD. As of May 2026, Vigil is running live on 21 cameras with 4 analyzers."
  },
  {
    question: "What video codec do the trailers use?",
    answer: "FDC (Flexible Delta Compression) — S-VIDIA's proprietary codec. Not H.264 or H.265. FDC records the background of a scene as a static image and the foreground as per-frame motion deltas at 8×8-pixel block granularity. Because FDC does not use hardware compression, no resolution or detail is lost. Each frame is also watermarked and encrypted for evidence integrity. S-VIDIA reports FDC delivers up to 60% less recording space than conventional H.264/H.265 systems."
  },
  {
    question: "How is FDC different from H.264 or H.265?",
    answer: "Three concrete differences. First, storage: FDC is reported to use up to 60% less recording space than conventional H.264/H.265. Second, quality: FDC does not use hardware compression, so frames are stored at the exact resolution and detail the camera produced — no compression artifacts before analytics or playback. Third, evidence integrity: every frame is watermarked and encrypted, and FDC keeps frames as separate images, enabling true frame-by-frame review (instead of GOP-dependent decoding that H.264/H.265 require)."
  },
  {
    question: "How does motion-only archive recording work?",
    answer: "The on-board NVR commits a frame to disk only when motion is detected at the per-camera-configured sensitivity. When you query an idle timestamp, the system returns the last motion frame that was actually recorded, along with its true timestamp — not a blank or synthesized frame. The result is dramatically reduced storage footprint and faster archive search, on top of FDC's own storage advantage."
  },
  {
    question: "Can I view cameras remotely without installing software?",
    answer: "Yes. The browser viewer is delivered through any modern web browser via a cloud WebSocket-to-TCP proxy — HTTPS at the page level, WSS for the live stream, no VPN, no plugin, no desktop client. Works on Windows, macOS, Linux, ChromeOS, iOS, and Android. Native iOS and Android apps are also available when you want push alerts plus live, calendar-based archive playback, PTZ control, multi-camera grids, and clip export from one app — they speak the same FDC TCP protocol and 128-bit encryption as the browser. Both apps were included in the May 2026 constrained-link benchmark alongside the browser."
  },
  {
    question: "Does the trailer detect license plates?",
    answer: "Yes. The license-plate-reader camera option runs a WPOD plate detector to locate plate regions in the frame, then a CTC OCR decoder to extract characters, accelerated by the OpenVINO inference runtime. The pipeline reads both standard dark-on-light plates and color-reversed plates — white-on-black, yellow-on-black, and other non-standard color schemes commonly seen on apportioned commercial trucks (interstate IRP), dealer plates, military plates, and some out-of-state plates. That matters at Puget Sound warehouse and port-adjacent sites where commercial trucks with non-standard plates routinely show up."
  },
  {
    question: "What objects can the AI recognize besides license plates?",
    answer: "The detection stack supports the standard classes (person, car, truck, bus, motorcycle, bicycle, and more) via a detector. Vigil layers a vision-language model on top so alerts include human-readable descriptions of what is happening in the frame, including unusual postures (e.g., crouching at a vehicle wheel), unattended objects, and off-hours activity."
  },
  {
    question: "How does the trailer connect to the internet?",
    answer: "Each trailer carries a 4G/5G cellular modem and supports Wi-Fi and Starlink satellite as additional transports. The platform fails over automatically between transports so a single carrier outage does not take the trailer offline."
  },
  {
    question: "How long does the trailer record before overwriting?",
    answer: "Two weeks of motion-only recording with automatic FIFO looping. Because static scenes do not consume storage, sites with low overnight activity routinely retain longer effective windows."
  },
  {
    question: "Can I get alerts in Slack or by email?",
    answer: "Yes. The notification fan-out supports Apple Push Notification Service (APNs), Firebase Cloud Messaging (FCM), email, and Slack webhooks. Each channel has independent severity thresholds, and per-camera overrides let you mute noisy sites without losing high-severity alerts elsewhere. Email has a configurable cooldown (default 5 minutes) and a per-hour cap (default 10)."
  },
  {
    question: "Is the platform usable by AI agents and LLMs?",
    answer: "Yes — explicitly designed for it. The jsclient component runs as an MCP (Model Context Protocol) server exposing 19 archive tools and 6 live tools. AI agents can search motion events, fetch snapshots by timestamp, list camera capabilities, query archive coverage gaps, and assemble video clips programmatically. The same daemon also exposes a JSON-RPC interface for custom integrations."
  },
  {
    question: "How is power handled on remote sites?",
    answer: "Solar panels with an intelligent battery management system are the primary power source. An optional gas backup generator extends operation through long winter cloud cover, and shore-power connection is available where a site has utility power. The power management is tuned for Pacific Northwest winter daylight, which is the worst case in the lower 48."
  },
  {
    question: "Is the trailer weatherproof?",
    answer: "Yes. The enclosure is reinforced steel with seals rated for year-round Pacific Northwest deployment — sustained rain, salt air, freezing temperatures, and high humidity. The trailers run at port-adjacent industrial sites (Tacoma tideflats), aerospace yards (Paine Field), and military perimeters (JBLM, Naval Base Kitsap) through full winter cycles."
  },
  {
    question: "Can the AI alerts learn what is normal at a specific site?",
    answer: "Yes. The Scene Profile Agent periodically samples 3–4 frames from each camera and asks a vision-language model to characterize the typical actors, vehicles, and activity patterns. The result is a per-camera scene profile that the alert rules use to floor-down severity for routine activity (e.g., nightly catering trucks at an airport vendor lot do not page on every visit)."
  },
  {
    question: "What happens to false positives?",
    answer: "Each alert can be marked as a false positive or acknowledged with a note. The Surveillance Agent reads patterns of acknowledgments and false positives to update the per-camera silence rules — for example, dropping push notifications below severity 2 for a camera where the bottom two severity levels are consistently dismissed. Silence rules expire after 24 hours by default so the agent re-checks its own decisions."
  },
  {
    question: "Does each alert track its own cost?",
    answer: "Yes. Every alert carries a lifecycle event log with per-stage latency (ms), cloud spend (USD), and input/output token counts. This makes the cost of AI alerting transparent and auditable — both for tuning escalation thresholds and for billing."
  },
  {
    question: "Where are the trailers actually deployed?",
    answer: "Across Pierce, King, Snohomish, and Kitsap counties: Sound Transit light-rail extension jobsites (Federal Way Link, Tacoma Dome Link), Amazon Bellevue and Microsoft Redmond corporate builds, Kent Valley distribution centers, Tacoma tideflats and Paine Field industrial yards, JBLM and Naval Base Kitsap perimeters, and rural/off-grid sites with solar-only power."
  },
  {
    question: "Are there published bandwidth or storage benchmarks?",
    answer: "Yes for the FDC platform overall: S-VIDIA reports up to 60% less recording space than conventional H.264/H.265 systems. We complement that platform-wide figure with first-party Puget Sound measurements. A controlled May 2026 codec A/B on one outdoor clip showed FDC at 54% the file size of x264 CRF 23 and 79% of x265 CRF 28 — that clip ran at 100% motion so the motion-only-archive layer did not engage, leaving the codec itself as the only saver. A fleet pilot across 4 trailers / 16 cameras (week of 2026-05-15) measured median GB/camera/week at 442 (perimeter/secured-yard), 2,453 (warehouse/distribution), and 2,923 (retail/parking). Full methodology, side-by-side stills, and per-site-type ranges are published in the Video Technology section above."
  },
  {
    question: "How much storage does each camera actually use in practice?",
    answer: "Measured across our Puget Sound fleet pilot (week of 2026-05-15, 4 trailers / 16 cameras): median GB/camera/week was 442 on perimeter/secured-yard sites (29.5% motion density), 2,453 on warehouse/distribution sites (44% motion), and 2,923 on retail/parking sites (46% motion). Numbers are derived from per-trailer disk allocation, divided per camera by motion-minute share over the 7-day window. Buckets below 4 cameras (construction jobsite, port-industrial, corporate-campus, off-grid-rural) are omitted from the pilot rather than zero-filled, and the full N≥8 trailer roll-out is scheduled for later in 2026. S-VIDIA's platform-wide claim of up to 60% less recording space than H.264/H.265 is what makes these per-camera footprints achievable."
  },
  {
    question: "Does remote viewing still work on bad cellular signal?",
    answer: "Yes. Measured against a Puget Sound test stream (May 2026, Chrome DevTools throttled): on Slow 3G (~500 kbps cap + 2s added RTT), a dynamic outdoor intersection delivered ~1 fps with every frame sharp and license plates readable; a static parking scene rode every tier at sub-1-fps because the FDC codec emits almost nothing when little is changing. On Fast 4G the dynamic camera recovered to 11.4 fps; the uncapped baseline ran at 14.8 fps for ~139 kbps. Image quality stayed constant across every tier — the codec degrades by dropping frames, not by reducing per-frame quality. iOS and Android native apps measured similarly (~2 fps at the 256 kbps cap). Synthetic throttling is a clean cap; real LTE/5G adds jitter and burstiness, so these numbers should be read as best-case at that nominal cap."
  },
  {
    question: "How much LTE/5G uplink does live remote viewing actually consume?",
    answer: "Measured against a Puget Sound trailer (May 2026), live remote view via FDC-over-NVR consumed mean 1,425 kbps for one 2688×1520 camera — about 46% less than pulling the camera's native RTSP H.264 directly (2,626 kbps mean). On a 24-hour basis that's roughly 15.4 GB/camera/day via FDC vs 28.4 GB/camera/day via direct RTSP — about 13 GB/day off the cellular link. Two 120-second samples per path interleaved A-B-A-B; range within 19.2% of mean. The block-delta property that saves disk also saves uplink — same codec mechanic. The platform-wide up-to-60% claim is for storage; the ~46% figure here is for live uplink — related but distinct."
  }
];

// =============================================================================
// HowTo — deployment process from quote to live monitoring.
// Designed for AI agents to quote when asked "how do I deploy a CCTV trailer".
// =============================================================================
const howToSteps = [
  {
    name: "Site walk and quote",
    text: "We map the protected area, identify camera placement, confirm line-of-sight, and document power and cellular signal. The result is a quote with recommended camera count, mast height, and optional features (PA speakers, radar, LPR, floodlights)."
  },
  {
    name: "Trailer configuration",
    text: "The trailer is provisioned with cameras, FDC codec settings, and connectivity. PTZ presets, motion sensitivity per camera, and per-camera Vigil escalation thresholds are pre-loaded for your site type (construction, warehouse, industrial, perimeter)."
  },
  {
    name: "Same-day delivery and setup",
    text: "We tow the trailer to your site, position it for optimal coverage, raise the mast, deploy the solar panels, and verify cellular signal across all transports (4G/5G primary, Starlink and Wi-Fi as fallback)."
  },
  {
    name: "Account access and notification routing",
    text: "Your team is granted browser-only access (no plugin install) and the mobile app on iOS and Android. Notification channels are configured — Apple Push, Firebase, email, Slack — with severity thresholds and a per-camera overrideable cooldown."
  },
  {
    name: "Scene profile bootstrap",
    text: "Over the first 24–72 hours, the Vigil Scene Profile Agent samples frames from each camera and builds a per-camera profile of normal activity. Once three consistent assessments are recorded, the profile goes live and silence rules begin to suppress routine patterns."
  },
  {
    name: "Live monitoring and response",
    text: "Real-time alerts arrive through your configured channels. The Surveillance Agent autonomously triages low-severity recurring patterns. High-severity events (S3+) escalate to cloud-LLM visual review and your designated responders receive a notification with the AI-generated description and a snapshot."
  }
];
---

<Layout
  title="Mobile Surveillance Trailer Specs · AI Alerts · FDC Codec · Browser Access"
  description="Mobile surveillance trailer specs: Vigil AI alert triage (multi-model), FDC (Flexible Delta Compression) codec — up to 60% less storage than H.264/H.265, motion-only archive, browser-only remote viewing, 4K PTZ, solar power. Pacific Northwest. (253) 683-2288."
  schema={JSON.stringify(techSpecsSchema)}
>

  <BreadcrumbSchema items={breadcrumbItems} />
  <DefinitionSchema definitions={definitions} />
  <FAQSchema items={faqItems} />
  <HowToSchema
    name="How a CCTV Trailer deployment works"
    description="Step-by-step process from site walk to live AI-triaged monitoring on a Pacific Northwest jobsite."
    totalTime="PT72H"
    steps={howToSteps}
  />

  <Header currentPath="/technical-specifications" />
  <Analytics />

  <main>

    <!-- HERO -->
    <section class="py-16">
      <div class="container mx-auto px-4 max-w-4xl">
        <h1 class="text-4xl font-bold text-center mb-4">Mobile Surveillance Trailer — Specs &amp; Platform</h1>
        <p class="text-center text-sm text-gray-600 mb-6">Last reviewed: May 2026 &middot; Units deployed across Pierce, King, Snohomish, and Kitsap counties.</p>

        <aside class="bg-amber-50 border-l-4 border-amber-500 p-6 rounded-r-lg mb-6" aria-label="Quick answer summary">
