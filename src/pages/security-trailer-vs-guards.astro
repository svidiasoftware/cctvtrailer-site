---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LazyImage from '../components/LazyImage.astro';
import CTASection from '../components/CTASection.astro';
import StatBox from '../components/StatBox.astro';
import ComparisonTable from '../components/ComparisonTable.astro';

const title = "Security Trailer vs Security Guards | Cost & Effectiveness Comparison";
const description = "Compare mobile surveillance trailers vs security guards for construction sites. See real guard costs and what 24/7 coverage and ROI look like on Washington state projects.";
---

<Layout title={title} description={description}>
  <Header />

  <main>
    <!-- Hero Section -->
    <div class="hero-trailer">
      <div class="hero-overlay">
        <LazyImage src="/images/tacoma-dome-bg-hero3.webp" alt="Security trailer vs security guards comparison"
        class="w-full h-full object-cover" width="1920" height="1080" fetchPriority="high" loading="eager" />
      </div>
      <div class="hero-content">
        <div class="hero-text-wrapper">
          <h1 class="hero-heading">Security Trailer vs Security Guards</h1>
          <p class="hero-paragraph">
            Cut security costs and keep 24/7 coverage. Here's why more Washington contractors are moving from guards to mobile surveillance.
          </p>
          <a href="/contact" class="red-button mt-6">Get Cost Comparison</a>
        </div>
      </div>
    </div>

    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">
            Real Cost Comparison for Washington Construction Sites
          </h2>
          <p class="text-xl text-gray-600">
            Estimates based on typical 2024-2025 market rates in the Seattle-Tacoma area
          </p>
        </div>

        <StatBox
          stats={[
            { value: "20-30 min", label: "Setup Time", subtext: "No installation required", color: "green" },
            { value: "24/7", label: "Self-Monitoring", subtext: "Real-time alerts to your phone", color: "blue" },
            { value: "$36,000+", label: "Monthly Guard Cost", subtext: "Estimate: 2 guards on post 24/7 at ~$20/hr plus overhead", color: "red" },
            { value: "Same-day", label: "Delivery", subtext: "Trailer arrives ready to run", color: "purple" }
          ]}
        />

        <div class="mt-12 bg-gray-50 p-8 rounded-lg">
          <h3 class="text-2xl font-bold mb-6">Monthly Cost Calculator</h3>
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Site Size (sq ft)</label>
              <input type="number" id="siteSize" class="w-full px-3 py-2 border border-gray-300 rounded-md" placeholder="50000" value="50000">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Coverage Hours</label>
              <select id="coverageHours" class="w-full px-3 py-2 border border-gray-300 rounded-md">
                <option value="night">Nights Only (6pm-6am)</option>
                <option value="24/7" selected>24/7 Coverage</option>
                <option value="business">Business Hours Only</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Security Option</label>
              <select id="securityType" class="w-full px-3 py-2 border border-gray-300 rounded-md">
                <option value="guards">Security Guards</option>
                <option value="trailer" selected>Mobile Surveillance Trailer</option>
                <option value="both">Hybrid (Trailer + 1 Guard)</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Contract Length</label>
              <select id="contractLength" class="w-full px-3 py-2 border border-gray-300 rounded-md">
                <option value="daily">Daily</option>
                <option value="weekly">Weekly</option>
                <option value="monthly" selected>Monthly</option>
                <option value="annual">Annual</option>
              </select>
            </div>
            <div class="md:col-span-2">
              <label for="trailerRate" class="block text-sm font-medium text-gray-700 mb-2">Your quoted trailer rental ($/month)</label>
              <input type="number" id="trailerRate" min="0" class="w-full px-3 py-2 border border-gray-300 rounded-md" placeholder="From your CCTV Trailer quote">
              <p class="text-xs text-gray-500 mt-1">Don't have a quote? Call <a href="tel:2536832288" class="text-blue-600 underline">(253) 683-2288</a></p>
            </div>
          </div>

          <div class="mt-8 p-6 bg-white rounded-lg">
            <h4 class="font-bold text-lg mb-4">Cost Analysis</h4>
            <div class="grid md:grid-cols-3 gap-4">
              <div>
                <p class="text-sm text-gray-600">Security Guards Cost</p>
                <p class="text-2xl font-bold text-red-600" id="guardsCost">$37,440/mo</p>
                <p class="text-xs text-gray-500">2 guards @ $20/hr + overhead</p>
              </div>
              <div>
                <p class="text-sm text-gray-600">Surveillance Trailer Cost</p>
                <p class="text-2xl font-bold text-green-600" id="trailerCost">-</p>
                <p class="text-xs text-gray-500">24/7 self-monitoring with real-time alerts</p>
              </div>
              <div>
                <p class="text-sm text-gray-600">Your Savings</p>
                <p class="text-2xl font-bold text-blue-600" id="monthlySavings">-</p>
                <p class="text-xs text-gray-500" id="savingsPercent">vs. security guards</p>
              </div>
            </div>
            <div class="mt-4 p-4 bg-green-50 rounded">
              <p class="text-lg font-semibold">Annual Savings: <span id="annualSavings" class="text-green-600">-</span></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-center mb-12">
          Feature-by-Feature Comparison
        </h2>

        <ComparisonTable
          headers={["Security Guards", "Mobile Surveillance Trailer"]}
          rows={[
            { feature: "Monthly Cost (24/7)", values: ["$36,000+ (2 guards, estimate)", { text: "Typically a fraction of guard costs (call for a quote)", highlight: true }] },
            { feature: "Coverage Area", values: ["Limited patrol radius", { text: "360° complete coverage", highlight: true }] },
            { feature: "Response Time", values: ["Varies by location", { text: "Instant AI detection", highlight: true }] },
            { feature: "Weather Impact", values: ["Reduced effectiveness", { text: "All-weather operation", highlight: true }] },
            { feature: "Recording Capability", values: ["Body cam only", { text: "2-week archive (extendable)", highlight: true }] },
            { feature: "False Alarms", values: ["Human error prone", { text: "AI filtering cuts nuisance alerts", highlight: true }] },
            { feature: "Insurance Discount", values: ["Varies by insurer", { text: "Ask your carrier about camera discounts", highlight: true }] },
            { feature: "Deployment Time", values: ["Depends on staffing availability", { text: "Same-day delivery, 20-30 min setup", highlight: true }] },
            { feature: "Scalability", values: ["Requires more guards", { text: "Single unit covers more", highlight: true }] },
            { feature: "Evidence Quality", values: ["Witness testimony", { text: "4K video evidence", highlight: true }] }
          ]}
        />

        <div class="grid md:grid-cols-2 gap-8 mt-12">
          <div class="bg-white p-8 rounded-lg shadow">
            <h3 class="text-xl font-bold mb-4 text-red-600">Hidden Costs of Security Guards</h3>
            <ul class="space-y-3">
              <li class="flex items-start">
                <svg class="w-5 h-5 text-red-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
                <div>
                  <strong>Overtime & Holiday Pay:</strong> Often time-and-a-half on holidays
                </div>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-red-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
                <div>
                  <strong>Training & Turnover:</strong> High turnover means constant retraining
                </div>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-red-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
                <div>
                  <strong>Liability Insurance:</strong> Often $2-5 million in coverage required
                </div>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-red-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
                <div>
                  <strong>Break Coverage:</strong> A 3rd guard is often needed for true 24/7
                </div>
              </li>
            </ul>
          </div>

          <div class="bg-white p-8 rounded-lg shadow">
            <h3 class="text-xl font-bold mb-4 text-green-600">Surveillance Trailer Advantages</h3>
            <ul class="space-y-3">
              <li class="flex items-start">
                <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <div>
                  <strong>No Human Limitations:</strong> Never sleeps, no breaks needed
                </div>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <div>
                  <strong>Predictable Costs:</strong> Fixed monthly rate, no surprises
                </div>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <div>
                  <strong>Legal Protection:</strong> Timestamped video evidence
                </div>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <div>
                  <strong>Instant Deployment:</strong> Same-day setup available
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-center mb-12">
          Cost Analysis: Estimates for a Washington Project
        </h2>

        <div class="bg-gray-50 p-8 rounded-lg mb-8">
          <h3 class="text-2xl font-bold mb-6">Typical 6-Month Construction Project</h3>
          <div class="grid md:grid-cols-2 gap-8">
            <div>
              <h4 class="font-bold text-lg mb-4">Security Guard Option</h4>
              <ul class="space-y-2">
                <li class="flex justify-between">
                  <span>2 Guards (24/7 coverage)</span>
                  <span class="font-semibold">$28,800/mo</span>
                </li>
                <li class="flex justify-between">
                  <span>Supervisor/Management</span>
                  <span class="font-semibold">$2,000/mo</span>
                </li>
                <li class="flex justify-between">
                  <span>Holiday/Overtime Premium</span>
                  <span class="font-semibold">$4,320/mo</span>
                </li>
                <li class="flex justify-between">
                  <span>Insurance & Liability</span>
                  <span class="font-semibold">$1,500/mo</span>
                </li>
                <li class="border-t pt-2 flex justify-between font-bold">
                  <span>Monthly Total</span>
                  <span>$36,620</span>
                </li>
                <li class="flex justify-between font-bold text-red-600">
                  <span>6-Month Project Cost</span>
                  <span>$219,720</span>
                </li>
              </ul>
            </div>
            <div>
              <h4 class="font-bold text-lg mb-4">Surveillance Trailer Option</h4>
              <ul class="space-y-2">
                <li class="flex justify-between">
                  <span>Surveillance Trailer</span>
                  <span class="font-semibold">Per your quote</span>
                </li>
                <li class="flex justify-between">
                  <span>24/7 Self-Monitoring</span>
                  <span class="font-semibold">Live view + alerts on your phone</span>
                </li>
                <li class="flex justify-between">
                  <span>Equipment Training & 24/7 Tech Support</span>
                  <span class="font-semibold">Included</span>
                </li>
                <li class="flex justify-between">
                  <span>Guard Liability Insurance</span>
                  <span class="font-semibold">$0/mo</span>
                </li>
                <li class="border-t pt-2 flex justify-between font-bold">
                  <span>Monthly Total</span>
                  <span>Your quoted rate</span>
                </li>
                <li class="flex justify-between font-bold text-green-600">
                  <span>6-Month Project Cost</span>
                  <span>Your quoted rate × 6</span>
                </li>
              </ul>
            </div>
          </div>
          <div class="mt-6 p-4 bg-green-100 rounded-lg text-center">
            <p class="text-2xl font-bold">Typically a fraction of the $164,520 guard cost. Call (253) 683-2288 for a quote.</p>
            <p class="text-gray-600 mt-2">Some insurers also adjust premiums for sites with video surveillance, so ask your carrier.</p>
          </div>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-blue-50 p-6 rounded-lg text-center">
            <h4 class="font-bold mb-2">Break-Even Point</h4>
            <p class="text-3xl font-bold text-blue-600">Your numbers</p>
            <p class="text-sm text-gray-600">Compare one avoided theft to your trailer quote</p>
          </div>
          <div class="bg-green-50 p-6 rounded-lg text-center">
            <h4 class="font-bold mb-2">Video Retention</h4>
            <p class="text-3xl font-bold text-green-600">2 weeks</p>
            <p class="text-sm text-gray-600">Default archive, extendable</p>
          </div>
          <div class="bg-purple-50 p-6 rounded-lg text-center">
            <h4 class="font-bold mb-2">Cameras</h4>
            <p class="text-3xl font-bold text-purple-600">4</p>
            <p class="text-sm text-gray-600">1 fixed fisheye + 3 PTZ (25x zoom, IR)</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-center mb-12">
          Frequently Asked Questions
        </h2>

        <div class="max-w-3xl mx-auto">
          <div class="space-y-6">
            <div class="bg-white p-6 rounded-lg shadow">
              <h3 class="font-bold text-lg mb-2">
                How much does a security trailer cost compared to guards?
              </h3>
              <div>
                <p class="text-gray-600">
                  Mobile surveillance trailer pricing depends on rental length, site, and configuration; call (253) 683-2288 for a quote. Security guards for the same 24/7 coverage can run $36,000+ per month (2 guards on post 24/7 at roughly $20/hour, plus overhead), so a trailer with 24/7 self-monitoring is typically a fraction of the cost of round-the-clock guards.
                </p>
              </div>
            </div>

            <div class="bg-white p-6 rounded-lg shadow">
              <h3 class="font-bold text-lg mb-2">
                Which is more effective: surveillance trailers or security guards?
              </h3>
              <div>
                <p class="text-gray-600">
                  Surveillance trailers deter a lot of opportunistic crime through visible cameras and AI detection, while providing 360-degree coverage without blind spots. Guards have limited patrol radius and human limitations like fatigue. Trailers also provide legal-quality video evidence.
                </p>
              </div>
            </div>

            <div class="bg-white p-6 rounded-lg shadow">
              <h3 class="font-bold text-lg mb-2">
                What are the hidden costs of hiring security guards?
              </h3>
              <div>
                <p class="text-gray-600">
                  Hidden costs can include overtime pay (time-and-a-half), holiday premiums, training costs, high turnover, liability insurance (often $2-5 million in coverage), workers' compensation, and the need for a third guard to cover breaks for true 24/7 coverage.
                </p>
              </div>
            </div>

            <div class="bg-white p-6 rounded-lg shadow">
              <h3 class="font-bold text-lg mb-2">
                Can surveillance trailers work in bad weather?
              </h3>
              <div>
                <p class="text-gray-600">
                  Yes, surveillance trailers are designed for all-weather operation with IP67-rated cameras, heated enclosures, and backup power systems. They keep working at full effectiveness through rain, snow, and extreme temperatures, while a guard on patrol tends to be less effective in severe weather.
                </p>
              </div>
            </div>

            <div class="bg-white p-6 rounded-lg shadow">
              <h3 class="font-bold text-lg mb-2">
                Do insurance companies prefer surveillance trailers over guards?
              </h3>
              <div>
                <p class="text-gray-600">
                  Often, yes. Many insurers look favorably on continuous video surveillance because cameras document incidents better and cover the site consistently. Some offer premium reductions for sites with cameras, so ask your carrier what applies to your policy.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTASection />
  </main>

  <Footer />

  <script>
    function calculateCosts() {
      const siteSize = parseFloat(document.getElementById('siteSize').value) || 50000;
      const coverage = document.getElementById('coverageHours').value;
      const securityType = document.getElementById('securityType').value;
      const contract = document.getElementById('contractLength').value;

      // Base costs
      let guardHourlyRate = 20;
      // Trailer cost comes from the visitor's own quote
      const trailerRate = parseFloat(document.getElementById('trailerRate').value);
      const hasQuote = trailerRate > 0;
      const trailerMonthly = hasQuote ? trailerRate : 0;

      // Adjust for coverage hours
      let hoursPerMonth = coverage === '24/7' ? 720 : coverage === 'night' ? 360 : 360;
      let guardsNeeded = coverage === '24/7' ? 2 : 1;

      // Adjust for site size
      if (siteSize > 100000) {
        guardsNeeded = Math.ceil(guardsNeeded * 1.5);
      }

      // Calculate guard costs
      let guardMonthlyCost = guardsNeeded * guardHourlyRate * hoursPerMonth;
      // Add overhead (benefits, insurance, management)
      guardMonthlyCost *= 1.3;

      // Add contract discounts (guards; the trailer quote already reflects contract length)
      if (contract === 'annual') {
        guardMonthlyCost *= 0.95;
      }

      // Calculate based on security type
      let actualGuardCost = securityType === 'guards' || securityType === 'both' ? guardMonthlyCost : 0;
      let actualTrailerCost = securityType === 'trailer' || securityType === 'both' ? trailerMonthly : 0;

      if (securityType === 'both') {
        actualGuardCost *= 0.5; // Only one guard needed with trailer
      }

      // Update display
      document.getElementById('guardsCost').textContent = `$${Math.round(guardMonthlyCost).toLocaleString()}/mo`;

      // Trailer-dependent results: show the number when a quote is entered, otherwise a prompt
      const setTrailerResult = (id, text) => {
        const el = document.getElementById(id);
        el.textContent = hasQuote ? text : 'Enter your quote to compare';
        el.style.fontSize = hasQuote ? '' : '1rem';
      };
      const savings = guardMonthlyCost - trailerMonthly;
      setTrailerResult('trailerCost', `$${Math.round(trailerMonthly).toLocaleString()}/mo`);
      setTrailerResult('monthlySavings', `$${Math.round(Math.abs(savings)).toLocaleString()}/mo`);
      setTrailerResult('annualSavings', `$${Math.round(Math.abs(savings * 12)).toLocaleString()}`);
      document.getElementById('savingsPercent').textContent = hasQuote
        ? `${Math.round((savings / guardMonthlyCost) * 100)}% vs. security guards`
        : 'vs. security guards';
    }

    // Add event listeners
    document.getElementById('siteSize').addEventListener('input', calculateCosts);
    document.getElementById('coverageHours').addEventListener('change', calculateCosts);
    document.getElementById('securityType').addEventListener('change', calculateCosts);
    document.getElementById('contractLength').addEventListener('change', calculateCosts);
    document.getElementById('trailerRate').addEventListener('input', calculateCosts);

    // Initial calculation
    calculateCosts();
  </script>

