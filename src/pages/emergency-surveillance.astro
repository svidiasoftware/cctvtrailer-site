---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Analytics from '../components/Analytics.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import StatBox from '../components/StatBox.astro';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.cctvtrailer.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://www.cctvtrailer.com/services/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Emergency Surveillance"
    }
  ]
});

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Emergency Surveillance Trailer Rental",
  "provider": {
    "@type": "LocalBusiness",
    "name": "CCTV Trailer",
    "telephone": "+12536832288",
    "email": "info@cctvtrailer.com",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Tacoma",
      "addressRegion": "WA",
      "addressCountry": "US"
    }
  },
  "description": "Emergency surveillance trailer deployment for urgent security needs, with same-day deployment subject to availability. Rapid-deployment mobile surveillance with 24/7 self-monitoring for disasters, incidents, and temporary security requirements.",
  "areaServed": [
    {"@type": "State", "name": "Washington"},
    {"@type": "City", "name": "Tacoma"},
    {"@type": "City", "name": "Seattle"},
    {"@type": "City", "name": "Olympia"},
    {"@type": "City", "name": "Federal Way"}
  ],
  "availableChannel": {
    "@type": "ServiceChannel",
    "serviceType": "Emergency Response",
    "availableLanguage": "English",
    "servicePhone": "+12536832288"
  },
  "hoursAvailable": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    "opens": "00:00",
    "closes": "23:59"
  }
});
---

<Layout 
  title="Emergency Surveillance Trailers | Same-Day Rapid Deployment Security"
  description="Emergency surveillance trailer rental with same-day deployment. Temporary security camera trailers for disasters, incidents & urgent needs. Call (253) 683-2288 NOW"
  schema={[breadcrumbSchema, schema]}>
  
  <Header showEmergencyBar={true} currentPath="/emergency-surveillance" />
  <Analytics />

  <main>
    <!-- Urgent Hero Section -->
    <section class="bg-gradient-to-r from-red-700 to-red-900 text-white py-16">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl">
          <div class="bg-yellow-400 text-black font-bold px-4 py-2 rounded inline-block mb-4">
            ⚡ SAME-DAY EMERGENCY DEPLOYMENT ⚡
          </div>
          <h1 class="text-4xl md:text-5xl font-bold mb-4">Emergency Surveillance Trailers</h1>
          <p class="text-2xl mb-6 font-semibold"><strong>Same-Day Setup</strong> • <strong>No Long-Term Contracts</strong></p>
          <div class="bg-white/10 border-2 border-white rounded-lg p-6 mb-6">
            <p class="text-xl mb-4">📞 24/7 EMERGENCY HOTLINE:</p>
            <a href="tel:2536832288" class="text-4xl font-bold hover:underline">(253) 683-2288</a>
            <p class="mt-2">Same-day deployment • Call to check availability</p>
          </div>
          <div class="grid md:grid-cols-3 gap-4 text-center">
            <div class="bg-white/20 rounded p-4">
              <div class="text-3xl mb-2">⏱️</div>
              <p class="font-bold">Same-Day Deployment</p>
              <p class="text-sm">Subject to availability</p>
            </div>
            <div class="bg-white/20 rounded p-4">
              <div class="text-3xl mb-2">📅</div>
              <p class="font-bold">No Contracts</p>
              <p class="text-sm">Day-to-day rentals OK</p>
            </div>
            <div class="bg-white/20 rounded p-4">
              <div class="text-3xl mb-2">🚚</div>
              <p class="font-bold">We Deploy</p>
              <p class="text-sm">Professional delivery &amp; setup available</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Answer Box for Emergency -->
    <section class="py-8 bg-gray-50">
      <div class="container mx-auto px-4">
        <QuickAnswer
          what="Rapid-deployment surveillance trailers with 24/7 self-monitoring for emergency and crisis situations"
          time="20-30 minute setup, same-day delivery"
          coverage="Tacoma, Seattle, Olympia, Federal Way, entire Puget Sound"
          availability="Call to inquire: (253) 683-2288"
          customFields={[
            { label: "Priority", value: "Emergency calls take precedence" }
          ]}
          includes={[
            "4 cameras (1 fixed fisheye + 3 PTZ 25x zoom with IR)",
            "Equipment training",
            "24/7 technical support",
            "Solar power/generator included",
            "Remote viewing access on your mobile devices or computer"
          ]}
        />
      </div>
    </section>

    <!-- Emergency Response Statistics -->
    <section class="py-12 bg-white">
      <div class="container mx-auto px-4">
        <StatBox
          title="Emergency Response Capability"
          layout="compact"
          stats={[
            {
              value: "Same Day",
              label: "Emergency Deployment",
              icon: "⚡",
              highlight: true
            },
            {
              value: "24/7",
              label: "Technical Support",
              icon: "🚨",
              highlight: false
            },
            {
              value: "4",
              label: "Cameras per Trailer",
              icon: "📹",
              highlight: true
            },
            {
              value: "20-30 min",
              label: "Setup on Arrival",
              icon: "📅",
              highlight: false
            }
          ]}
        />
      </div>
    </section>

    <!-- Emergency Situations -->
    <section class="py-16">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-4">Emergency Situations We Respond To</h2>
        <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto">Our emergency response team deploys surveillance trailers for situations like these:</p>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
          <div class="bg-red-50 border-2 border-red-200 rounded-lg p-6">
            <div class="text-3xl mb-3">🔥</div>
            <h3 class="font-bold text-lg mb-2">Fire & Disaster Response</h3>
            <ul class="text-sm text-gray-700 space-y-1">
              <li>• Monitor evacuation zones</li>
              <li>• Protect damaged properties</li>
              <li>• Prevent looting</li>
              <li>• Document for insurance</li>
            </ul>
          </div>
          
          <div class="bg-red-50 border-2 border-red-200 rounded-lg p-6">
            <div class="text-3xl mb-3">🚨</div>
            <h3 class="font-bold text-lg mb-2">Crime Scene Security</h3>
            <ul class="text-sm text-gray-700 space-y-1">
              <li>• Secure active investigations</li>
              <li>• Monitor evidence areas</li>
              <li>• Protect crime scenes</li>
              <li>• Support law enforcement</li>
            </ul>
          </div>
          
          <div class="bg-red-50 border-2 border-red-200 rounded-lg p-6">
            <div class="text-3xl mb-3">🏚️</div>
            <h3 class="font-bold text-lg mb-2">Vandalism & Break-ins</h3>
            <ul class="text-sm text-gray-700 space-y-1">
              <li>• Immediate deterrence</li>
              <li>• Prevent repeat incidents</li>
              <li>• Gather evidence</li>
              <li>• 24/7 self-monitoring</li>
            </ul>
          </div>
          
          <div class="bg-red-50 border-2 border-red-200 rounded-lg p-6">
            <div class="text-3xl mb-3">⚠️</div>
            <h3 class="font-bold text-lg mb-2">Accident Sites</h3>
            <ul class="text-sm text-gray-700 space-y-1">
              <li>• Industrial accidents</li>
              <li>• Construction incidents</li>
              <li>• Traffic collision scenes</li>
              <li>• Investigation support</li>
            </ul>
          </div>
          
          <div class="bg-red-50 border-2 border-red-200 rounded-lg p-6">
            <div class="text-3xl mb-3">💨</div>
            <h3 class="font-bold text-lg mb-2">Storm Damage</h3>
            <ul class="text-sm text-gray-700 space-y-1">
              <li>• Protect exposed property</li>
              <li>• Monitor repairs</li>
              <li>• Prevent theft</li>
              <li>• Insurance documentation</li>
            </ul>
          </div>
          
          <div class="bg-red-50 border-2 border-red-200 rounded-lg p-6">
            <div class="text-3xl mb-3">🏗️</div>
            <h3 class="font-bold text-lg mb-2">Equipment Failure</h3>
            <ul class="text-sm text-gray-700 space-y-1">
              <li>• Replace failed systems</li>
              <li>• Temporary coverage</li>
              <li>• Bridge security gaps</li>
              <li>• Maintain protection</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Response Timeline -->
    <section class="bg-gray-900 text-white py-16">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Our Emergency Response Process</h2>
        <div class="max-w-4xl mx-auto">
          <div class="space-y-8">
            <div class="flex items-start">
              <div class="bg-red-600 text-white font-bold rounded-full w-12 h-12 flex items-center justify-center flex-shrink-0">1</div>
              <div class="ml-6">
                <h3 class="text-xl font-bold mb-2">Your Call</h3>
                <p>Call our 24/7 emergency hotline and tell us what happened and where. We'll assess your needs while you're on the phone.</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="bg-red-600 text-white font-bold rounded-full w-12 h-12 flex items-center justify-center flex-shrink-0">2</div>
              <div class="ml-6">
                <h3 class="text-xl font-bold mb-2">Rapid Dispatch</h3>
                <p>Our team prepares equipment and dispatches the nearest available trailer to your location.</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="bg-red-600 text-white font-bold rounded-full w-12 h-12 flex items-center justify-center flex-shrink-0">3</div>
              <div class="ml-6">
                <h3 class="text-xl font-bold mb-2">On-Site Arrival (Same Day)</h3>
                <p>Professional technicians arrive with a fully equipped surveillance trailer ready for immediate deployment. Same-day deployment is subject to availability.</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="bg-red-600 text-white font-bold rounded-full w-12 h-12 flex items-center justify-center flex-shrink-0">4</div>
              <div class="ml-6">
                <h3 class="text-xl font-bold mb-2">System Activation (20-30 minutes)</h3>
                <p>We position the trailer and bring the system online. Your 24/7 self-monitoring starts immediately, with real-time alerts and live view on your mobile devices or computer.</p>
              </div>
            </div>
          </div>
          
          <div class="mt-12 bg-red-600 rounded-lg p-6 text-center">
            <p class="text-2xl font-bold mb-2">Same-Day Protection</p>
            <p>From your call to full protection, subject to availability. Call (253) 683-2288 to check availability.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Emergency Response Matters -->
    <section class="py-16">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Why Immediate Security Response Matters</h2>
        <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          <div class="bg-white border-2 border-gray-200 rounded-lg p-8">
            <h3 class="text-2xl font-bold mb-6 text-red-700">Without Rapid Security</h3>
            <ul class="space-y-3 text-gray-700">
              <li class="flex items-start">
                <span class="text-red-600 mr-3">✗</span>
                <div>Thieves and vandals often come back to a site they've already hit</div>
              </li>
              <li class="flex items-start">
                <span class="text-red-600 mr-3">✗</span>
                <div>Evidence can be destroyed or contaminated</div>
              </li>
              <li class="flex items-start">
                <span class="text-red-600 mr-3">✗</span>
                <div>Insurance claims may be disputed</div>
              </li>
              <li class="flex items-start">
                <span class="text-red-600 mr-3">✗</span>
                <div>Property damage compounds</div>
              </li>
              <li class="flex items-start">
                <span class="text-red-600 mr-3">✗</span>
                <div>Liability exposure increases</div>
              </li>
            </ul>
          </div>
          
          <div class="bg-green-50 border-2 border-green-200 rounded-lg p-8">
            <h3 class="text-2xl font-bold mb-6 text-green-700">With Our Emergency Response</h3>
            <ul class="space-y-3 text-gray-700">
              <li class="flex items-start">
                <span class="text-green-600 mr-3">✓</span>
                <div>Immediate deterrence stops further incidents</div>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-3">✓</span>
                <div>HD video evidence preserved for authorities</div>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-3">✓</span>
                <div>Insurance documentation secured</div>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-3">✓</span>
                <div>24/7 self-monitoring with real-time alerts helps prevent escalation</div>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-3">✓</span>
                <div>One less thing to worry about during a crisis</div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Emergency Features -->
    <section class="bg-red-50 py-16">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Emergency-Ready Features</h2>
        <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          <div class="bg-white rounded-lg shadow-lg p-6 text-center">
            <div class="text-4xl mb-4">🔋</div>
            <h3 class="font-bold text-lg mb-2">Self-Powered</h3>
            <p class="text-gray-600">Solar + generator backup operates without external power for weeks</p>
          </div>
          <div class="bg-white rounded-lg shadow-lg p-6 text-center">
            <div class="text-4xl mb-4">📡</div>
            <h3 class="font-bold text-lg mb-2">Cellular Connected</h3>
            <p class="text-gray-600">4G LTE connectivity works anywhere with cell service</p>
          </div>
          <div class="bg-white rounded-lg shadow-lg p-6 text-center">
            <div class="text-4xl mb-4">🌧️</div>
            <h3 class="font-bold text-lg mb-2">All-Weather</h3>
            <p class="text-gray-600">Operates in rain, snow, wind, and extreme temperatures</p>
          </div>
          <div class="bg-white rounded-lg shadow-lg p-6 text-center">
            <div class="text-4xl mb-4">👁️</div>
            <h3 class="font-bold text-lg mb-2">Night Vision</h3>
            <p class="text-gray-600">Infrared cameras provide clear footage in total darkness</p>
          </div>
          <div class="bg-white rounded-lg shadow-lg p-6 text-center">
            <div class="text-4xl mb-4">🔊</div>
            <h3 class="font-bold text-lg mb-2">Voice Warning</h3>
            <p class="text-gray-600">Motion-triggered or user-triggered speaker warnings for immediate deterrence</p>
          </div>
          <div class="bg-white rounded-lg shadow-lg p-6 text-center">
            <div class="text-4xl mb-4">💾</div>
            <h3 class="font-bold text-lg mb-2">2-Week Archive</h3>
            <p class="text-gray-600">Encrypted motion-only recording, two weeks by default (extendable in special cases), with instant access</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Emergency Rental Quotes -->
    <section class="py-16">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-4">Emergency Rental Quotes</h2>
        <p class="text-center text-gray-600 mb-12">No contracts required • Cancel anytime • Billing starts upon deployment</p>

        <div class="max-w-4xl mx-auto bg-white rounded-lg shadow-xl overflow-hidden">
          <div class="bg-red-600 text-white p-6">
            <h3 class="text-2xl font-bold text-center">Get an Emergency Deployment Quote</h3>
          </div>
          <div class="p-8 text-center">
            <p class="text-lg text-gray-700 mb-4">Pricing depends on rental length, site, and configuration. Call for a fast quote and to check same-day availability.</p>
            <a href="tel:2536832288" class="text-3xl font-bold text-red-700 hover:underline">(253) 683-2288</a>
            <div class="mt-8 p-4 bg-yellow-50 border-2 border-yellow-300 rounded-lg">
              <p class="text-center font-bold text-lg">🚨 Every emergency rental includes:</p>
              <p class="text-center text-gray-700 mt-2">4 cameras (1 fixed fisheye + 3 PTZ with 25x optical zoom and IR) • Equipment training • 24/7 technical support • Solar power/generator • Remote viewing on your mobile devices or computer</p>
              <p class="text-center text-gray-600 text-sm mt-2">Professional delivery and setup available</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Emergency Contact Form -->
    <section id="emergency-contact" class="bg-red-900 text-white py-16">
      <div class="container mx-auto px-4">
        <div class="max-w-2xl mx-auto">
          <div class="bg-white text-gray-900 rounded-lg shadow-2xl p-8">
            <h2 class="text-3xl font-bold text-center mb-2 text-red-700">Need Emergency Security NOW?</h2>
            <p class="text-center text-gray-600 mb-6">Call immediately or fill out this urgent request form</p>
            
            <div class="bg-red-100 border-2 border-red-300 rounded-lg p-6 mb-6">
              <p class="text-center text-xl font-bold text-red-700 mb-2">🚨 FASTEST RESPONSE 🚨</p>
              <p class="text-center text-3xl font-bold"><a href="tel:2536832288" class="text-red-700 hover:underline">(253) 683-2288</a></p>
              <p class="text-center text-gray-600 mt-2">24/7 Emergency Hotline • Same-day deployment subject to availability</p>
            </div>
            
            <QuoteForm 
              formTitle="Emergency Deployment Request"
              showTitle={true}
              buttonText="REQUEST EMERGENCY DEPLOYMENT >"
              responseTime="* Urgent? Call (253) 683-2288 for the fastest response."
              formId="emergency-deployment-form"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Trust Indicators -->
    <section class="py-16">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Trusted Emergency Response Partner</h2>
        <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto text-center">
          <div>
            <div class="text-4xl font-bold text-red-600 mb-2">20-30 min</div>
            <p class="text-gray-600">Setup on Arrival</p>
          </div>
          <div>
            <div class="text-4xl font-bold text-red-600 mb-2">24/7</div>
            <p class="text-gray-600">Technical Support</p>
          </div>
          <div>
            <div class="text-4xl font-bold text-red-600 mb-2">Same-Day</div>
            <p class="text-gray-600">Delivery Available</p>
          </div>
        </div>
        
        <!-- <div class="mt-12 max-w-3xl mx-auto">
          <div class="bg-gray-100 rounded-lg p-6">
            <p class="text-center text-gray-700 italic">"When our warehouse was broken into on a Friday night, CCTV Trailer had surveillance up and running by midnight. The thieves came back Saturday but fled when they saw the trailer. Saved us thousands in additional losses."</p>
            <p class="text-center font-bold mt-4">- Mike R., Tacoma Business Owner</p>
          </div>
        </div> -->
      </div>
    </section>

    <!-- Final CTA -->
    <CTASection 
      title="Don't Wait - Secure Your Property NOW"
      description="Thieves often come back after the first hit. Get surveillance on site before they do."
      phoneText="🚨 CALL NOW: (253) 683-2288"
      quoteText="Request Emergency Deployment >"
      quoteLink="#emergency-contact"
      features={["✓ Same-day deployment - call to check availability", "✓ No contracts or commitments", "✓ Insurance claim assistance"]}
      bgColor="bg-red-800"
    />

    <!-- Related Services & Coverage Section -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Related Services & Emergency Coverage</h2>

        <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          <!-- Related Services -->
          <div>
            <h3 class="text-xl font-bold mb-6 text-gray-800">Other Security Solutions</h3>
            <div class="space-y-4">
              <a href="/construction-security" class="block bg-white border rounded-lg p-4 hover:shadow-lg transition-shadow">
                <h4 class="font-bold text-lg text-blue-700">Construction Site Security</h4>
                <p class="text-gray-600 text-sm mt-1">Long-term jobsite protection and theft prevention</p>
              </a>
              <a href="/event-security" class="block bg-white border rounded-lg p-4 hover:shadow-lg transition-shadow">
                <h4 class="font-bold text-lg text-blue-700">Event Surveillance</h4>
                <p class="text-gray-600 text-sm mt-1">Crowd monitoring for festivals and gatherings</p>
              </a>
              <a href="/trailer-technology" class="block bg-white border rounded-lg p-4 hover:shadow-lg transition-shadow">
                <h4 class="font-bold text-lg text-blue-700">Mobile Trailer Technology</h4>
                <p class="text-gray-600 text-sm mt-1">Learn about our rapid deployment capabilities</p>
              </a>
            </div>
          </div>

          <!-- Emergency Coverage Areas -->
          <div>
            <h3 class="text-xl font-bold mb-6 text-gray-800">Emergency Response Areas</h3>
            <div class="space-y-4">
              <a href="/seattle-surveillance-rental" class="block bg-white border rounded-lg p-4 hover:shadow-lg transition-shadow">
                <h4 class="font-bold text-lg text-red-700">Seattle Emergency Response</h4>
                <p class="text-gray-600 text-sm mt-1">Same-day deployment to King County, subject to availability</p>
              </a>
              <a href="/tacoma-security-trailer" class="block bg-white border rounded-lg p-4 hover:shadow-lg transition-shadow">
                <h4 class="font-bold text-lg text-red-700">Tacoma Rapid Deployment</h4>
                <p class="text-gray-600 text-sm mt-1">Rapid response across Pierce County</p>
              </a>
              <a href="/federal-way-surveillance" class="block bg-white border rounded-lg p-4 hover:shadow-lg transition-shadow">
                <h4 class="font-bold text-lg text-red-700">Federal Way Coverage</h4>
                <p class="text-gray-600 text-sm mt-1">Quick response to South King County</p>
              </a>
              <a href="/olympia-mobile-cctv" class="block bg-white border rounded-lg p-4 hover:shadow-lg transition-shadow">
                <h4 class="font-bold text-lg text-red-700">Olympia Emergency Service</h4>
                <p class="text-gray-600 text-sm mt-1">Thurston County disaster response</p>
              </a>
            </div>
          </div>
        </div>

        <div class="mt-8 text-center">
          <a href="/services" class="text-blue-700 hover:text-blue-900 font-bold">View All Security Services ></a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>