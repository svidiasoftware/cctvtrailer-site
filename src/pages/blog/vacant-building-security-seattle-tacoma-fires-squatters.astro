    <!-- Hero Section -->
    <section class="hero-section-blog relative py-20 px-6 text-white">
      <div class="hero-overlay">
        <LazyImage src="/images/vacant-building-security-hero.webp" alt="A solar-powered CCTV Trailer mobile surveillance unit parked inside a chain-link fence beside a vacant, boarded-up two-story house in a Tacoma neighborhood at dusk"
