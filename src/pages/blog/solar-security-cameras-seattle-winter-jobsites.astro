                    url: "https://power.larc.nasa.gov/api/temporal/climatology/point?parameters=ALLSKY_SFC_SW_DWN,CLRSKY_SFC_SW_DWN&community=RE&longitude=-122.33&latitude=47.61&format=JSON"
                  }
                },
                {
                  value: "77",
                  label: "Nights a year at or below freezing at Olympia Airport, vs. 25 at Sea-Tac (1991-2020 normals)",
