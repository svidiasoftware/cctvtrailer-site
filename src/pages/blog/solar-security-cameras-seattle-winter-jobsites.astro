                    url: "https://aa.usno.navy.mil/calculated/rstt/oneday?date=2026-12-21&lat=47.61&lon=-122.33&label=Seattle%2C+WA&tz=8.00&tz_sign=-1&tz_label=false&dst=true&submit=Get+Data"
                  }
                },
                {
                  value: "0.85",
                  label: "kWh of sunlight per square meter per day on flat ground near Seattle in December, vs. 6.33 in July (2001-2020 average)",
