                    url: "https://www.ncei.noaa.gov/access/us-climate-normals/#dataset=normals-annualseasonal&timeframe=30&station=USW00024227"
                  }
                },
                {
                  value: "51,235",
                  label: "Puget Sound Energy customers without power at 5:30 p.m. on September 25, 2026, mostly around Olympia",
                  icon: "⚡",
                  highlight: false,
