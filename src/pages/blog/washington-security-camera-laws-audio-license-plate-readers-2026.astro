                  label: "Must consent before a private conversation is recorded or transmitted in Washington",
                  icon: "🎙️",
                  highlight: true,
                  source: {
                    text: "RCW 9.73.030",
                    url: "https://app.leg.wa.gov/rcw/default.aspx?cite=9.73.030"
                  }
                },
                {
