  <article>
    <!-- Hero Section -->
    <section class="hero-section-blog relative py-20 px-6 text-white">
      <div class="hero-overlay">
        <LazyImage src="/images/washington-camera-laws-hero.webp" alt="A solar-powered CCTV Trailer mobile surveillance unit parked inside the fence of a Tacoma-area construction site at dusk, next to a posted sign reading Notice: This Site Is Monitored by Video Surveillance"
          class="w-full h-full object-cover" width="1920" height="1080" fetchPriority="high" loading="eager" />
      </div>
