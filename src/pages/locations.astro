---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import SpeakableSchema from '../components/SpeakableSchema.astro';
import { locationGroups, allLocations } from '../data/locations.js';

const title = "Service Areas | Mobile Surveillance Trailer Rental Across Puget Sound";
const description = "CCTV Trailer rents mobile surveillance trailers throughout the Puget Sound region — Tacoma, Seattle, Kent, Federal Way, Olympia, Bremerton, and every city in between. Same-day delivery across Pierce, King, Kitsap, and Thurston counties.";

const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Service Areas" }
];

const speakableSections = [
  { cssSelector: ".quick-answer-content" },
  { cssSelector: "#coverage-intro h2, #coverage-intro p" },
  { cssSelector: "#locations-faq h2, #locations-faq div" }
];

// LocalBusiness + ItemList schema. The ItemList tells Google we have a
// dedicated page per city, which strengthens the service-area graph.
const localBusinessSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "CCTV Trailer",
  "description": "Mobile surveillance trailer rental throughout the Puget Sound region.",
  "telephone": "(253) 683-2288",
  "email": "info@cctvtrailer.com",
  "url": "https://www.cctvtrailer.com/locations",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "222 E 26th St",
    "addressLocality": "Tacoma",
    "addressRegion": "WA",
    "postalCode": "98421",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 47.2529,
    "longitude": -122.4443
  },
  "areaServed": allLocations.map((l) => ({
    "@type": "City",
    "name": l.city.split("—")[0].trim(),
    "containedInPlace": { "@type": "State", "name": "Washington" }
  }))
});

const itemListSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Puget Sound Service Areas",
  "itemListElement": allLocations.map((l, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `https://www.cctvtrailer.com${l.href}`,
    "name": l.city
  }))
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Which Puget Sound cities does CCTV Trailer serve?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We deliver mobile surveillance trailers throughout Pierce, King, Kitsap, and Thurston counties. Core service areas include Tacoma, Seattle, Kent, Federal Way, Auburn, Puyallup, Fife, Lakewood/JBLM, Olympia, and Bremerton. Other Puget Sound cities are served on request — call (253) 683-2288 to check availability."
      }
    },
    {
      "@type": "Question",
      "name": "Is there a travel or delivery fee outside Tacoma?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Delivery depends on where your site is, so it is quoted together with your rental. Professional delivery and setup are available throughout Pierce, King, Kitsap, and Thurston counties, including locations outside our core service radius. Call (253) 683-2288 for a quote."
      }
    },
    {
      "@type": "Question",
      "name": "How fast can you deploy a surveillance trailer in my area?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Standard deployment is same day or next business day for Pierce and South King County. Same-day emergency deployment is available across the Puget Sound region — call (253) 683-2288 to check availability. On-site setup typically takes 20–30 minutes."
      }
    },
    {
      "@type": "Question",
      "name": "What does a rental cost in my city?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Pricing depends on rental length, number of trailers, your site, and configuration, so every project is quoted individually. Every rental includes 4 cameras (1 fixed fisheye + 3 PTZ with 25x optical zoom and IR), equipment training, 24/7 technical support, solar power/generator, and remote viewing access on your mobile devices or computer. Professional delivery and setup available. Call (253) 683-2288 or request a quote."
      }
    }
  ]
});
---

<Layout
  title={title}
  description={description}
  schema={[localBusinessSchema, itemListSchema, faqSchema]}
>
  <Header currentPath="/locations" />
  <BreadcrumbSchema items={breadcrumbItems} />
  <SpeakableSchema sections={speakableSections} />

  <main>
    <!-- Hero -->
    <section class="bg-gray-900 text-white py-16">
      <div class="container mx-auto px-4 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Puget Sound Service Areas</h1>
        <p class="text-xl text-gray-200 max-w-3xl mx-auto">
          Mobile surveillance trailers with 24/7 self-monitoring, delivered across Pierce, King, Kitsap, and Thurston counties. Same-day delivery available — call for a quote.
        </p>
        <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
          <a href="tel:2536832288" class="bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-8 rounded-lg inline-block">
            📞 Call (253) 683-2288
          </a>
          <a href="/contact" class="bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-8 rounded-lg inline-block">
            Request a Quote
          </a>
        </div>
      </div>
    </section>

    <!-- Quick Answer -->
    <section class="py-8 bg-gray-50">
      <div class="container mx-auto px-4">
        <QuickAnswer
          what="Mobile surveillance trailer rentals with 24/7 self-monitoring, delivered across the Puget Sound region"
          time="20-30 minute setup, same-day delivery"
          coverage="Pierce · King · Kitsap · Thurston counties"
          availability="Call to inquire"
          includes={[
            "4 cameras (1 fixed fisheye + 3 PTZ with 25x optical zoom and IR)",
            "Equipment training",
            "24/7 technical support",
            "Solar power/generator included",
            "Remote viewing access on your mobile devices or computer"
          ]}
          customFields={[
            { label: "Cities Served", value: `${allLocations.length} dedicated city pages + request-only coverage` }
          ]}
        />
      </div>
    </section>

    <!-- Coverage intro -->
    <section id="coverage-intro" class="py-12 bg-white">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="text-3xl font-bold mb-4 text-gray-900">Coverage you can count on</h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-4">
          CCTV Trailer has been locally owned in Tacoma since 2009. Over that time we have delivered and set up surveillance trailers at construction sites, retail parking lots, events, and industrial facilities across every corner of the Puget Sound. Every service area on this page has a dedicated page with local context, landmarks, and crime data — pick your city below to see how we deploy there.
        </p>
        <p class="text-lg text-gray-700 leading-relaxed">
          Don't see your exact city? We routinely dispatch to <strong>Gig Harbor, Renton, Kirkland, Redmond, Sammamish, Lacey, and Bellingham</strong> and can deliver anywhere reachable on I-5, I-405, or SR-16. Call to check availability at <a href="tel:2536832288" class="text-red-600 hover:text-red-700 font-semibold">(253) 683-2288</a>.
        </p>
      </div>
    </section>

    <!-- Service area groups -->
    <section class="py-12 bg-gray-50">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-10">Service areas by region</h2>
        <div class="grid lg:grid-cols-3 gap-8">
          {locationGroups.map((group) => (
            <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200">
              <h3 class="text-xl font-semibold mb-4 text-gray-900">{group.label}</h3>
              <ul class="space-y-3">
                {group.cities.map((c) => (
                  <li>
                    <a href={c.href} class="block group">
                      <span class="block text-red-600 group-hover:text-red-700 font-semibold">{c.city}</span>
                      <span class="block text-sm text-gray-600 group-hover:text-gray-800">{c.angle}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Rental options & quotes -->
    <section class="py-12 bg-white">
      <div class="container mx-auto px-4 max-w-4xl text-center">
        <h2 class="text-2xl font-bold mb-4">Get a quote for your city</h2>
        <p class="text-lg text-gray-700 mb-6">
          Pricing depends on rental length, site, and configuration — call <a href="tel:2536832288" class="text-red-600 hover:text-red-700 font-semibold">(253) 683-2288</a> or request a quote. Rental options and what's included:
        </p>
        <a href="/pricing" class="bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-8 rounded-lg inline-block">
          Rental Options &amp; Quotes
        </a>
      </div>
    </section>

    <!-- FAQ -->
    <section id="locations-faq" class="py-16 bg-gray-50">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="text-3xl font-bold text-center mb-10">Service area FAQ</h2>

        <div class="space-y-6">
          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="font-semibold text-lg mb-2">Which Puget Sound cities does CCTV Trailer serve?</h3>
            <p class="text-gray-700">We deliver mobile surveillance trailers throughout Pierce, King, Kitsap, and Thurston counties. Core service areas include Tacoma, Seattle, Kent, Federal Way, Auburn, Puyallup, Fife, Lakewood/JBLM, Olympia, and Bremerton. Other Puget Sound cities are served on request — call (253) 683-2288 to check availability.</p>
          </div>
          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="font-semibold text-lg mb-2">Is there a travel or delivery fee outside Tacoma?</h3>
            <p class="text-gray-700">Delivery depends on where your site is, so it is quoted together with your rental. Professional delivery and setup are available throughout Pierce, King, Kitsap, and Thurston counties, including locations outside our core service radius. Call <a href="tel:2536832288" class="text-red-600 hover:text-red-700 font-semibold">(253) 683-2288</a> for a quote.</p>
          </div>
          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="font-semibold text-lg mb-2">How fast can you deploy a surveillance trailer in my area?</h3>
            <p class="text-gray-700">Standard deployment is same day or next business day for Pierce and South King County. Same-day emergency deployment is available across the Puget Sound region — call (253) 683-2288 to check availability. On-site setup typically takes 20–30 minutes.</p>
          </div>
          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="font-semibold text-lg mb-2">What does a rental cost in my city?</h3>
            <p class="text-gray-700">Pricing depends on rental length, number of trailers, your site, and configuration, so every project is quoted individually. Every rental includes 4 cameras (1 fixed fisheye + 3 PTZ with 25x optical zoom and IR), equipment training, 24/7 technical support, solar power/generator, and remote viewing access on your mobile devices or computer. Professional delivery and setup available. Call (253) 683-2288 or see <a href="/pricing" class="text-red-600 hover:text-red-700 underline">rental options &amp; quotes</a>.</p>
          </div>
        </div>
      </div>
    </section>

    <CTASection
      title="Need a trailer in your city?"
      description="Tell us where and when — we'll confirm availability and quote inside the hour."
      features={["✓ Same-day Puget Sound delivery", "✓ Professional delivery and setup available", "✓ 24/7 technical support"]}
    />
  </main>

  <Footer />
</Layout>
