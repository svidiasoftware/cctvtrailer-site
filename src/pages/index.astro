            </div>
          </div>
          
          <!-- Rental Facilities -->
          <div class="rounded-lg shadow-lg hover:shadow-xl transition-shadow overflow-hidden relative h-64">
            <LazyImage src="/images/industries/rental.webp" alt="Rental facility with inventory requiring portable security monitoring" 
              class="w-full h-full object-cover" width="400" height="300" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
              <h3 class="font-bold text-xl mb-2">Rental Facilities</h3>
