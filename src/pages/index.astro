            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
              <h3 class="font-bold text-xl mb-2">Material Suppliers</h3>
              <p class="text-sm">Secure perimeters and deter criminals from supplies and equipment stored in bulk.</p>
            </div>
          </div>
          
          <!-- Retail -->
          <div class="rounded-lg shadow-lg hover:shadow-xl transition-shadow overflow-hidden relative h-64">
            <LazyImage src="/images/industries/retail.webp" alt="Retail security systems Lakewood - Shopping center vandalism deterrent and parking lot monitoring Tacoma Mall area" 
