---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteForm from '../components/QuoteForm.astro';
import LazyImage from '../components/LazyImage.astro';
import ReviewSchema from '../components/ReviewSchema.astro';
import QuickAnswer from '../components/QuickAnswer.astro';

const schemas = [
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "CCTV Trailer",
    "description": "Locally owned surveillance security company serving Tacoma and the Pacific Northwest since 2009. Professional CCTV systems and mobile trailer rentals for construction sites, events, and emergency response.",
    "url": "https://www.cctvtrailer.com",
    "telephone": "+12536832288",
    "email": "info@cctvtrailer.com",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Tacoma",
      "addressRegion": "WA",
      "addressCountry": "US"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "47.2529",
      "longitude": "-122.4443"
    },
    "serviceArea": [
      {"@type": "City", "name": "Tacoma"},
      {"@type": "City", "name": "Seattle"},
      {"@type": "City", "name": "Olympia"},
      {"@type": "City", "name": "Fife"},
      {"@type": "City", "name": "Federal Way"},
      {"@type": "City", "name": "Kent"}
    ],
    "openingHours": "Mo-Fr 08:00-18:00",
    "priceRange": "$$"
  }),
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://www.cctvtrailer.com/"
      }
    ]
  }),
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How quickly can you deploy a mobile surveillance trailer?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We offer same-day delivery, including for emergency situations. Standard setup takes 20-30 minutes, and professional delivery and setup are available. Call (253) 683-2288 to check availability. Our service area covers Tacoma, Seattle, Olympia, and throughout the Puget Sound region."
        }
      },
      {
        "@type": "Question",
        "name": "How much does it cost to rent a security trailer?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pricing depends on rental length, site, and configuration, so we quote each project individually. Every rental includes 4 cameras (1 fixed fisheye + 3 PTZ with 25x optical zoom and IR), equipment training, 24/7 technical support, solar power/generator, and remote viewing on your mobile devices or computer. Professional delivery and setup are available. Call (253) 683-2288 for a quote."
        }
      },
      {
        "@type": "Question",
        "name": "What areas do you serve for mobile surveillance rentals?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We serve Tacoma, Seattle, Olympia, Federal Way, Kent, Fife, Auburn, Lakewood, Puyallup, Bremerton, and the entire Puget Sound region. We've been locally owned and operating since 2009. Call (253) 683-2288 to check availability."
        }
      },
      {
        "@type": "Question",
        "name": "Do your trailers work without electricity?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Our mobile surveillance trailers run on solar power with backup generators, so they work at remote construction sites and other locations with no power on site. They're designed to operate in all Pacific Northwest weather conditions."
        }
      },
      {
        "@type": "Question",
        "name": "What makes mobile surveillance better than fixed cameras?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Mobile trailers offer flexibility, faster deployment (20-30 minutes vs days/weeks), no installation costs, solar power independence, and easy relocation as your project progresses. They're ideal for temporary needs like construction sites and events."
        }
      }
    ]
  })
];

// Review data for schema
const reviewData = {
  reviews: [
    {
      author: "Alexx Bacon",
      authorTitle: "President, Aaberg's Rental",
      rating: 5,
      reviewBody: "The CCTVtrailer security camera system impresses with its exceptional quality, affordability, user-friendly software, and unwavering reliability. I recommend their products to anyone looking for the best in site security.",
      datePublished: "2024-11-15"
    },
    {
      author: "Sarah Chen",
      authorTitle: "Event Coordinator, Sound Events NW",
      rating: 5,
      reviewBody: "We needed emergency security for our outdoor festival in Pierce County. CCTV Trailer delivered and set up within 2 hours of our call. The video quality was crystal clear, even at night. Highly recommend!",
      datePublished: "2024-10-22"
    },
    {
      author: "Tom Williams",
      authorTitle: "Operations Director, Puget Logistics",
      rating: 5,
      reviewBody: "After copper theft hit our warehouse, we rented a trailer from CCTV. Zero incidents since. The S-VIDIA technology is impressive - we can monitor everything remotely. Much more cost-effective than hiring guards.",
      datePublished: "2024-09-30"
    }
  ],
  aggregateRating: {
    ratingValue: 5,
    reviewCount: 3
  },
  itemReviewed: {
    name: "CCTV Trailer Mobile Surveillance Services",
    type: "LocalBusiness"
  }
};
---

<Layout
  title="CCTV Trailer | Mobile Surveillance Trailer Rental Tacoma"
  description="Mobile surveillance trailer rentals in Tacoma & Seattle. 24/7 self-monitoring, same-day setup for construction & events. Local since 2009. (253) 683-2288"
  schema={schemas}>
  <Header showEmergencyBar={true} currentPath="/" />

  <main>
    <!-- <section class="relative bg-gradient-to-r from-gray-800 to-gray-900 text-white py-5 overflow-hidden"> -->
    <section class="hero-trailer">
      <div class="hero-overlay">
        <LazyImage src="/images/tacoma-dome-bg-hero4.webp"
          alt="Mobile surveillance trailer rental Tacoma WA - Construction site theft prevention equipment near Pierce County"
          class="w-full h-full object-cover"
          width="1920" height="1080" fetchPriority="high" loading="eager" />
      </div>
      <div class="hero-content">
        <div class="hero-text-wrapper">
          <h1 class="hero-heading">Mobile Security Trailer Rental - <strong>Setup in Minutes</strong></h1>
          <p class="hero-paragraph">
            <strong>Professional equipment rentals</strong> for construction sites, events, and temporary protection needs in <strong>Tacoma, Seattle, and the Puget Sound region</strong>.
          </p>
          <div class="hero-buttons">
            <a href="tel:2536832288" class="bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-8 rounded-lg inline-block">
              📞 Call (253) 683-2288
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Answer Box for AI/Search -->
    <section class="py-8 bg-gray-50">
      <div class="container mx-auto px-4">
        <QuickAnswer
          what="Mobile surveillance trailer rentals with 24/7 self-monitoring"
          time="20-30 minute setup, same-day delivery"
          coverage="Tacoma, Seattle, Olympia, Federal Way, entire Puget Sound"
          availability="Call to inquire"
          includes={[
            "4 cameras (1 fixed fisheye + 3 PTZ 25x zoom with IR)",
            "Equipment training",
            "24/7 technical support",
            "Solar power/generator included",
            "Remote viewing access on your mobile devices or computer"
          ]}
        />
      </div>
    </section>

    <section class="py-16">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Why Choose CCTV Trailer?</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center">
            <h3 class="text-xl font-semibold mb-2"><a href="/technical-specifications" class="hover:text-blue-600 transition-colors">Quick Setup</a></h3>
            <p class="text-gray-600"><strong>Deploy in minutes</strong>, no installation required (professional delivery and setup available)</p>
          </div>
          <div class="text-center">
            <h3 class="text-xl font-semibold mb-2"><a href="/video-technology" class="hover:text-blue-600 transition-colors">24/7 Self-Monitoring</a></h3>
            <p class="text-gray-600"><strong>Advanced video technology</strong> protects your assets</p>
          </div>
          <div class="text-center">
            <h3 class="text-xl font-semibold mb-2"><a href="/trailer-technology" class="hover:text-blue-600 transition-colors">Weather Resistant</a></h3>
            <p class="text-gray-600">Built for <strong>Pacific Northwest conditions</strong></p>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-gray-100 py-16">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-4">Industries We Serve</h2>
        <p class="text-center text-gray-600 mb-12 max-w-3xl mx-auto">
          From <strong>construction sites to special events</strong>, we set up each trailer around the risks of the site it's guarding.
        </p>
        
        <div class="grid md:grid-cols-3 lg:grid-cols-4 gap-12">
        <!-- <div class="features-grid"> -->
          <!-- Construction -->
          <a href="/construction-security" class="rounded-lg shadow-lg hover:shadow-xl transition-shadow overflow-hidden relative h-64 block">
            <LazyImage src="/images/industries/construction.webp" alt="Construction site security Tacoma - Job site theft prevention and vandalism deterrent systems Seattle area" 
              class="w-full h-full object-cover" width="400" height="300" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
              <h3 class="font-bold text-xl mb-2">Construction</h3>
              <p class="text-sm"><strong>Prevent theft and vandalism</strong> of materials at job sites and highway work zones with <strong>round-the-clock protection</strong>.</p>
            </div>
