        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <a href="/blog/washington-security-camera-laws-audio-license-plate-readers-2026" class="block bg-white rounded-lg p-5 shadow-sm hover:shadow-md transition-shadow">
