            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
              <h3 class="font-bold text-xl mb-2">Law Enforcement</h3>
              <p class="text-sm">Monitor high-crime areas and document suspicious activity for community protection.</p>
            </div>
          </div>
          
          <!-- Property Management -->
          <div class="rounded-lg shadow-lg hover:shadow-xl transition-shadow overflow-hidden relative h-64">
            <LazyImage src="/images/industries/property.webp" alt="Residential property complex requiring tenant and property protection" 
