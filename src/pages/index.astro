            <LazyImage src="/images/industries/cannabis.webp" alt="Cannabis facility requiring employee protection and inventory surveillance" 
              class="w-full h-full object-cover" width="400" height="300" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
              <h3 class="font-bold text-xl mb-2">Cannabis</h3>
              <p class="text-sm">Watch over employees and high-value inventory with real-time surveillance.</p>
            </div>
          </div>
          
