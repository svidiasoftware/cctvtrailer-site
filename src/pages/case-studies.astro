---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';
import Analytics from '../components/Analytics.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import LazyImage from '../components/LazyImage.astro';
import StatBox from '../components/StatBox.astro';
import SpeakableSchema from '../components/SpeakableSchema.astro';

// Speakable sections for voice search
const speakableSections = [
  { cssSelector: ".case-study h3, .case-study .results" },
  { cssSelector: ".stat-box" }
];

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Security Success Stories & Case Studies",
  "description": "Real-world case studies of mobile surveillance trailers on construction, port, housing, and solar projects in the Puget Sound area: the challenge, the setup, and how each deployment went.",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "Case",
          "name": "Tacoma Mall Redevelopment",
          "description": "Commercial construction protected by 3 surveillance trailers over 18 months"
        }
      },
      {
        "@type": "ListItem",
        "position": 2,
        "item": {
          "@type": "Case",
          "name": "Port of Tacoma Expansion",
          "description": "Marine construction protected by 5 surveillance trailers over 24 months"
        }
      },
      {
        "@type": "ListItem",
        "position": 3,
        "item": {
          "@type": "Case",
          "name": "Seattle Housing Development",
          "description": "Residential construction where 2 surveillance trailers replaced security guards over 14 months"
        }
      },
      {
        "@type": "ListItem",
        "position": 4,
        "item": {
          "@type": "Case",
          "name": "Puyallup Solar Farm",
          "description": "Off-grid solar farm build protected by 3 solar-powered trailers over 8 months"
        }
      }
    ]
  }
});

// Breadcrumb data
const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Case Studies" }
];
---

<Layout
  title="Security Case Studies | Real Success Stories | CCTV Trailer"
  description="See how Puget Sound construction, port, housing, and solar projects used mobile surveillance trailers. Each case study covers the challenge, the setup, and how the deployment went."
  schema={schema}>

  <BreadcrumbSchema items={breadcrumbItems} />
  <SpeakableSchema sections={speakableSections} />

  <Header showEmergencyBar={true} currentPath="/case-studies" />
  <Analytics />

  <main>
    <!-- Hero Section -->
    <section class="hero-trailer">
      <div class="hero-overlay">
        <LazyImage src="/images/tacoma-dome-bg-hero4.webp" alt="Security success stories and case studies"
          class="w-full h-full object-cover" width="1920" height="1080" fetchPriority="high" loading="eager" />
      </div>
      <div class="hero-content">
        <div class="hero-text-wrapper">
          <h1 class="hero-heading">Proven Security Success Stories</h1>
          <p class="hero-paragraph">
            Real-world case studies of mobile surveillance on <strong>Puget Sound projects</strong>
          </p>
          <div class="hero-buttons">
            <a href="/roi-calculator" class="bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-8 rounded-lg inline-block">
              Calculate Your ROI
            </a>
            <a href="tel:2536832288" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-lg inline-block">
              📞 Get Started
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Summary Statistics -->
    <section class="py-12 bg-white">
      <div class="container mx-auto px-4">
        <StatBox
          title="What Every Deployment Includes"
          description="The same core setup behind each project below"
          layout="grid"
          stats={[
            {
              value: "24/7",
              label: "Self-Monitoring & Alerts",
              icon: "📱",
              highlight: true
            },
            {
              value: "4",
              label: "Cameras per Trailer",
              icon: "📷",
              highlight: true
            },
            {
              value: "24/7",
              label: "Technical Support",
              icon: "🛡️",
              highlight: false
            },
            {
              value: "20-30 min",
              label: "Setup per Trailer",
              icon: "⏱️",
              highlight: true
            }
          ]}
        />
      </div>
    </section>

    <!-- Case Studies -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-3xl font-bold text-center mb-12">Detailed Case Studies</h2>

          <!-- Case Study 1: Commercial Construction -->
          <div class="case-study bg-white rounded-lg shadow-lg mb-12 overflow-hidden">
