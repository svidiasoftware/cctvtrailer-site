---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RelatedPages from '../components/RelatedPages.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import StatBox from '../components/StatBox.astro';
import LazyImage from '../components/LazyImage.astro';
import Analytics from '../components/Analytics.astro';

// Schema data for the construction security service
const serviceSchemaData = {
  serviceName: "Bremerton Security Camera Rental",
  description: "Security camera trailer rental in Bremerton, WA, focused on naval base contractors and shipyard security, with coverage for waterfront properties. Serving Kitsap County.",
  areaServed: [
    { type: "City" as const, name: "Bremerton" },
  ]
};

// Breadcrumb data
const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Locations", url: "/about" },
  { name: "Bremerton Security" }
];

// Crime statistics data
const crimeStats = [
  { value: "88.2", label: "Crimes per 1,000 Residents", highlight: true },
  { value: "138.8%", label: "Above National Property Crime", highlight: true },
  { value: "32%", label: "Increase in Assaults 2024" },
  { value: "34%", label: "Decrease in Vehicle Theft 2024" }
];

const relatedPages = [
  {
    title: "Construction Site Security Solutions",
    href: "/construction-security",
    description: "Mobile surveillance for Bremerton naval facility construction and shipyard projects."
  },
  {
    title: "Event Security Trailer Rentals",
    href: "/event-security",
    description: "Security solutions for Bremerton waterfront events and military ceremonies."
  },
  {
    title: "Seattle Surveillance Rental",
    href: "/seattle-surveillance-rental",
    description: "Security services for Seattle - accessible via ferry from Bremerton."
  },
  {
    title: "Tacoma Security Trailer Services",
    href: "/tacoma-security-trailer",
    description: "Our Pierce County headquarters serving Kitsap County and Bremerton."
  },
  {
    title: "Technical Specifications",
    href: "/technical-specifications",
    description: "Military-grade mobile security trailers serving naval base contractors."
  },
  {
    title: "Rental Options & Quotes",
    href: "/pricing",
    description: "Rental options for Bremerton and Kitsap County sites - call (253) 683-2288 or request a quote."
  }
];
---

<Layout 
  title="Bremerton Security Trailer Rental | Naval Base & Shipyard Surveillance"
  description="Mobile security trailer rentals in Bremerton, Silverdale and Port Orchard for naval shipyard contractors and waterfront surveillance. (253) 683-2288">
  
    <!-- Structured Data Schemas -->
  <ServiceSchema {...serviceSchemaData} />
  <BreadcrumbSchema items={breadcrumbItems} />

  <Header showEmergencyBar={true} currentPath="/bremerton-naval-security" />
  <Analytics />

  <main>
    <!-- Hero Section -->
    <section class="relative text-white py-16 overflow-hidden">
      <div class="absolute inset-0">
        <LazyImage
          src="/images/cities/bremerton-hero.webp"
          alt="Mobile CCTV surveillance trailer parked at the chain-link perimeter of a Bremerton waterfront commercial site with Puget Sound and a gray naval-style vessel silhouetted in the distance at dusk"
          class="w-full h-full object-cover"
          width="1920"
          height="1080"
          loading="eager"
          fetchPriority="high"
        />
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-blue-950/85 to-blue-950/55"></div>
      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl">
          <h1 class="text-4xl md:text-5xl font-bold mb-4">Bremerton Naval Base & Shipyard Security</h1>
          <p class="text-xl mb-6"><strong>Military-grade mobile surveillance</strong> for <strong>Bremerton's naval contractors</strong> and shipyard facilities, plus the waterfront businesses around them. Defense contractors throughout Kitsap County rely on our trailers.</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="tel:2536832288" class="bg-white text-blue-900 hover:bg-gray-100 font-bold py-3 px-8 rounded-lg inline-block text-center">
              📞 Call: (253) 683-2288
            </a>
            <a href="#bremerton-quote" class="bg-red-500 hover:bg-red-600 text-white font-bold py-3 px-8 rounded-lg inline-block text-center">
              Get Bremerton Quote >
            </a>
          </div>
          <p class="mt-4">⚡ Rapid deployment to naval base gates and shipyard facilities</p>
        </div>
      </div>
    </section>

    <!-- Crime Statistics Section -->
    <section class="bg-red-50 py-12">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold mb-6 text-center text-red-900">Bremerton Crime Statistics</h2>
          <StatBox stats={crimeStats} layout="grid" />
          <div class="mt-8 bg-white rounded-lg p-6 border-l-4 border-red-600">
            <p class="text-gray-700 font-semibold">
              Property crime is a serious problem in Bremerton, particularly around the naval base and waterfront. Vehicle theft dropped in 2024, but assaults rose, so contractors and businesses here need full camera coverage of their sites.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Service Areas -->
    <section class="py-16">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold mb-8">Bremerton & Kitsap Coverage Areas</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-white border rounded-lg p-6">
            <h3 class="font-bold text-lg mb-3">Bremerton Districts</h3>
            <ul class="text-gray-600 space-y-1">
              <li>• Downtown Bremerton</li>
              <li>• Charleston</li>
              <li>• Manette</li>
              <li>• East Bremerton</li>
              <li>• West Bremerton</li>
              <li>• Navy Yard City</li>
              <li>• Rocky Point</li>
            </ul>
          </div>
          <div class="bg-white border rounded-lg p-6">
            <h3 class="font-bold text-lg mb-3">Naval & Maritime</h3>
            <ul class="text-gray-600 space-y-1">
              <li>• Puget Sound Naval Shipyard</li>
              <li>• Naval Base Kitsap gates</li>
              <li>• Sinclair Inlet waterfront</li>
              <li>• Port Washington Narrows</li>
              <li>• Bremerton Marina</li>
              <li>• Port of Bremerton</li>
              <li>• Ferry terminal area</li>
            </ul>
          </div>
          <div class="bg-white border rounded-lg p-6">
            <h3 class="font-bold text-lg mb-3">Nearby Coverage</h3>
            <ul class="text-gray-600 space-y-1">
              <li>• Silverdale</li>
              <li>• Port Orchard</li>
              <li>• Gorst</li>
              <li>• Naval Base Kitsap-Bangor</li>
              <li>• Keyport</li>
              <li>• Poulsbo</li>
              <li>• Bainbridge Island (ferry)</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Naval & Shipyard Focus -->
    <section class="bg-blue-50 py-16">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold mb-8">Naval Shipyard & Defense Contractor Security</h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div>
            <h3 class="font-bold text-xl mb-4">Shipyard Support Services</h3>
            <ul class="space-y-2">
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Contractor yard surveillance</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Equipment staging area security</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Materials storage protection</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Dry dock area monitoring</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Pier and wharf surveillance</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Worker parking lot security</span>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold text-xl mb-4">Defense Contractor Security</h3>
            <ul class="space-y-2">
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Classified material areas</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>ITAR compliance support</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Secure facility perimeters</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>24/7 tamper-proof recording</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Chain of custody documentation</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Incident response recording</span>
              </li>
            </ul>
          </div>
        </div>
        
        <div class="mt-12 bg-white rounded-lg p-8">
          <h3 class="font-bold text-xl mb-4">Puget Sound Naval Shipyard Expertise</h3>
          <p class="text-gray-700 mb-4">
            CCTV Trailer has worked extensively with naval contractors and shipyard support facilities. Defense-related operations have strict security requirements, and our systems meet them with encrypted recording and tamper-proof hardware that military contractors throughout the Puget Sound region already rely on.
          </p>
          <div class="grid md:grid-cols-3 gap-4 text-center">
            <div>
              <div class="text-2xl font-bold text-blue-600">75+</div>
              <div class="text-sm">Naval Contractors Served</div>
            </div>
            <div>
              <div class="text-2xl font-bold text-blue-600">10+ Years</div>
              <div class="text-sm">Shipyard Area Experience</div>
            </div>
            <div>
              <div class="text-2xl font-bold text-blue-600">ITAR</div>
              <div class="text-sm">Compliant Systems</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Waterfront & Marina Security -->
    <section class="py-16">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold mb-8">Waterfront & Marina Security Solutions</h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div>
            <h3 class="font-bold text-xl mb-4">Marina & Port Protection</h3>
            <p class="text-gray-700 mb-4">
              Security for Bremerton's marinas, port operations and other waterfront facilities. Cameras keep watch over moored vessels and dockside equipment.
            </p>
            <ul class="space-y-2">
              <li>• Boat slip monitoring</li>
              <li>• Fuel dock surveillance</li>
              <li>• Marina parking security</li>
              <li>• Yacht club protection</li>
              <li>• Commercial vessel monitoring</li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold text-xl mb-4">Ferry Terminal & Transit</h3>
            <p class="text-gray-700 mb-4">
              Surveillance for Bremerton's ferry terminal and transit facilities, from passenger areas and terminal operations to overnight parking.
            </p>
            <ul class="space-y-2">
              <li>• Terminal area surveillance</li>
              <li>• Park & ride security</li>
              <li>• Loading zone monitoring</li>
              <li>• Overnight parking protection</li>
              <li>• Transit center coverage</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Downtown & Commercial -->
    <section class="bg-gray-50 py-16">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold mb-8">Downtown Bremerton Business Security</h2>
        <div class="bg-white rounded-lg p-8">
          <div class="grid md:grid-cols-2 gap-8">
            <div>
              <h3 class="font-bold text-xl mb-4">Downtown Revitalization Support</h3>
              <p class="text-gray-700 mb-4">
                Downtown Bremerton is being revitalized, and we provide security for its businesses and construction projects, along with special events.
              </p>
              <ul class="space-y-2">
                <li>• Harborside development security</li>
                <li>• Restaurant & retail protection</li>
                <li>• Construction site monitoring</li>
                <li>• Special event surveillance</li>
              </ul>
            </div>
            <div>
              <h3 class="font-bold text-xl mb-4">Healthcare & Education</h3>
              <p class="text-gray-700 mb-4">
                Mobile surveillance for Bremerton's healthcare facilities and school campuses.
              </p>
              <ul class="space-y-2">
                <li>• Harrison Medical Center area</li>
                <li>• Olympic College campus</li>
                <li>• Medical office buildings</li>
                <li>• School construction projects</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Choose Us -->
    <section class="py-16">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold mb-8 text-center">Why Bremerton Chooses CCTV Trailer</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="text-4xl mb-4">⚓</div>
            <h3 class="font-bold text-xl mb-2">Naval Experience</h3>
            <p class="text-gray-600">We know naval base and shipyard security requirements and have supported contractors working under them.</p>
          </div>
          <div class="text-center">
            <div class="text-4xl mb-4">🌊</div>
            <h3 class="font-bold text-xl mb-2">Waterfront Expertise</h3>
            <p class="text-gray-600">Weather-resistant equipment suited to maritime and waterfront sites.</p>
          </div>
          <div class="text-center">
            <div class="text-4xl mb-4">🚢</div>
            <h3 class="font-bold text-xl mb-2">Ferry Service</h3>
            <p class="text-gray-600">Quick deployment via ferry routes with flexible scheduling for Kitsap County projects.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Quote Form -->
    <section id="bremerton-quote" class="py-16 bg-white">
      <div class="container mx-auto px-4 max-w-2xl">
        <h2 class="text-3xl font-bold text-center mb-8">Get Your Bremerton Security Quote</h2>
        <form id="bremerton-quote-form" class="bg-gray-50 rounded-lg p-8 shadow-lg">
          <div class="grid gap-6">
            <div>
              <label for="bremerton-name" class="block mb-2 font-semibold">Name *</label>
              <input type="text" id="bremerton-name" name="name" required class="w-full px-4 py-2 border rounded-lg">
            </div>
            <div>
              <label for="bremerton-phone" class="block mb-2 font-semibold">Phone *</label>
              <input type="tel" id="bremerton-phone" name="phone" required class="w-full px-4 py-2 border rounded-lg">
            </div>
            <div>
              <label for="bremerton-type" class="block mb-2 font-semibold">Facility Type *</label>
              <select id="bremerton-type" name="type" required class="w-full px-4 py-2 border rounded-lg">
                <option value="">Select type...</option>
                <option value="naval-contractor">Naval/Defense Contractor</option>
                <option value="shipyard">Shipyard Support</option>
                <option value="marina">Marina/Waterfront</option>
                <option value="downtown">Downtown Business</option>
                <option value="construction">Construction Site</option>
                <option value="healthcare">Healthcare Facility</option>
                <option value="retail">Retail/Commercial</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div>
              <label for="bremerton-clearance" class="block mb-2 font-semibold">Security Clearance Required?</label>
              <select id="bremerton-clearance" name="clearance" class="w-full px-4 py-2 border rounded-lg">
                <option value="no">No</option>
                <option value="yes">Yes - Specify in details</option>
              </select>
            </div>
            <div>
              <label for="bremerton-details" class="block mb-2 font-semibold">Security Requirements</label>
              <textarea id="bremerton-details" name="details" rows="3" class="w-full px-4 py-2 border rounded-lg" placeholder="Describe your security needs, including any special requirements..."></textarea>
            </div>
          </div>
          <div class="mt-8 text-center">
            <button type="submit" class="bg-blue-900 hover:bg-blue-950 text-white font-bold py-3 px-12 rounded-lg text-lg">
              Get Bremerton Quote >
            </button>
            <p class="mt-4 text-sm text-gray-600">Serving naval contractors across Kitsap County - call (253) 683-2288 for a quote</p>
          </div>
        </form>
      </div>
    </section>
  </main>

  <RelatedPages
    title="Related Security Services & Nearby Areas"
    pages={relatedPages}
  />

  <Footer />
</Layout>
