---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';
import Analytics from '../components/Analytics.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import LazyImage from '../components/LazyImage.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import StatBox from '../components/StatBox.astro';
import SpeakableSchema from '../components/SpeakableSchema.astro';
import RentVsBuy from '../components/RentVsBuy.astro';


// Speakable sections for voice search
const speakableSections = [
  { cssSelector: ".quick-answer-content" },
  { cssSelector: "#rental-terms h2, #rental-terms p" },
  { cssSelector: "#whats-included h2, #whats-included ul" },
  { cssSelector: ".comparison-table" },
  { cssSelector: "#rental-faq h2, #rental-faq div" }
];

const schemas = [
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Mobile Surveillance Trailer Rental",
    "serviceType": "Security trailer rental",
    "description": "Daily, weekly, and monthly mobile surveillance trailer rentals with 24/7 self-monitoring. Each trailer carries 4 cameras (1 fixed fisheye + 3 PTZ with 25x optical zoom and IR), solar power/generator, equipment training, 24/7 technical support, and remote viewing on your mobile devices or computer. Professional delivery and setup available. Pricing is quoted per project.",
    "image": [
      "https://www.cctvtrailer.com/images/trailer-1x1.png",
      "https://www.cctvtrailer.com/images/trailer-4x3.png",
      "https://www.cctvtrailer.com/images/trailer-16x9.png"
    ],
    "provider": {
      "@type": "LocalBusiness",
      "name": "CCTV Trailer",
      "telephone": "(253) 683-2288",
      "email": "info@cctvtrailer.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Tacoma",
        "streetAddress": "222 E 26th St",
        "postalCode": "98421",
        "addressRegion": "WA",
        "addressCountry": "US"
      }
    },
    "areaServed": [
      {
        "@type": "GeoCircle",
        "geoMidpoint": {
          "@type": "GeoCoordinates",
          "latitude": 47.2529,
          "longitude": -122.4443
        },
        "geoRadius": "30 miles"
      }
    ]
  }),
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How much does it cost to rent a security trailer?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pricing depends on rental length, number of trailers, site location, and configuration, so we quote each project individually. Call (253) 683-2288 or request a quote online."
        }
      },
      {
        "@type": "Question",
        "name": "What is included with a rental?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Every rental includes 4 cameras (1 fixed fisheye + 3 PTZ with 25x optical zoom and IR), equipment training, 24/7 technical support, solar power/generator, and remote viewing access on your mobile devices or computer. Professional delivery and setup are available."
        }
      },
      {
        "@type": "Question",
        "name": "Who monitors the cameras?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Our trailers are 24/7 self-monitored: you watch live video, review recorded footage, and receive real-time motion alerts on your phone or computer. We train your team on the system and provide 24/7 technical support."
        }
      },
      {
        "@type": "Question",
        "name": "Is there a minimum rental period?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The minimum rental period is 1 day (24 hours). Daily, weekly, and monthly rentals are available, and longer terms are quoted at better rates."
        }
      },
      {
        "@type": "Question",
        "name": "How fast can you deploy a trailer?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Same-day delivery is available, and setup takes 20-30 minutes. Call (253) 683-2288 to check availability."
        }
      }
    ]
  })
];

// Breadcrumb data
const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Rental Options" }
];
---

<Layout
  title="Security Trailer Rental Options & Quotes | CCTV Trailer Tacoma"
  description="Daily, weekly & monthly security trailer rentals in Tacoma & Seattle. 4 cameras, solar power, 24/7 self-monitoring from your phone. Call (253) 683-2288 for a quote."
  schema={schemas}>

  <BreadcrumbSchema items={breadcrumbItems} />
  <SpeakableSchema sections={speakableSections} />

  <Header showEmergencyBar={true} currentPath="/pricing" />
  <Analytics /> 

  <main>
    <!-- Hero Section -->
    <section class="hero-trailer">
      <div class="hero-overlay">
        <LazyImage src="/images/tacoma-dome-bg-hero4.webp" alt="Mobile surveillance trailer with Tacoma Dome in background - Security trailer rental options" 
          class="w-full h-full object-cover" width="1920" height="1080" fetchPriority="high" loading="eager" />
      </div>
      <div class="hero-content">
        <div class="hero-text-wrapper">
          <h1 class="hero-heading"><strong>Rental Options &amp; Quotes</strong></h1>
          <p class="hero-paragraph">
            <strong>Daily, weekly, and monthly</strong> mobile surveillance trailer rentals, <strong>quoted for your site</strong>
          </p>
          <div class="hero-buttons">
            <a href="tel:2536832288" class="bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-8 rounded-lg inline-block">
              📞 Call for a Quote
            </a>
            <a href="/contact" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-lg inline-block">
              Request a Quote Online
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Answer Box -->
    <section class="py-8 bg-gray-50">
      <div class="container mx-auto px-4">
        <QuickAnswer
          what="Mobile surveillance trailer rentals with 24/7 self-monitoring"
          time="20-30 minute setup, same-day delivery"
          coverage="Tacoma, Seattle, Olympia, Federal Way, entire Puget Sound"
          availability="Call to inquire"
          includes={[
            "4 cameras (1 fixed fisheye + 3 PTZ 25x zoom with IR)",
            "Equipment training",
            "24/7 technical support",
            "Solar power/generator included",
            "Remote viewing access on your mobile devices or computer"
          ]}
          customFields={[
            { label: "Flexible Terms", value: "Daily, weekly, monthly options" },
            { label: "Delivery & Setup", value: "Professional delivery and setup available" }
          ]}
        />
      </div>
    </section>

    <!-- Value Proposition Statistics -->
    <section class="py-12 bg-white">
      <div class="container mx-auto px-4">
        <StatBox
          title="What Every Rental Gets You"
          description="One trailer, ready to protect your site"
          layout="grid"
          stats={[
            {
              value: "4",
              label: "Cameras per Trailer",
              icon: "📹",
              highlight: true
            },
            {
              value: "20-30 min",
              label: "Setup Time",
              icon: "⏱️",
              highlight: true
            },
            {
              value: "24/7",
              label: "Self-Monitoring",
              icon: "📱",
              highlight: false
            },
            {
              value: "24/7",
              label: "Technical Support",
              icon: "🛠️",
              highlight: true
            }
          ]}
        />
      </div>
    </section>

    <!-- Rental Terms Section -->
    <section id="rental-terms" class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="bg-white border-2 border-blue-600 rounded-lg shadow-2xl p-8 mb-12 text-center">
            <h2 class="text-3xl font-bold mb-2">Get a Quote for Your Site</h2>
            <p class="text-gray-600 mb-6"><strong>Pricing depends on rental length, number of trailers, site location, and configuration</strong> &mdash; tell us about your project and we'll quote it.</p>
            <a href="tel:2536832288" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-12 rounded-lg inline-block text-lg shadow-lg transition-all hover:shadow-xl">
              📞 Call (253) 683-2288
            </a>
            <p class="text-sm text-gray-500 mt-3">Same-day delivery &mdash; call to check availability</p>
          </div>

          <!-- Rental Terms Grid -->
          <div class="mb-12">
            <h2 class="text-2xl font-bold text-center mb-8">Flexible Rental Terms</h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
              <div class="bg-gradient-to-br from-green-50 to-white rounded-lg p-6 border border-green-200 hover:shadow-lg transition-shadow">
                <div class="text-center mb-4">
                  <span class="text-4xl">🗓️</span>
                </div>
                <h3 class="font-semibold text-lg mb-2 text-center">Daily Rentals</h3>
                <p class="text-gray-600 text-center mb-3">1+ days</p>
                <div class="text-center">
                  <span class="inline-block bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-semibold">
                    Short-term
                  </span>
                </div>
                <p class="text-sm text-gray-500 text-center mt-3">Events, emergencies, and short projects</p>
              </div>

              <div class="bg-gradient-to-br from-purple-50 to-white rounded-lg p-6 border border-purple-200 hover:shadow-lg transition-shadow">
                <div class="text-center mb-4">
                  <span class="text-4xl">📅</span>
                </div>
                <h3 class="font-semibold text-lg mb-2 text-center">Weekly Rentals</h3>
                <p class="text-gray-600 text-center mb-3">7+ days</p>
                <div class="text-center">
                  <span class="inline-block bg-purple-100 text-purple-800 px-3 py-1 rounded-full text-sm font-semibold">
                    Better rates
                  </span>
                </div>
                <p class="text-sm text-gray-500 text-center mt-3">Phased work and multi-day events</p>
              </div>

              <div class="bg-gradient-to-br from-blue-50 to-white rounded-lg p-6 border border-blue-200 hover:shadow-lg transition-shadow">
                <div class="text-center mb-4">
                  <span class="text-4xl">📆</span>
                </div>
                <h3 class="font-semibold text-lg mb-2 text-center">Monthly Rentals</h3>
                <p class="text-gray-600 text-center mb-3">30+ days</p>
                <div class="text-center">
                  <span class="inline-block bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-semibold">
                    Best rates
                  </span>
                </div>
                <p class="text-sm text-gray-500 text-center mt-3">Construction projects and long-term sites</p>
              </div>

              <div class="bg-gradient-to-br from-green-50 to-white rounded-lg p-6 border border-green-200 hover:shadow-lg transition-shadow">
                <div class="text-center mb-4">
                  <span class="text-4xl">📦📦📦</span>
                </div>
                <h3 class="font-semibold text-lg mb-2 text-center">Multiple Units</h3>
                <p class="text-gray-600 text-center mb-3">2+ trailers</p>
                <div class="text-center">
                  <span class="inline-block bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-semibold">
                    Custom quote
                  </span>
                </div>
                <p class="text-sm text-gray-500 text-center mt-3">Large sites and multi-location projects</p>
              </div>
            </div>
          </div>

          <!-- What's Included Section -->
          <div id="whats-included" class="bg-gray-50 rounded-lg p-8 mb-12">
            <h2 class="text-2xl font-bold mb-6 text-center"><strong>What's Included</strong></h2>
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <h3 class="font-semibold mb-3 text-blue-600">Included With Every Rental</h3>
                <ul class="space-y-2">
                  <li class="flex items-start">
                    <span class="text-green-600 mr-2 mt-1">✓</span>
                    <span class="text-gray-700">4 cameras (1 fixed fisheye + 3 PTZ 25x zoom with IR)</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-green-600 mr-2 mt-1">✓</span>
                    <span class="text-gray-700">Equipment training</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-green-600 mr-2 mt-1">✓</span>
                    <span class="text-gray-700">24/7 technical support</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-green-600 mr-2 mt-1">✓</span>
                    <span class="text-gray-700">Solar power/generator included</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-green-600 mr-2 mt-1">✓</span>
                    <span class="text-gray-700">Remote viewing access on your mobile devices or computer</span>
                  </li>
                </ul>
              </div>

              <div>
                <h3 class="font-semibold mb-3 text-blue-600">Built In</h3>
                <ul class="space-y-2">
                  <li class="flex items-start">
                    <span class="text-green-600 mr-2 mt-1">✓</span>
                    <span class="text-gray-700">24/7 self-monitoring with real-time alerts</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-green-600 mr-2 mt-1">✓</span>
                    <span class="text-gray-700">S-VIDIA video system</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-green-600 mr-2 mt-1">✓</span>
                    <span class="text-gray-700"><a href="/how-to-setup-security-trailer" class="text-blue-600 hover:text-blue-800 hover:underline">Quick setup (minutes)</a>, no installation required</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-green-600 mr-2 mt-1">✓</span>
                    <span class="text-gray-700">Weather-resistant, built for the Pacific Northwest</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-green-600 mr-2 mt-1">✓</span>
                    <span class="text-gray-700">360° coverage</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Service Area -->
          <div class="bg-blue-50 rounded-lg p-6 text-center">
            <h3 class="font-semibold text-lg mb-2">Service Area &amp; Delivery</h3>
            <p class="text-gray-700 mb-2">
              <strong>Professional delivery and setup available</strong> throughout the Puget Sound
            </p>
            <p class="text-gray-600 text-sm">
              Tacoma, Seattle, Olympia, Federal Way, Kent, Auburn, and surrounding areas &mdash; delivery is quoted based on your site location
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Comparison Table -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <ComparisonTable
          title="Security Options Compared"
          description="See how mobile surveillance trailers compare to other security solutions"
          headers={["Mobile Trailers", "Security Guards", "Fixed Cameras"]}
          rows={[
            {
              feature: "Setup Time",
              values: [
                { text: "20-30 minutes", highlight: true },
                "Immediate",
                "2-5 days"
              ]
            },
            {
              feature: "24/7 Coverage",
              values: [
                { text: "Yes, always", highlight: true },
                "Shifts/breaks",
                "Yes"
              ]
            },
            {
              feature: "Video Evidence",
              values: [
                { text: "HD recorded", highlight: true },
                "No",
                "HD recorded"
              ]
            },
            {
              feature: "Relocatable",
              values: [
                { text: "Yes, easily", highlight: true },
                "Yes",
                "No"
              ]
            },
            {
              feature: "Weather Impact",
              values: [
                { text: "None", highlight: true },
                "Reduced coverage",
                "None"
              ]
            },
            {
              feature: "Deterrent Effect",
              values: [
                { text: "Very high", highlight: true },
                "High",
                "Medium"
              ]
            },
            {
              feature: "Maintenance",
              values: [
                { text: "Included", highlight: true },
                "N/A",
                "Your responsibility"
              ]
            },
            {
              feature: "Contract Required",
              values: [
                { text: "No", highlight: true },
                "Usually",
                "Yes"
              ]
            }
          ]}
        />
      </div>
    </section>

    <!-- Cost Calculator CTA Section -->
    <section class="py-16 bg-gradient-to-r from-blue-600 to-blue-700">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center text-white">
          <div class="text-5xl mb-4">🧮</div>
          <h2 class="text-3xl font-bold mb-4">Compare Your Quote Against Guards</h2>
          <p class="text-xl mb-8">
            Once you have a quote, plug it into our calculator to compare mobile surveillance against traditional security guards
            and estimate your ROI.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center flex-wrap">
            <a href="/security-cost-calculator" class="bg-white text-blue-600 hover:bg-gray-100 font-bold py-4 px-8 rounded-lg inline-block text-lg shadow-lg transition-all hover:shadow-xl">
              Try Cost Calculator →
            </a>
            <a href="/how-to-calculate-security-roi" class="bg-white text-blue-600 hover:bg-gray-100 font-bold py-4 px-8 rounded-lg inline-block text-lg shadow-lg transition-all hover:shadow-xl">
              How to Calculate Security ROI
            </a>
            <a href="/construction-site-security-guide-2025" class="bg-blue-800 text-white hover:bg-blue-900 font-bold py-4 px-8 rounded-lg inline-block text-lg border-2 border-blue-500">
              Read Security Guide
            </a>
          </div>
          <p class="text-sm mt-6 text-blue-100">
            See our <a href="/case-studies" class="text-white underline hover:text-blue-200">case studies</a> for real deployments.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="rental-faq" class="py-16 bg-gray-100">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Frequently Asked Questions</h2>
        <div class="max-w-3xl mx-auto grid gap-6">
          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="font-semibold text-lg mb-2">How much does it cost to rent a security trailer?</h3>
            <p class="text-gray-600">Pricing depends on <strong>rental length, number of trailers, site location, and configuration</strong>, so we quote each project individually. Call <a href="tel:2536832288" class="text-blue-600 hover:underline">(253) 683-2288</a> or <a href="/contact" class="text-blue-600 hover:underline">request a quote online</a>.</p>
          </div>
          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="font-semibold text-lg mb-2">What is included with a rental?</h3>
            <p class="text-gray-600">Every rental includes <strong>4 cameras (1 fixed fisheye + 3 PTZ with 25x optical zoom and IR)</strong>, equipment training, 24/7 technical support, solar power/generator, and remote viewing access on your mobile devices or computer. Professional delivery and setup are available.</p>
          </div>
          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="font-semibold text-lg mb-2">Who monitors the cameras?</h3>
            <p class="text-gray-600">Our trailers are <strong>24/7 self-monitored</strong>: you watch live video, review recorded footage, and receive real-time motion alerts on your phone or computer. We train your team on the system and provide 24/7 technical support.</p>
          </div>
          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="font-semibold text-lg mb-2">Is there a minimum rental period?</h3>
            <p class="text-gray-600">The <strong>minimum rental period is 1 day (24 hours)</strong>. Daily, weekly, and monthly rentals are available, and longer terms are quoted at better rates.</p>
          </div>
          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="font-semibold text-lg mb-2">How fast can you deploy a trailer?</h3>
            <p class="text-gray-600"><strong>Same-day delivery is available</strong>, and setup takes 20-30 minutes. Call (253) 683-2288 to check availability.</p>
          </div>
        </div>
      </div>
    </section>

    <RentVsBuy variant="banner" />

    <!-- CTA Section -->
    <CTASection
      title="Ready to Secure Your Property?"
      description="Get a custom quote tailored to your specific security needs"
      features={["✓ Same Day Delivery", "✓ 24/7 Self-Monitoring", "✓ 24/7 Support", "✓ No Contracts Required"]}
    />
  </main>

  <Footer />
</Layout>