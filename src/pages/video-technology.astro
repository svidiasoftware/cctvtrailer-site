---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import LazyImage from '../components/LazyImage.astro';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "FDC (Flexible Delta Compression) on the S-VIDIA Platform",
  "description": "FDC is S-VIDIA's proprietary video codec for security footage - up to 60% less storage than H.264/H.265, no hardware compression (no quality loss), watermarked and encrypted frames, true frame-by-frame recording. The CCTV Trailer fleet across the Puget Sound runs on FDC.",
  "author": {
    "@type": "Organization",
    "name": "CCTV Trailer"
  },
  "publisher": {
    "@type": "Organization",
    "name": "CCTV Trailer",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.cctvtrailer.com/images/cctv-trailer-logo.png",
      "width": 512,
      "height": 512
    }
  },
  "about": {
    "@type": "Thing",
    "name": "FDC (Flexible Delta Compression)",
    "description": "S-VIDIA's proprietary video codec. Records the background of a scene as a static image and the foreground as motion deltas at 8×8-pixel block granularity. No hardware compression, no resolution loss. Frames are watermarked and encrypted at write time. S-VIDIA reports up to 60% less recording space than conventional H.264/H.265 systems."
  }
});

// Breadcrumb data
const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Video Technology" }
];
---

<Layout
  title="FDC Codec & S-VIDIA Video Technology | CCTV Trailers"
  description="FDC (Flexible Delta Compression) is S-VIDIA's proprietary codec - up to 60% less storage than H.264/H.265, no hardware compression, watermarked + encrypted frames, true frame-by-frame recording. The only local company running mobile-specific surveillance software."
  schema={schema}>

  <BreadcrumbSchema items={breadcrumbItems} /> 

  <Header showEmergencyBar={true} currentPath="/video-technology" />
  <Analytics /> 

  <main>
    <!-- Hero Section with Background -->
    <div class="hero-trailer">
      <div class="hero-overlay">
        <LazyImage src="/images/tacoma-dome-bg-hero.webp" alt="FDC (Flexible Delta Compression) on the S-VIDIA platform - video technology for mobile security trailers"
          class="w-full h-full object-cover" width="1920" height="1080" fetchPriority="high" loading="eager" />
      </div>
      <div class="hero-content">
        <div class="hero-text-wrapper">
          <h1 class="hero-heading">VIDEO TECHNOLOGY</h1>
          <p class="hero-paragraph">
            CCTV Trailer is <strong>the only local surveillance trailer company</strong> running <strong>FDC (Flexible Delta Compression)</strong> - S-VIDIA's proprietary codec, built specifically for security footage.
          </p>
        </div>
      </div>
    </div>

    <!-- FDC + S-VIDIA Section -->
    <div class="section-whats-vidia">
      <div class="streaming-wrapper">
        <div class="container-image-text">
          <div class="square-image-div svidia-image-block"></div>
          <div class="column-content-container">
            <h2 class="heading-2">WHAT IS FDC?</h2>
            <p class="body-text">
              <strong>FDC (Flexible Delta Compression)</strong> is the video codec inside the S-VIDIA platform. It captures the highest picture quality possible while minimizing storage and bandwidth. Conventional video security systems use multimedia video compression such as H.264 or H.265, which reduce picture quality and accuracy to save space.
            </p>
            <p class="body-text">
              FDC works differently. It records only what is important and necessary - changes and movement. The background of a scene is stored separately as a static image; the foreground captures motion at higher quality and frequency. The result: greater control over quality, resolution, and recording sensitivity, with frames retained as separate images for <strong>true frame-by-frame recording</strong>.
            </p>
            <p class="body-text">
              Because FDC does not use hardware compression, no resolution or detail is lost before analytics or playback. Every frame is also <strong>watermarked and encrypted at write time</strong> for evidence integrity.
            </p>
          </div>
        </div>

        <div class="container-image-text reverse">
          <div class="square-image-block svidia-100"></div>
          <div class="column-content-container">
            <h2 class="heading-2">SECURE STREAMING</h2>
            <p class="body-text">
              When a user connects to an S-VIDIA server, video is automatically transported over a <strong>military-grade encrypted connection</strong>, ensuring the data is tamper-free in transit.
            </p>
            <p class="body-text">
              The platform also employs random interval changes within the decryption key, which adds an additional layer of protection against replay and key-recovery attacks.
            </p>
            <p class="body-text">
              The same block-delta property that saves disk also saves uplink bytes: a May 2026 measurement showed FDC live delivery at ~46% the kbps of direct RTSP H.264 for the same camera. See the <a href="/docs/benchmarks/05-live-bandwidth-methodology" class="text-blue-600 hover:underline">live-stream uplink methodology</a> and the <a href="/docs/benchmarks/03-remote-viewing-methodology" class="text-blue-600 hover:underline">constrained-link remote viewing methodology</a>.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Key Benefits Section -->
    <div class="py-16 bg-gray-50">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="text-3xl font-bold text-center mb-8 text-gray-900">Key Advantages of FDC</h2>
        <ul class="space-y-4 bg-white border-2 border-blue-200 rounded-lg p-8">
          <li class="flex items-start">
            <span class="text-blue-600 font-bold mr-3 mt-1">✓</span>
            <div>
              <strong class="text-gray-900">Superior storage efficiency:</strong>
              <span class="text-gray-700"> Up to 60% less recording space than conventional H.264/H.265 systems (S-VIDIA published figure). First-party measurement on a Puget Sound clip showed FDC at 54% the size of x264 CRF&nbsp;23 and 79% of x265 CRF&nbsp;28 - see the <a href="/docs/benchmarks/01-fdc-ab-methodology" class="text-blue-600 hover:underline">codec A/B methodology</a> and the <a href="/docs/benchmarks/02-fleet-telemetry-methodology" class="text-blue-600 hover:underline">fleet telemetry methodology</a>.</span>
            </div>
          </li>
          <li class="flex items-start">
            <span class="text-blue-600 font-bold mr-3 mt-1">✓</span>
            <div>
              <strong class="text-gray-900">No quality loss:</strong>
              <span class="text-gray-700"> FDC does not use hardware compression. The exact image the camera produced is what gets stored, analyzed, and played back.</span>
            </div>
          </li>
          <li class="flex items-start">
            <span class="text-blue-600 font-bold mr-3 mt-1">✓</span>
            <div>
              <strong class="text-gray-900">True frame-by-frame recording:</strong>
              <span class="text-gray-700"> Frames are retained as separate images, so incident review jumps directly to any frame with no GOP-dependent decoding tax.</span>
            </div>
          </li>
          <li class="flex items-start">
            <span class="text-blue-600 font-bold mr-3 mt-1">✓</span>
            <div>
              <strong class="text-gray-900">Evidence integrity:</strong>
              <span class="text-gray-700"> Every frame is watermarked and encrypted at write time - courtroom-ready audit trail.</span>
            </div>
          </li>
          <li class="flex items-start">
            <span class="text-blue-600 font-bold mr-3 mt-1">✓</span>
            <div>
              <strong class="text-gray-900">Motion-prioritized recording:</strong>
              <span class="text-gray-700"> Background stored as a static image; foreground captures movement at higher quality and frequency.</span>
            </div>
          </li>
          <li class="flex items-start">
            <span class="text-blue-600 font-bold mr-3 mt-1">✓</span>
            <div>
              <strong class="text-gray-900">Instantaneous evidence retrieval:</strong>
              <span class="text-gray-700"> Automated movement search jumps directly to motion frames - no scrubbing through static footage.</span>
            </div>
          </li>
          <li class="flex items-start">
            <span class="text-blue-600 font-bold mr-3 mt-1">✓</span>
            <div>
              <strong class="text-gray-900">Military-grade transit security:</strong>
              <span class="text-gray-700"> End-to-end encrypted connection with dynamic key rotation.</span>
            </div>
          </li>
          <li class="flex items-start">
            <span class="text-blue-600 font-bold mr-3 mt-1">✓</span>
            <div>
              <strong class="text-gray-900">4K resolution recording:</strong>
              <span class="text-gray-700"> Maintains high-definition quality without excessive storage demands.</span>
            </div>
          </li>
          <li class="flex items-start">
            <span class="text-blue-600 font-bold mr-3 mt-1">✓</span>
            <div>
              <strong class="text-gray-900">Camera compatibility:</strong>
              <span class="text-gray-700"> Analog, HD IP, and Ultra HD IP cameras - same codec, same archive format.</span>
            </div>
          </li>
          <li class="flex items-start">
            <span class="text-blue-600 font-bold mr-3 mt-1">✓</span>
            <div>
              <strong class="text-gray-900">Noise isolation:</strong>
              <span class="text-gray-700"> Built-in noise isolation process automatically filters irrelevant pixel motion to reduce file sizes further.</span>
            </div>
          </li>
        </ul>
        <p class="text-center text-sm text-gray-600 mt-6 max-w-2xl mx-auto">
          For the full mobile trailer technical spec - including Vigil AI alert triage and the platform's MCP integration - 
          see <a href="/technical-specifications" class="text-blue-600 hover:underline font-medium">Technical Specifications</a>.
        </p>
      </div>
    </div>

    <!-- Three Features Section -->
    <div class="section-three-divs">
      <div class="streaming-wrapper">
        <div class="features-container">
          <div class="feature-item">
            <div class="features-image compression"></div>
            <div class="features-content">
              <h3 class="heading-3">FLEXIBLE DELTA COMPRESSION</h3>
              <p class="body-black">
                FDC analyzes video data <em>before</em> committing to disk - eliminating idle footage, prioritizing captured movement, and storing frames as separate images for frame-by-frame review.
              </p>
            </div>
          </div>

          <div class="feature-item">
            <div class="features-image noise"></div>
            <div class="features-content">
              <h3 class="heading-3">NOISE ISOLATION PROCESS</h3>
              <p class="body-black">
                FDC's built-in noise isolation process (NIP) automatically isolates and removes irrelevant video pixel motion, reducing file size by approximately 50% on top of FDC's baseline storage advantage.
              </p>
            </div>
          </div>

          <div class="feature-item">
            <div class="features-image internal"></div>
            <div class="features-content">
              <h3 class="heading-3">INTERNAL FILE STORAGE</h3>
              <p class="body-black">
                S-VIDIA monitoring software allows each high-definition camera to record in 4K resolution without taking up hours of storage space. Supports analog, HD IP, and Ultra HD IP cameras - one codec, one archive format.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Video Technology Section -->
    <div class="section-videotec-svidia">
      <div class="svidia-wrapper-dark">
        <div class="content-container-copy">
          <h2 class="heading-2 white center">THE VIDEO TECHNOLOGY</h2>
          <p class="body-white centered">
            The next-generation S-VIDIA security platform is built around FDC - an unparalleled video compression method engineered to outperform H.264 and H.265 on storage, image quality, and evidence integrity.
          </p>
          <a href="https://svidia.com/" target="_blank" rel="noopener noreferrer" class="red-button">
            Learn More
          </a>
        </div>
      </div>
    </div>

    <!-- Contact Section -->
    <div class="section-wrapper-contact">
      <div class="content-container-contact">
        <div class="content-wrapper-contact">
          <div class="left-side-contact">
            <h2 class="heading-1 space">
              contact us today
            </h2>
            <p class="body-black-copy">
              Ready to sleep better knowing your remote property and assets are safe and sound? Our knowledgeable team is ready to discuss your mobile security trailer needs.
            </p>
            <a href="/contact" class="clear-outline-button">CONTACT US</a>
          </div>
          <div class="contact-image"></div>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <style>
    
  </style>
</Layout>