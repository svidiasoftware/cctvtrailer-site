---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';
import QuoteForm from '../components/QuoteForm.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
// StatBox import removed - not used in this page

const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Services", url: "/services" },
  { name: "Same Day Security Rental" }
];

const serviceSchemaData = {
  serviceName: "Same Day Security Trailer Rental - Emergency Deployment",
  description: "Emergency same-day security trailer rental and deployment, subject to availability. 20-30 minute setup and 24/7 self-monitoring for urgent security needs in the Tacoma and Seattle area.",
  areaServed: [
    { type: "State" as const, name: "Washington" },
    { type: "City" as const, name: "Tacoma" },
    { type: "City" as const, name: "Seattle" },
    { type: "City" as const, name: "Federal Way" },
    { type: "City" as const, name: "Kent" },
    { type: "City" as const, name: "Auburn" },
    { type: "City" as const, name: "Lakewood" },
    { type: "City" as const, name: "Puyallup" }
  ]
};

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How fast can you deploy a security trailer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Same-day deployment is available within our service area, subject to availability. Call (253) 683-2288 to check availability for your site. Setup takes just 20-30 minutes once on-site."
      }
    },
    {
      "@type": "Question",
      "name": "Is same-day security rental available 24/7?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can reach our hotline 24/7, including nights, weekends, and holidays. Same-day deployment depends on trailer availability, so call (253) 683-2288 to check availability for your site."
      }
    },
    {
      "@type": "Question",
      "name": "What situations qualify for same-day security deployment?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Same-day deployment is available for: recent theft or vandalism incidents, emergency events, sudden security threats, insurance requirements, guard service failures, and any urgent security need."
      }
    }
  ]
});
---

<Layout
  title="Same Day Security Rental | Emergency Surveillance Deployment"
  description="Need security TODAY? Same-day surveillance trailer deployment for theft, vandalism, events - call to check availability. 20-30 minute setup, 24/7 self-monitoring. (253) 683-2288"
  schema={[faqSchema]}>

  <ServiceSchema {...serviceSchemaData} />
  <BreadcrumbSchema items={breadcrumbItems} />

  <Header showEmergencyBar={true} currentPath="/same-day-security-rental" />

  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-red-800 to-red-900 text-white py-16">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl">
          <div class="bg-yellow-500 text-black inline-block px-4 py-2 rounded-lg font-bold mb-4 animate-pulse">
            🚨 SAME-DAY EMERGENCY DEPLOYMENT
          </div>
          <h1 class="text-4xl md:text-5xl font-bold mb-4">Same Day Security Trailer Rental - Deployed in Hours</h1>
          <p class="text-xl mb-6">Had a theft last night, or a guard who didn't show? We can deploy security trailers the same day - call to check availability.</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="tel:2536832288" class="bg-green-600 hover:bg-green-700 text-white font-bold py-4 px-10 rounded-lg inline-block text-center text-xl">
              📞 CALL NOW: (253) 683-2288
            </a>
            <a href="#emergency-form" class="bg-white text-red-900 hover:bg-gray-100 font-bold py-3 px-8 rounded-lg inline-block text-center">
              Request Emergency Deployment >
            </a>
          </div>
          <div class="mt-6 p-4 bg-red-700 rounded-lg">
            <p class="text-yellow-300 font-bold">⚡ Same-day deployment • Call (253) 683-2288 to check availability</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Answer Section -->
    <section class="py-8 bg-gray-50">
      <div class="container mx-auto px-4">
        <QuickAnswer
          what="Emergency same-day deployment of mobile surveillance trailers with 24/7 self-monitoring"
          time="20-30 minute setup, same-day delivery"
          availability="Call to inquire: (253) 683-2288"
          coverage="Tacoma, Seattle, Federal Way, Kent, Auburn, entire Puget Sound"
          includes={[
            "4 cameras (1 fixed fisheye + 3 PTZ 25x zoom with IR)",
            "Equipment training",
            "24/7 technical support",
            "Solar power/generator included",
            "Remote viewing access on your mobile devices or computer"
          ]}
        />
      </div>
    </section>

    <!-- Emergency Response Timeline -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Emergency Deployment Timeline</h2>

        <div class="max-w-4xl mx-auto">
          <div class="relative">
            <!-- Timeline line -->
            <div class="absolute left-8 top-0 bottom-0 w-1 bg-red-300"></div>

            <!-- Timeline items -->
            <div class="space-y-8">
              <!-- Call received -->
              <div class="flex items-center">
                <div class="bg-red-600 text-white rounded-full w-16 h-16 flex items-center justify-center font-bold z-10">NOW</div>
                <div class="ml-8 bg-red-50 rounded-lg p-4 flex-1">
                  <h3 class="font-bold text-lg">You Call Our Emergency Line</h3>
                  <p class="text-gray-700">Call our 24/7 hotline. A security expert assesses your urgent needs and checks trailer availability.</p>
                </div>
              </div>

              <!-- Dispatch -->
              <div class="flex items-center">
                <div class="bg-orange-600 text-white rounded-full w-16 h-16 flex items-center justify-center font-bold z-10">NEXT</div>
                <div class="ml-8 bg-orange-50 rounded-lg p-4 flex-1">
                  <h3 class="font-bold text-lg">Trailer Dispatched</h3>
                  <p class="text-gray-700">When a trailer is available, it is loaded and our deployment team heads to your location.</p>
                </div>
              </div>

              <!-- Arrival -->
              <div class="flex items-center">
                <div class="bg-yellow-600 text-white rounded-full w-16 h-16 flex items-center justify-center font-bold z-10">TODAY</div>
                <div class="ml-8 bg-yellow-50 rounded-lg p-4 flex-1">
                  <h3 class="font-bold text-lg">On-Site Arrival</h3>
                  <p class="text-gray-700">Our deployment team arrives with a fully equipped surveillance trailer.</p>
                </div>
              </div>

              <!-- Setup -->
              <div class="flex items-center">
                <div class="bg-green-600 text-white rounded-full w-16 h-16 flex items-center justify-center font-bold z-10">30min</div>
                <div class="ml-8 bg-green-50 rounded-lg p-4 flex-1">
                  <h3 class="font-bold text-lg">Operational & Self-Monitoring</h3>
                  <p class="text-gray-700">The system goes live and starts recording, and your 24/7 self-monitoring begins right away with real-time alerts on your phone or computer.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Total time highlight -->
          <div class="mt-12 bg-green-100 border-2 border-green-300 rounded-lg p-6 text-center">
            <p class="text-3xl font-bold text-green-800">Protected the Same Day</p>
            <p class="text-gray-700 mt-2">From your call to full protection, subject to availability - faster than hiring guards or installing fixed cameras</p>
          </div>
        </div>
      </div>
    </section>

    <!-- When You Need Same Day Security -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Situations Requiring Immediate Security</h2>

        <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          <!-- After Theft/Crime -->
          <div class="bg-white rounded-lg shadow-lg p-6 border-t-4 border-red-500">
            <div class="text-3xl mb-3">🚨</div>
            <h3 class="text-xl font-bold mb-3">Just Had a Theft or Break-in</h3>
            <p class="text-gray-700 mb-4">Thieves often come back to a site they've already hit.</p>
            <ul class="text-sm space-y-2 text-gray-600">
              <li>✓ Prevent repeat attacks</li>
              <li>✓ Document for insurance</li>
              <li>✓ Restore worker confidence</li>
              <li>✓ Catch returning criminals</li>
            </ul>
            <div class="mt-4 p-3 bg-red-50 rounded">
              <p class="text-sm font-semibold text-red-800">Same-day deployment after an incident</p>
            </div>
          </div>

          <!-- Last-Minute Events -->
          <div class="bg-white rounded-lg shadow-lg p-6 border-t-4 border-orange-500">
            <div class="text-3xl mb-3">🎪</div>
            <h3 class="text-xl font-bold mb-3">Emergency Event Security</h3>
            <p class="text-gray-700 mb-4">The event is today and your security company just cancelled, or the crowd is bigger than you planned for.</p>
            <ul class="text-sm space-y-2 text-gray-600">
              <li>✓ Crowd monitoring</li>
              <li>✓ Parking lot coverage</li>
              <li>✓ Vendor area protection</li>
              <li>✓ Liability protection</li>
            </ul>
            <div class="mt-4 p-3 bg-orange-50 rounded">
              <p class="text-sm font-semibold text-orange-800">Setup before gates open</p>
            </div>
          </div>

          <!-- Guard Service Issues -->
          <div class="bg-white rounded-lg shadow-lg p-6 border-t-4 border-yellow-500">
            <div class="text-3xl mb-3">👮</div>
            <h3 class="text-xl font-bold mb-3">Guard Service Failure</h3>
            <p class="text-gray-700 mb-4">Your guards didn't show up or aren't doing the job, and you need coverage now.</p>
            <ul class="text-sm space-y-2 text-gray-600">
              <li>✓ No-show replacement</li>
              <li>✓ Better coverage than guards</li>
              <li>✓ No liability issues</li>
              <li>✓ Same-day deployment</li>
            </ul>
            <div class="mt-4 p-3 bg-yellow-50 rounded">
              <p class="text-sm font-semibold text-yellow-800">Replace guards same day</p>
            </div>
          </div>

          <!-- Insurance Requirements -->
          <div class="bg-white rounded-lg shadow-lg p-6 border-t-4 border-blue-500">
            <div class="text-3xl mb-3">📋</div>
            <h3 class="text-xl font-bold mb-3">Insurance/Compliance Deadline</h3>
            <p class="text-gray-700 mb-4">Insurance requiring security TODAY? Compliance inspection tomorrow?</p>
            <ul class="text-sm space-y-2 text-gray-600">
              <li>✓ Meet requirements instantly</li>
              <li>✓ Documentation provided</li>
              <li>✓ Pass inspections</li>
              <li>✓ Avoid penalties</li>
            </ul>
            <div class="mt-4 p-3 bg-blue-50 rounded">
              <p class="text-sm font-semibold text-blue-800">Compliance documentation ready</p>
            </div>
          </div>

          <!-- High-Value Delivery -->
          <div class="bg-white rounded-lg shadow-lg p-6 border-t-4 border-green-500">
            <div class="text-3xl mb-3">📦</div>
            <h3 class="text-xl font-bold mb-3">High-Value Materials Arriving</h3>
            <p class="text-gray-700 mb-4">Expensive equipment delivery? Materials arriving before security planned?</p>
            <ul class="text-sm space-y-2 text-gray-600">
              <li>✓ Protect immediately</li>
              <li>✓ Document delivery</li>
              <li>✓ 24/7 self-monitoring</li>
              <li>✓ Theft deterrence</li>
            </ul>
            <div class="mt-4 p-3 bg-green-50 rounded">
              <p class="text-sm font-semibold text-green-800">Setup before delivery arrives</p>
            </div>
          </div>

          <!-- Threat Received -->
          <div class="bg-white rounded-lg shadow-lg p-6 border-t-4 border-purple-500">
            <div class="text-3xl mb-3">⚠️</div>
            <h3 class="text-xl font-bold mb-3">Threat or Security Alert</h3>
            <p class="text-gray-700 mb-4">You've received threats or noticed suspicious activity. Maybe a neighboring site just got hit.</p>
            <ul class="text-sm space-y-2 text-gray-600">
              <li>✓ Immediate protection</li>
              <li>✓ Evidence collection</li>
              <li>✓ Video evidence for police</li>
              <li>✓ Visible deterrence</li>
            </ul>
            <div class="mt-4 p-3 bg-purple-50 rounded">
              <p class="text-sm font-semibold text-purple-800">Proactive threat response</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why We're Fastest -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Why We're The Fastest Security Response in Tacoma/Seattle</h2>

        <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          <div class="space-y-6">
            <div class="flex items-start">
              <div class="bg-green-600 text-white rounded-full w-10 h-10 flex items-center justify-center flex-shrink-0 font-bold mr-4">✓</div>
              <div>
                <h3 class="font-bold text-lg mb-2">Pre-Configured Trailers</h3>
                <p class="text-gray-700">Our trailers are pre-configured and kept charged, so an available unit can roll quickly. Call to check availability.</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="bg-green-600 text-white rounded-full w-10 h-10 flex items-center justify-center flex-shrink-0 font-bold mr-4">✓</div>
              <div>
                <h3 class="font-bold text-lg mb-2">Local Tacoma Base</h3>
                <p class="text-gray-700">Centrally located in Tacoma for rapid deployment throughout Pierce, King, and Thurston counties.</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="bg-green-600 text-white rounded-full w-10 h-10 flex items-center justify-center flex-shrink-0 font-bold mr-4">✓</div>
              <div>
                <h3 class="font-bold text-lg mb-2">Nights, Weekends & Holidays</h3>
                <p class="text-gray-700">After-hours deployments are possible when a trailer is available. Call our 24/7 hotline instead of waiting until Monday morning.</p>
              </div>
            </div>
          </div>

          <div class="space-y-6">
            <div class="flex items-start">
              <div class="bg-green-600 text-white rounded-full w-10 h-10 flex items-center justify-center flex-shrink-0 font-bold mr-4">✓</div>
              <div>
                <h3 class="font-bold text-lg mb-2">No Installation Required</h3>
                <p class="text-gray-700">Self-contained units with solar power and cellular connectivity. No waiting for electricians or internet setup.</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="bg-green-600 text-white rounded-full w-10 h-10 flex items-center justify-center flex-shrink-0 font-bold mr-4">✓</div>
              <div>
                <h3 class="font-bold text-lg mb-2">Instant Self-Monitoring</h3>
                <p class="text-gray-700">Real-time alerts and live view on your mobile devices or computer start as soon as setup is done.</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="bg-green-600 text-white rounded-full w-10 h-10 flex items-center justify-center flex-shrink-0 font-bold mr-4">✓</div>
              <div>
                <h3 class="font-bold text-lg mb-2">Local Since 2009</h3>
                <p class="text-gray-700">We know the neighborhoods and local police response times across the Puget Sound region.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Response Time Comparison -->
        <div class="mt-12 bg-gray-50 rounded-lg p-8 max-w-4xl mx-auto">
          <h3 class="text-2xl font-bold text-center mb-8">Security Solution Response Time Comparison</h3>

          <div class="space-y-4">
            <!-- Our Service -->
            <div class="flex items-center">
              <div class="w-32 font-semibold">CCTV Trailer:</div>
              <div class="flex-1 bg-green-600 text-white px-4 py-2 rounded-r" style="width: 20%">Same day</div>
            </div>

            <!-- Security Guards -->
            <div class="flex items-center">
              <div class="w-32 font-semibold">Security Guards:</div>
              <div class="flex-1 bg-yellow-500 text-white px-4 py-2 rounded-r" style="width: 60%">Typically 24-48 hours</div>
            </div>

            <!-- Fixed Cameras -->
            <div class="flex items-center">
              <div class="w-32 font-semibold">Fixed Cameras:</div>
              <div class="flex-1 bg-red-500 text-white px-4 py-2 rounded-r" style="width: 100%">Typically 2-4 weeks</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Service Area Map -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Same-Day Deployment Service Area</h2>

        <div class="max-w-5xl mx-auto">
          <div class="bg-white rounded-lg shadow-lg p-8">
            <h3 class="text-xl font-bold mb-6 text-center">Where We Deploy Same-Day</h3>

            <div class="grid md:grid-cols-2 gap-6">
              <!-- Core Service Area -->
              <div class="bg-green-50 rounded-lg p-6">
                <h4 class="font-bold text-green-800 mb-4">⚡ Core Service Area</h4>
                <ul class="space-y-2 text-gray-700">
                  <li>📍 Tacoma (all areas)</li>
                  <li>📍 Lakewood</li>
                  <li>📍 University Place</li>
                  <li>📍 Fife</li>
                  <li>📍 Puyallup</li>
                  <li>📍 Federal Way</li>
                </ul>
              </div>

              <!-- Extended Service Area -->
              <div class="bg-yellow-50 rounded-lg p-6">
                <h4 class="font-bold text-yellow-800 mb-4">⏱️ Extended Service Area</h4>
                <ul class="space-y-2 text-gray-700">
                  <li>📍 Seattle</li>
                  <li>📍 Kent</li>
                  <li>📍 Auburn</li>
                  <li>📍 Olympia</li>
                  <li>📍 Bremerton</li>
                  <li>📍 Everett</li>
                </ul>
              </div>
            </div>

            <div class="mt-6 p-4 bg-blue-50 rounded-lg text-center">
              <p class="text-gray-700"><strong>Same-day deployment is subject to availability.</strong> Call (253) 683-2288 to check. Outside these areas? We often can accommodate rush deployments throughout Western Washington.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Emergency Quote Section -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Emergency Deployment Quotes</h2>

        <div class="bg-red-50 border-2 border-red-300 rounded-lg p-6 max-w-3xl mx-auto">
          <p class="text-gray-700 mb-4 text-center">Pricing depends on rental length, site, and configuration. Start with a short emergency rental and extend week-to-week or month-to-month as needed.</p>
          <h3 class="text-xl font-bold mb-4 text-center">Every rental includes:</h3>
          <ul class="space-y-2 text-sm max-w-md mx-auto">
            <li>✓ 4 cameras (1 fixed fisheye + 3 PTZ with 25x optical zoom and IR)</li>
            <li>✓ Equipment training</li>
            <li>✓ 24/7 technical support</li>
            <li>✓ Solar power/generator included</li>
            <li>✓ Remote viewing access on your mobile devices or computer</li>
          </ul>
        </div>

        <div class="mt-8 text-center">
          <p class="text-gray-700 mb-4">Professional delivery and setup available</p>
          <a href="tel:2536832288" class="bg-red-600 hover:bg-red-700 text-white font-bold py-4 px-8 rounded-lg inline-block text-xl">
            Get Emergency Quote Now: (253) 683-2288
          </a>
        </div>
      </div>
    </section>

    <!-- Success Stories -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Recent Emergency Deployments</h2>

        <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          <!-- Story 1 -->
          <div class="bg-white rounded-lg shadow-lg overflow-hidden">
            <div class="bg-red-600 text-white p-4">
              <h3 class="text-xl font-bold">Construction Site - Federal Way</h3>
              <p class="text-red-200">Thursday, 3:30 PM</p>
            </div>
            <div class="p-6">
              <div class="mb-4">
                <p class="font-semibold text-red-600">Emergency:</p>
                <p>Tools stolen from the site Wednesday night</p>
              </div>
              <div class="mb-4">
                <p class="font-semibold text-green-600">Response:</p>
                <p>Trailer operational the same day</p>
              </div>
              <div class="mb-4">
                <p class="font-semibold text-blue-600">Result:</p>
                <p>Thieves came back Friday night and were caught on camera.</p>
              </div>
            </div>
          </div>

          <!-- Story 2 -->
          <div class="bg-white rounded-lg shadow-lg overflow-hidden">
            <div class="bg-orange-600 text-white p-4">
              <h3 class="text-xl font-bold">Music Festival - Tacoma</h3>
              <p class="text-orange-200">Saturday, 10:00 AM</p>
            </div>
            <div class="p-6">
              <div class="mb-4">
                <p class="font-semibold text-red-600">Emergency:</p>
                <p>Security company cancelled morning of event</p>
              </div>
              <div class="mb-4">
                <p class="font-semibold text-green-600">Response:</p>
                <p>3 trailers deployed the same day</p>
              </div>
              <div class="mb-4">
                <p class="font-semibold text-blue-600">Result:</p>
                <p>Event went ahead as planned, with camera coverage in place of the cancelled guards</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Same-Day Security FAQs</h2>

        <div class="max-w-3xl mx-auto space-y-6">
          <div class="bg-gray-50 rounded-lg p-6">
            <h3 class="font-bold text-lg mb-2">How fast can you deploy a security trailer?</h3>
            <p class="text-gray-700">Same-day deployment is available within our service area, subject to availability. Call (253) 683-2288 to check availability for your site. Setup takes just 20-30 minutes once on-site.</p>
          </div>

          <div class="bg-gray-50 rounded-lg p-6">
            <h3 class="font-bold text-lg mb-2">Is same-day security rental available 24/7?</h3>
            <p class="text-gray-700">You can reach our hotline 24/7, including nights, weekends, and holidays. Same-day deployment depends on trailer availability, so call (253) 683-2288 to check availability for your site.</p>
          </div>

          <div class="bg-gray-50 rounded-lg p-6">
            <h3 class="font-bold text-lg mb-2">What situations qualify for same-day security deployment?</h3>
            <p class="text-gray-700">Same-day deployment is available for: recent theft or vandalism incidents, emergency events, sudden security threats, insurance requirements, guard service failures, and any urgent security need.</p>
          </div>

          <div class="bg-gray-50 rounded-lg p-6">
            <h3 class="font-bold text-lg mb-2">Do I need power or internet for the trailer?</h3>
            <p class="text-gray-700">No. Our trailers are completely self-sufficient with solar power, battery backup, and 4G LTE connectivity. They can be deployed anywhere immediately.</p>
          </div>

          <div class="bg-gray-50 rounded-lg p-6">
            <h3 class="font-bold text-lg mb-2">What if I only need security for one night?</h3>
            <p class="text-gray-700">We offer short-term daily rentals for emergency needs, quoted based on rental length, site, and configuration. Many clients start with a daily rental then extend to weekly or monthly for continued protection.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
